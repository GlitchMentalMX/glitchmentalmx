---
import { formatDateShort, readingTime } from '../lib/format';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  heroImage: string;
  heroImageAlt: string;
  body?: string;
  variant?: 'default' | 'featured' | 'compact';
}

const { slug, title, description, pubDate, heroImage, heroImageAlt, body = '', variant = 'default' } = Astro.props;
const minutes = readingTime(body || description);
---

<a class:list={['card', variant]} href={`/articulos/${slug}/`}>
  {heroImage && (
    <div class="thumb">
      <img src={heroImage} alt={heroImageAlt} loading="lazy" decoding="async" width="800" height="500" />
    </div>
  )}
  <div class="body">
    <p class="eyebrow meta">{formatDateShort(pubDate)} · {minutes} min</p>
    <h3 class="title">{title}</h3>
    {variant !== 'compact' && <p class="dek">{description}</p>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    color: var(--text);
  }
  .thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-inset);
    margin-bottom: 16px;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
  }
  .card:hover .thumb img { transform: scale(1.035); }

  .meta { margin: 0 0 8px; }
  .title {
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .card:hover .title { color: var(--accent); }
  .dek {
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.55;
    margin: 8px 0 0;
  }

  .card.featured .thumb { aspect-ratio: 16/9; margin-bottom: 22px; }
  .card.featured .title { font-family: var(--font-display); font-size: 2rem; }
  .card.featured .dek { font-size: 1.05rem; max-width: 60ch; }

  .card.compact { flex-direction: row; align-items: center; gap: 20px; }
  .card.compact .thumb { width: 240px; flex-shrink: 0; aspect-ratio: 16/9; margin-bottom: 0; }
  .card.compact .title { font-size: 1.02rem; line-height: 1.35; }

  @media (max-width: 640px) {
    .card.compact { gap: 14px; }
    .card.compact .thumb { width: 120px; }
    .card.compact .title { font-size: 0.94rem; }
  }
</style>
