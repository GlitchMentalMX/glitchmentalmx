---
import { formatDateShort, readingTime } from '../lib/format';

interface Props {
  index: number;
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  body?: string;
  tag?: 'ancla' | 'serie' | 'caso' | 'debate';
  label?: string;
}

const { index, slug, title, description, pubDate, body = '', tag, label } = Astro.props;
const minutes = readingTime(body || description);
const num = String(index).padStart(2, '0');
const tagLabel = { ancla: 'Ancla', serie: 'Serie', caso: 'Caso', debate: 'Debate' };
---

<a class="row" href={`/articulos/${slug}/`}>
  <span class="num">{num}</span>
  <span class="text">
    {label && <span class="kicker">{label}</span>}
    <span class="title-line">
      <span class="title">{title}</span>
      {tag && <span class={`tag tag-${tag}`}>{tagLabel[tag]}</span>}
    </span>
    <span class="dek">{description}</span>
    <span class="eyebrow meta">{formatDateShort(pubDate)} · {minutes} min</span>
  </span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 20px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .row:first-child { padding-top: 4px; }
  .num {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--accent-line);
    font-weight: 500;
  }
  .text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .title-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; }
  .title { font-family: var(--font-display); font-size: 1.15rem; line-height: 1.3; }
  .row:hover .title { color: var(--accent); }
  .tag { flex-shrink: 0; }
  .tag-ancla { background: var(--accent-soft); color: var(--accent); }
  .tag-serie { background: var(--bg-inset); color: var(--text-muted); }
  .tag-caso { background: var(--up-bg); color: var(--up-line); }
  .tag-debate { background: var(--debate-bg); color: var(--debate-line); }
  .dek {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta { margin-top: 2px; }

  @media (max-width: 640px) {
    .row { grid-template-columns: 30px 1fr; gap: 12px; }
    .title { font-size: 1.02rem; }
  }
</style>
