---
// Botón de Google "Fuentes Preferidas" — implementación "manual" (control
// programático), siguiendo el patrón oficial: NO existe un modo donde Google
// dibuje su propio botón dentro de un contenedor y luego se pueda re-renderizar
// a demanda (no hay `renderAll()` ni equivalente en la doc real). El patrón
// documentado es justo al revés: un botón propio del sitio, con su propio
// texto/estilo, que en el click llama a `preferredSource.addPreferredSource()`.
// Eso además resuelve solo el problema de sincronizar tema/oscuro: al ser HTML
// nuestro, ya hereda el tema del sitio por CSS, sin re-render ni JS extra.
// Doc oficial: https://developers.google.com/search/docs/appearance/preferred-sources
interface Props {
  variant?: 'button' | 'compact';
  className?: string;
}

const { variant = 'button', className = '' } = Astro.props;
const containerId = `preferred-source-btn-${Math.random().toString(36).slice(2, 9)}`;
---

<button
  type="button"
  id={containerId}
  class:list={['btn', 'btn-ghost', 'preferred-source-btn', variant, className]}
  data-preferred-source-container
>
  Marcar como preferida →
</button>

<script>
  // Astro bundlea este bloque una sola vez por página aunque el componente se
  // use varias veces (footer + placement contextual), así que el guard es
  // solo un cinturón extra — no es lo único que evita listeners duplicados.
  if (!window.__preferredSourceWired) {
    window.__preferredSourceWired = true;

    let preferredSourceApi: any = null;

    // El SDK de Google (+ el iframe que trae) pesa ~230 KB y, aunque el script
    // es async, cargarlo apenas entra la página compite con el CSS/fuentes
    // críticos del primer pintado. Un intento anterior lo pospuso con
    // requestIdleCallback(timeout: 2000) — mejoró FCP/LCP, pero el timeout
    // forzaba la carga de todos modos a los ~2s, y ese trabajo (los ~1s de
    // CPU de los scripts de gstatic.com) cayó dentro de la ventana de Total
    // Blocking Time, empeorándolo. La solución real: cargarlo solo cuando el
    // botón esté a punto de entrar en pantalla — nadie puede darle clic antes
    // de verlo, y la mayoría de las visitas nunca llegan al footer, así que
    // para ellas el costo desaparece por completo, no solo se retrasa.
    let sdkLoadRequested = false;
    const loadPreferredSourceSDK = () => {
      if (sdkLoadRequested) return;
      sdkLoadRequested = true;
      const script = document.createElement('script');
      script.async = true;
      script.setAttribute('preferred-sources-control', 'manual');
      script.src = 'https://news.google.com/swg/js/v1/publisher.js';
      document.head.appendChild(script);
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            loadPreferredSourceSDK();
            observer.disconnect();
          }
        },
        { rootMargin: '600px 0px' }
      );
      document.querySelectorAll('[data-preferred-source-container]').forEach((el) => observer.observe(el));
    } else {
      loadPreferredSourceSDK();
    }

    const getCurrentTheme = (): 'light' | 'dark' =>
      document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

    window.PREFERRED_SOURCE = window.PREFERRED_SOURCE || [];
    window.PREFERRED_SOURCE.push((preferredSource: any) => {
      preferredSourceApi = preferredSource;
      preferredSource.init({ theme: getCurrentTheme(), lang: 'es' });
    });

    // Mismo Worker/beacon que Analytics.astro (no Umami: este sitio no lo
    // usa). Endpoint de eventos custom: mismo /collect, distinto payload
    // (trae `event`) — ver cloudflare/analytics-worker.js.
    const ANALYTICS_WORKER_URL = 'https://glitchmental-analytics.contacto-fbf.workers.dev/collect';

    function trackClick(container: Element) {
      try {
        if (localStorage.getItem('gm-no-analytics')) return;
        const host = location.hostname;
        if (host === 'localhost' || host === '127.0.0.1' || host.indexOf('preview') !== -1) return;

        const placement = container.closest('[data-placement]')?.getAttribute('data-placement') || 'unknown';
        const payload = JSON.stringify({
          event: 'preferred-source-click',
          path: location.pathname,
          data: { placement },
        });
        const blob = new Blob([payload], { type: 'text/plain' });
        navigator.sendBeacon(ANALYTICS_WORKER_URL, blob);
      } catch (e) {
        // silencio a propósito — igual que Analytics.astro
      }
    }

    // Delegado en document (no por contenedor) para cubrir instancias que
    // Astro pudiera montar después del primer render.
    document.addEventListener('click', (e) => {
      const container = (e.target as HTMLElement)?.closest?.('[data-preferred-source-container]');
      if (!container) return;

      // Re-init con el tema actual justo antes de disparar el flujo: así la
      // superficie que muestra Google (su propio diálogo/confirmación) usa
      // el tema real del sitio en ese momento, sin depender de un evento de
      // cambio de tema por separado.
      if (preferredSourceApi) {
        preferredSourceApi.init({ theme: getCurrentTheme(), lang: 'es' });
        preferredSourceApi.addPreferredSource();
      }

      trackClick(container);
    });
  }
</script>

<style>
  .preferred-source-btn.compact {
    padding: 0.55em 1.1em;
    font-size: 0.85rem;
  }
</style>
