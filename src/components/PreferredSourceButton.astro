---
// Botón de Google "Fuentes Preferidas" — implementación ESTÁNDAR de la doc
// oficial: Google dibuja su propio botón dentro de
// <div google-add-preferred-source-btn></div> cuando carga su script (sin el
// atributo preferred-sources-control="manual", que es el modo avanzado donde
// uno dibuja el botón y llama a addPreferredSource()). Se cambió del modo
// manual al estándar a pedido de Jorge (2026-10-04); el modo manual se había
// elegido cuando la doc no describía un botón declarativo.
// Doc oficial: https://developers.google.com/search/docs/appearance/preferred-sources
//
// El script NO va fijo en el <head> a propósito: es la única cookie de
// terceros real del sitio (ver CookieConsent.astro y la Política de
// Privacidad, que prometen que solo se carga si el visitante acepta) y pesa
// ~230 KB — cargarlo en cada página para todos devolvería el Total Blocking
// Time de ~900 ms que ya se había eliminado. Se inyecta desde aquí, con
// consentimiento y cuando el botón está por entrar en pantalla.
interface Props {
  variant?: 'button' | 'compact';
  className?: string;
}
---

<div google-add-preferred-source-btn></div>

<script>
  // Astro bundlea este bloque una sola vez por página aunque el componente se
  // use varias veces (footer + placement contextual), así que el guard es
  // solo un cinturón extra — no es lo único que evita listeners duplicados.
  if (!window.__preferredSourceWired) {
    window.__preferredSourceWired = true;

    // Se carga solo si hubo consentimiento y el botón está por entrar en
    // pantalla. Si el botón llega a pantalla antes de que el visitante
    // decida, se queda "en cola" (wantsToLoad) y se dispara solo si acepta
    // después, sin esperar a que recargue la página.
    let sdkLoadRequested = false;
    let wantsToLoad = false;
    const hasConsent = () => {
      try {
        return localStorage.getItem('gm-cookie-consent') === 'accepted';
      } catch (e) {
        return false;
      }
    };

    const loadPreferredSourceSDK = () => {
      if (sdkLoadRequested || !hasConsent()) return;
      sdkLoadRequested = true;

      // El modo estándar toma tema e idioma de atributos del div (la doc
      // oficial los documenta como data-theme / data-lang). Se fijan justo
      // antes de cargar el script para que el botón salga en español y con el
      // tema real del sitio, sin tocar el marcado del div.
      const themeAttr = document.documentElement.dataset.theme;
      const theme = themeAttr
        ? themeAttr === 'dark' ? 'dark' : 'light'
        : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.querySelectorAll('[google-add-preferred-source-btn]').forEach((el) => {
        el.setAttribute('data-theme', theme);
        el.setAttribute('data-lang', 'es');
      });

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://news.google.com/swg/js/v1/publisher.js';
      document.head.appendChild(script);
    };

    window.addEventListener('gm-cookie-consent', ((e: CustomEvent<string>) => {
      if (e.detail === 'accepted' && wantsToLoad) loadPreferredSourceSDK();
    }) as EventListener);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            wantsToLoad = true;
            loadPreferredSourceSDK();
            observer.disconnect();
          }
        },
        { rootMargin: '600px 0px' }
      );
      document.querySelectorAll('[google-add-preferred-source-btn]').forEach((el) => observer.observe(el));
    } else {
      wantsToLoad = true;
      loadPreferredSourceSDK();
    }

    // Mismo Worker/beacon que Analytics.astro (no Umami: este sitio no lo
    // usa). Endpoint de eventos custom: mismo /collect, distinto payload
    // (trae `event`) — ver cloudflare/analytics-worker.js.
    const ANALYTICS_WORKER_URL = 'https://glitchmental-analytics.contacto-fbf.workers.dev/collect';

    function trackClick(container: Element) {
      try {
        if (localStorage.getItem('gm-no-analytics')) return;
        const host = location.hostname;
        if (host === 'localhost' || host === '127.0.0.1' || host.indexOf('preview') !== -1) return;

        const placement = container.closest('[data-placement]')?.getAttribute('data-placement') || 'unknown';
        const payload = JSON.stringify({
          event: 'preferred-source-click',
          path: location.pathname,
          data: { placement },
        });
        const blob = new Blob([payload], { type: 'text/plain' });
        navigator.sendBeacon(ANALYTICS_WORKER_URL, blob);
      } catch (e) {
        // silencio a propósito — igual que Analytics.astro
      }
    }

    // Delegado en document: el botón lo dibuja Google dentro del div, así
    // que el clic llega con el div (o su host) como ancestro. Si Google lo
    // renderiza en un iframe, ese clic no sube hasta aquí y el conteo se
    // pierde — limitación del modo estándar que el modo manual no tenía.
    document.addEventListener('click', (e) => {
      const container = (e.target as HTMLElement)?.closest?.('[google-add-preferred-source-btn]');
      if (container) trackClick(container);
    });
  }
</script>

<style is:global>
  /* Reserva el alto del botón de Google para que, al renderizarse tras el
     consentimiento, no empuje el layout del footer. Es solo el div; el
     contenedor general y sus márgenes no se tocan. */
  [google-add-preferred-source-btn] {
    min-height: 36px;
  }
</style>
