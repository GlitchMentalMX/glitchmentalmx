---
// Buscador local de la sección Precios de IA — exclusivo de /precios-ia/, no
// es un buscador general del sitio (para eso existe GlitchSearch, que no se
// toca aquí). 100% cliente: los datos {nombre, slug, alias} se calculan en
// build-time desde la colección `preciosIA` (ver src/pages/precios-ia/index.astro)
// y se embeben en la página — nunca una lista escrita a mano, nunca una
// llamada externa. Patrón ARIA combobox/listbox con navegación por teclado.
interface Item {
  nombre: string;
  slug: string;
  alias?: string[];
}

interface Props {
  items: Item[];
  label?: string;
}

const { items, label = 'Buscar herramienta de IA por nombre' } = Astro.props;
---

<div class="buscador" data-buscador>
  <label for="buscador-input" class="visually-hidden">{label}</label>
  <div class="buscador-field">
    <svg class="buscador-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
      <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <input
      id="buscador-input"
      type="text"
      class="buscador-input"
      placeholder="Busca por nombre"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="buscador-listbox"
      aria-autocomplete="list"
      aria-activedescendant=""
    />
  </div>
  <ul id="buscador-listbox" class="buscador-listbox" role="listbox" aria-label="Herramientas sugeridas" hidden>
  </ul>
  <p id="buscador-empty" class="buscador-empty" role="status" hidden>
    No encontramos esa herramienta — seguimos agregando más.
  </p>
</div>

<script type="application/json" id="buscador-items" set:html={JSON.stringify(items)} />

<script>
  function normalizar(texto: string): string {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/\s+/g, '');
  }

  function init() {
    const root = document.querySelector<HTMLElement>('[data-buscador]');
    const input = document.getElementById('buscador-input') as HTMLInputElement | null;
    const listbox = document.getElementById('buscador-listbox') as HTMLUListElement | null;
    const empty = document.getElementById('buscador-empty') as HTMLParagraphElement | null;
    const dataEl = document.getElementById('buscador-items');
    if (!root || !input || !listbox || !empty || !dataEl) return;

    const items: { nombre: string; slug: string; alias?: string[] }[] = JSON.parse(dataEl.textContent || '[]');
    const normalizados = items.map((item) => ({
      item,
      claves: [normalizar(item.nombre), ...(item.alias ?? []).map(normalizar)],
    }));

    let activeIndex = -1;
    let visibles: { nombre: string; slug: string }[] = [];

    function cerrar() {
      listbox!.hidden = true;
      empty!.hidden = true;
      input!.setAttribute('aria-expanded', 'false');
      input!.setAttribute('aria-activedescendant', '');
      activeIndex = -1;
      visibles = [];
    }

    function irA(slug: string) {
      window.location.href = `/articulos/${slug}/`;
    }

    function resaltar(index: number) {
      const opciones = listbox!.querySelectorAll('[role="option"]');
      opciones.forEach((op, i) => {
        op.setAttribute('aria-selected', i === index ? 'true' : 'false');
        op.classList.toggle('activa', i === index);
      });
      activeIndex = index;
      input!.setAttribute('aria-activedescendant', index >= 0 ? `buscador-option-${index}` : '');
      if (index >= 0) {
        (opciones[index] as HTMLElement)?.scrollIntoView({ block: 'nearest' });
      }
    }

    function render(query: string) {
      const q = normalizar(query);
      if (!q) {
        cerrar();
        return;
      }

      visibles = normalizados
        .filter(({ claves }) => claves.some((clave) => clave.includes(q)))
        .map(({ item }) => item)
        .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'))
        .slice(0, 10);

      listbox!.innerHTML = '';

      if (visibles.length === 0) {
        listbox!.hidden = true;
        empty!.hidden = false;
        input!.setAttribute('aria-expanded', 'false');
        input!.setAttribute('aria-activedescendant', '');
        activeIndex = -1;
        return;
      }

      empty!.hidden = true;
      visibles.forEach((item, i) => {
        const li = document.createElement('li');
        li.id = `buscador-option-${i}`;
        li.role = 'option';
        li.className = 'buscador-option';
        li.setAttribute('aria-selected', 'false');
        li.textContent = item.nombre;
        li.addEventListener('mousedown', (e) => {
          // mousedown, no click — evita que el blur del input cierre la lista antes del clic
          e.preventDefault();
          irA(item.slug);
        });
        listbox!.appendChild(li);
      });
      listbox!.hidden = false;
      input!.setAttribute('aria-expanded', 'true');
      resaltar(-1);
    }

    input.addEventListener('input', () => render(input.value));

    input.addEventListener('keydown', (e) => {
      if (listbox!.hidden && empty!.hidden) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (visibles.length === 0) return;
        resaltar(activeIndex < visibles.length - 1 ? activeIndex + 1 : 0);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (visibles.length === 0) return;
        resaltar(activeIndex > 0 ? activeIndex - 1 : visibles.length - 1);
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0 && visibles[activeIndex]) {
          e.preventDefault();
          irA(visibles[activeIndex].slug);
        } else if (visibles.length === 1) {
          e.preventDefault();
          irA(visibles[0].slug);
        }
      } else if (e.key === 'Escape') {
        cerrar();
      }
    });

    input.addEventListener('blur', () => {
      // Pequeño margen para que el mousedown de una opción alcance a navegar
      // antes de que el listbox se oculte.
      setTimeout(cerrar, 100);
    });

    document.addEventListener('click', (e) => {
      if (!root!.contains(e.target as Node)) cerrar();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .buscador { position: relative; margin: 0 0 28px; }
  .buscador-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    height: 46px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }
  .buscador-field:focus-within { border-color: var(--accent); }
  .buscador-icon { color: var(--text-faint); flex-shrink: 0; }
  .buscador-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 0.95rem;
    font-family: inherit;
  }
  .buscador-input:focus { outline: none; }
  .buscador-input::placeholder { color: var(--text-faint); }

  .buscador-listbox {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    max-height: 320px;
    overflow-y: auto;
    margin: 0;
    padding: 6px;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  }
  .buscador-option {
    padding: 9px 12px;
    border-radius: 6px;
    font-size: 0.92rem;
    color: var(--text);
    cursor: pointer;
  }
  .buscador-option.activa,
  .buscador-option:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .buscador-empty {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text-faint);
    font-size: 0.88rem;
  }
</style>
