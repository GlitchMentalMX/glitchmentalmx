---
import { mdAccent } from '../lib/format';

interface Props {
  eyebrow?: string;
  title: string;
  dek?: string;
}
const { eyebrow, title, dek } = Astro.props;
---

<section class="container page-header">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 set:html={mdAccent(title)} />
  {dek && <p class="dek">{dek}</p>}
</section>

<style>
  .page-header { padding: 56px 24px 40px; max-width: 760px; }
  .page-header h1 {
    font-size: clamp(2rem, 4.4vw, 2.9rem);
    margin: 12px 0 16px;
  }
  .page-header h1 :global(.accent) { color: var(--accent); }
  .dek {
    font-size: 1.12rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
</style>
