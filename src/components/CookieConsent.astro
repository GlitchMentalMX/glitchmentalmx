---
// Banner de cookies — flotante, esquina, nunca a pantalla completa ni con
// overlay que oscurezca el resto del sitio (a propósito: que no se sienta
// como un sitio vacío bloqueado detrás de un modal). No hay categorías que
// activar/desactivar porque solo existe UNA fuente real de cookies no
// esenciales en todo el sitio: el SDK de Google que carga
// PreferredSourceButton.astro. El analytics propio (Analytics.astro) nunca
// usa cookies, así que no necesita gate ni aparece aquí.
//
// Aceptar/Rechazar se guardan en localStorage (gm-cookie-consent) y se
// avisa con un CustomEvent global ('gm-cookie-consent') para que
// PreferredSourceButton —que puede ya estar esperando por el usuario— cargue
// el SDK de inmediato si acaba de dar el consentimiento, en vez de esperar
// a la siguiente visita.
---

<div id="cookie-consent" class="cookie-consent" role="dialog" aria-live="polite" aria-label="Aviso de cookies" hidden>
  <p class="cookie-tag">Cookies</p>
  <p class="cookie-text">
    No usamos cookies propias de rastreo. Solo Google podría poner las suyas, y solo si activas
    "Marcar como preferida".
  </p>
  <div class="cookie-actions">
    <button type="button" class="btn btn-ghost" id="cookie-reject">Rechazar</button>
    <button type="button" class="btn btn-primary" id="cookie-accept">Aceptar</button>
  </div>
  <a href="/politica-de-privacidad/" class="cookie-link">Política de privacidad →</a>
</div>

<script>
  (function () {
    const KEY = 'gm-cookie-consent';
    const el = document.getElementById('cookie-consent');
    if (!el) return;

    let existing: string | null = null;
    try {
      existing = localStorage.getItem(KEY);
    } catch (e) {
      // Sin localStorage (modo privado estricto, etc.) — no insistir con el
      // banner en cada carga, mejor no bloquear nada.
      return;
    }
    if (existing) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    el.hidden = false;
    if (reduceMotion) {
      el.classList.add('is-visible');
    } else {
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-visible')));
    }

    function dismiss(value: 'accepted' | 'rejected') {
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {
        // silencio a propósito
      }
      el!.classList.remove('is-visible');
      el!.classList.add('is-leaving');
      window.setTimeout(() => {
        el!.hidden = true;
      }, reduceMotion ? 0 : 250);
      window.dispatchEvent(new CustomEvent('gm-cookie-consent', { detail: value }));
    }

    document.getElementById('cookie-accept')?.addEventListener('click', () => dismiss('accepted'));
    document.getElementById('cookie-reject')?.addEventListener('click', () => dismiss('rejected'));
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 200;
    width: min(360px, calc(100vw - 40px));
    padding: 18px 20px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cookie-consent.is-visible { opacity: 1; transform: translateY(0) scale(1); }
  .cookie-consent.is-leaving { opacity: 0; transform: translateY(10px) scale(0.98); }
  .cookie-tag {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cookie-text {
    margin: 0 0 14px;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .cookie-actions { display: flex; gap: 10px; margin-bottom: 10px; }
  .cookie-actions .btn { padding: 0.6em 1.2em; font-size: 0.84rem; }
  .cookie-link {
    display: inline-block;
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .cookie-link:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .cookie-consent { left: 12px; right: 12px; bottom: 12px; width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent { transition: none; }
  }
</style>
