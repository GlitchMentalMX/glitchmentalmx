---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PageHeader from './PageHeader.astro';
import { render } from 'astro:content';
import { mdStrip } from '../lib/format';

const { entry } = Astro.props;
const { title, description, eyebrow, headline, dek, noIndex } = entry.data;
const { Content } = await render(entry);
---

<Layout
  title={title}
  description={description}
  noIndex={noIndex}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <Breadcrumbs items={[{ name: mdStrip(headline) }]} />
  <PageHeader eyebrow={eyebrow} title={headline} dek={dek} />
  <section class="container prose">
    <Content />
  </section>
</Layout>

<script>
  // Markdown can't set target; links marked with ↗ in the copy open in a new tab.
  document.querySelectorAll<HTMLAnchorElement>('.prose a').forEach((a) => {
    if (a.textContent?.includes('↗')) {
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
    }
  });
</script>

<style>
  .prose { padding: 0 24px 96px; }
</style>
