---
// Escala 0–100 de un solo matiz (sin rojo ni semáforo): cinco tramos, del más
// tenue al más intenso. El marcador indica la puntuación; el rango, la
// sensibilidad (calificaciones sin uso observado desplazadas ±1).
import { NIVELES } from '../lib/exposicion';

interface Props {
  valor: number;
  rango?: [number, number];
  compact?: boolean;
}
const { valor, rango, compact = false } = Astro.props;
---

<div class:list={['escala', { compact }]} role="img" aria-label={`Puntuación ${valor} de 100${rango ? `, rango de sensibilidad ${rango[0]} a ${rango[1]}` : ''}`}>
  <div class="pista">
    {NIVELES.map((n, i) => <span class="tramo" style={`--i:${i}; flex:${n.max - n.min + 1}`}></span>)}
    {rango && <span class="rango" style={`left:${rango[0]}%; width:${Math.max(rango[1] - rango[0], 1)}%`}></span>}
    <span class="marca" style={`left:${valor}%`}></span>
  </div>
  {!compact && (
    <div class="ticks" aria-hidden="true">
      <span>0</span><span>20</span><span>40</span><span>60</span><span>80</span><span>100</span>
    </div>
  )}
</div>

<style>
  .escala { width: 100%; }
  .pista { position: relative; display: flex; height: 12px; border-radius: 99px; overflow: visible; gap: 2px; }
  .compact .pista { height: 6px; }
  .tramo {
    background: color-mix(in srgb, var(--accent) calc(12% + var(--i) * 22%), var(--bg-inset));
  }
  .tramo:first-child { border-radius: 99px 0 0 99px; }
  .tramo:nth-child(5) { border-radius: 0 99px 99px 0; }
  .rango {
    position: absolute; top: -4px; bottom: -4px;
    border: 1.5px solid var(--text-muted); border-radius: 6px; opacity: 0.6; pointer-events: none;
  }
  .compact .rango { display: none; }
  .marca {
    position: absolute; top: -5px; width: 4px; height: calc(100% + 10px); margin-left: -2px;
    background: var(--text); border-radius: 2px;
    box-shadow: 0 0 0 2px var(--bg-elevated);
  }
  .ticks { display: flex; justify-content: space-between; margin-top: 8px; font: 0.72rem var(--font-mono); color: var(--text-faint); }
</style>
