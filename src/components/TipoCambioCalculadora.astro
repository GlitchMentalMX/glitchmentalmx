---
// Calculadora de precio en pesos mexicanos para la serie "¿Cuánto cuesta
// [Herramienta] hoy?". Lee src/data/tipo-cambio.json y src/data/precios-ia-usd.json
// en build-time — cero llamadas externas desde el navegador, cero token
// expuesto. tipo-cambio.json lo actualiza a diario el GitHub Action de
// Banxico; precios-ia-usd.json se edita a mano cuando una empresa cambia precio.
import tipoCambio from '../data/tipo-cambio.json';
import preciosUSD from '../data/precios-ia-usd.json';
import { formatDate } from '../lib/format';

interface Props {
  herramientaId: string;
  herramienta: string;
}

const { herramientaId, herramienta } = Astro.props;
const precio = (preciosUSD as Record<string, { nombre: string; precioUSD: number; periodo: string }>)[
  herramientaId
];

if (!precio) {
  throw new Error(`No hay precio USD registrado para herramientaId "${herramientaId}" en precios-ia-usd.json`);
}

const precioMXN = precio.precioUSD * tipoCambio.valor;
const fechaDato = new Date(`${tipoCambio.fecha}T12:00:00-06:00`);

const formatMXN = (n: number) =>
  n.toLocaleString('es-MX', { style: 'currency', currency: 'MXN', minimumFractionDigits: 2, maximumFractionDigits: 2 });
const formatUSD = (n: number) =>
  n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });
const esGratis = precio.precioUSD === 0;
---

<div class="calc-box" aria-label={`Calculadora de precio de ${precio.nombre} en pesos mexicanos`}>
  <p class="calc-label">Precio de hoy · {herramienta}</p>
  {esGratis ? (
    <div class="calc-row">
      <span class="calc-mxn">$0 MXN — es gratis</span>
    </div>
  ) : (
    <div class="calc-row">
      <span class="calc-usd">{formatUSD(precio.precioUSD)} USD</span>
      <span class="calc-op">×</span>
      <span class="calc-fx">{tipoCambio.valor.toFixed(4)}</span>
      <span class="calc-op">=</span>
      <span class="calc-mxn">{formatMXN(precioMXN)} MXN</span>
    </div>
  )}
  <p class="calc-foot">
    {esGratis
      ? 'No tiene plan de pago para el público general en México — el tipo de cambio no aplica.'
      : `Tipo de cambio FIX de Banxico al ${formatDate(fechaDato)}. Antes de comisiones bancarias por transacción en dólares o impuestos según tu método de pago.`}
  </p>
</div>

<style>
  .calc-box {
    max-width: 720px;
    margin: 28px auto;
    padding: 22px 26px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }
  .calc-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .calc-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-mono);
  }
  .calc-usd { font-size: 1.05rem; color: var(--text-muted); }
  .calc-op { color: var(--text-faint); }
  .calc-fx { font-size: 1.05rem; color: var(--text-muted); }
  .calc-mxn {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text);
  }
  .calc-foot {
    margin: 14px 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-faint);
  }
</style>
