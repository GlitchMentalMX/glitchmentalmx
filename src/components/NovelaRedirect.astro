---
import Analytics from './Analytics.astro';
import { getBook } from '../data/books';

interface Props {
  bookId: string;
  // Ruta corta sin barras (p. ej. 'umbral20' → /umbral20/).
  path: string;
  // Destino de Amazon al que redirige.
  target: string;
}

const { bookId, path, target } = Astro.props;
const book = getBook(bookId)!;

// Enlace corto de campaña para una novela (redes, WhatsApp, impresos). Redirige
// a Amazon al instante; cada visita queda en el beacon propio de
// Analytics.astro (path /{path}/, con referrer), así que /stats/ ya cuenta
// los clics sin gtag ni eventos aparte. Sitio estático (GitHub Pages): sin
// redirect de servidor, por eso JS + meta-refresh, igual que las páginas
// stub de redirección existentes.
//
// - Layout.astro no se usa a propósito: traería Header, Footer y el banner
//   de cookies a una página que el visitante no llega a ver.
// - Las etiquetas OG existen porque WhatsApp/Facebook/X no ejecutan JS: sin
//   ellas la vista previa del enlace diría "Redirigiendo…".
// - El meta-refresh va dentro de <noscript> para no competir con el beacon
//   (un refresh de 0 s puede navegar antes de que salga); solo actúa sin JS.
const canonical = `https://glitchmental.com/${path}/`;
const title = `${book.title} · glitchMentalMX`;
// Sinopsis única de books.ts: la misma que ve el catálogo, nunca una copia.
const description = `${book.title}, novela de Jorge A. Diaz Elizondo. ${book.desc}`;
const ogImage = `https://glitchmental.com/images/novelas/${book.id}-og.jpg`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="glitchMentalMX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <noscript><meta http-equiv="refresh" content={`0; url=${target}`} /></noscript>
    <script is:inline define:vars={{ target }}>
      // Después del beacon (Analytics va al final del body): sendBeacon
      // encola el envío y sobrevive a la navegación, así que replace() puede
      // ir en el mismo turno. replace() evita dejar /umbral20/ en el
      // historial (el botón "atrás" no rebota de vuelta al redirect).
      window.addEventListener('DOMContentLoaded', function () {
        window.location.replace(target);
      });
    </script>
  </head>
  <body>
    <p>
      Te llevo a Amazon para ver <strong>{book.title}</strong>. Si no pasa nada,
      <a href={target}>ve directo a Amazon</a>.
    </p>
    <Analytics />
  </body>
</html>
