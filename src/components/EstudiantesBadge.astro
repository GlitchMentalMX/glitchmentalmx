---
// Badge de color para la serie "¿[Herramienta] tiene descuento o plan gratis
// para estudiantes — y aplica en México?". Mismo sistema de color e interfaz
// que VeredictoBadge/PruebaGratisBadge/CodigoDescuentoBadge, con semántica
// propia: verde (hay oferta vigente que aplica a estudiantes en México),
// amarillo (existe, pero algo la limita: instituciones específicas, cupo,
// tarjeta, vence pronto o la empresa no confirma México), rojo (no hay oferta
// que aplique en México: no existe, caducó o es solo para otros países). El
// badge nunca lleva la respuesta completa — solo color + etiqueta corta; los
// matices viven en el artículo.
interface Props {
  veredicto: 'rojo' | 'verde' | 'amarillo';
  size?: 'sm' | 'lg';
}

const { veredicto, size = 'sm' } = Astro.props;

const CONFIG = {
  rojo: { emoji: '🔴', label: 'No aplica en México' },
  amarillo: { emoji: '🟡', label: 'Aplica con condiciones' },
  verde: { emoji: '🟢', label: 'Aplica en México' },
};

const c = CONFIG[veredicto];
---

<span class={`veredicto veredicto-${veredicto} veredicto-${size}`}>
  <span aria-hidden="true">{c.emoji}</span> {c.label}
</span>

<style>
  .veredicto {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-weight: 500;
    border-radius: 999px;
    white-space: nowrap;
  }
  .veredicto-sm {
    padding: 3px 10px;
    font-size: 0.72rem;
  }
  .veredicto-lg {
    padding: 7px 16px;
    font-size: 0.85rem;
    letter-spacing: 0.01em;
  }
  .veredicto-rojo { background: var(--down-bg); color: var(--down-line); }
  .veredicto-verde { background: var(--up-bg); color: var(--up-line); }
  .veredicto-amarillo { background: var(--warn-bg); color: var(--warn-line); }
</style>
