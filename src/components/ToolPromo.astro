---
interface Props {
  title: string;
  description: string;
  href: string;
}
const { title, description, href } = Astro.props;
---
<a href={href} class="tool-promo">
  <p class="promo-title">{title}</p>
  <p class="promo-desc">{description}</p>
</a>

<style>
  .tool-promo {
    display: block;
    background: var(--bg-inset);
    border-radius: var(--radius);
    border-top: 2px solid var(--accent);
    padding: 22px 26px 24px;
    color: var(--text);
  }
  .tool-promo:hover { outline: 1.5px solid var(--accent); }
  .promo-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .promo-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }
</style>
