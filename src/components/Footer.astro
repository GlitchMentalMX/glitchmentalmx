---
import { categories } from '../data/categories';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Explorar',
    links: [
      ...categories.map((c) => ({ href: `/categoria/${c.slug}/`, label: c.name })),
      { href: '/archivo/', label: 'Archivo' },
      { href: '/series/', label: 'Series editoriales' },
      { href: '/colecciones/', label: 'Colecciones' },
      { href: '/indice-glitchmentalmx/', label: 'Índice GlitchMentalMX' },
      { href: '/insights-visuales/', label: 'Insights Visuales' },
      { href: '/dato-incomodo/', label: 'Dato Incómodo' },
    ],
  },
  {
    title: 'Herramientas',
    links: [
      { href: '/glitchsearch/', label: 'GlitchSearch' },
      { href: '/calculadora-de-riesgo-de-reemplazo-por-ia-2026/', label: 'Calculadora de Riesgo IA' },
      { href: '/buscar/', label: 'Buscar en el sitio' },
    ],
  },
  {
    title: 'GlitchMentalMX',
    links: [
      { href: '/acerca-de/', label: 'Acerca de' },
      { href: '/articulos/la-ia-no-viene-por-tu-trabajo-ya-lo-esta-evaluando/', label: 'Manifiesto' },
      { href: '/novelas/', label: 'Novelas' },
      { href: '/contacto/', label: 'Contacto' },
      { href: '/colabora/', label: 'Colabora' },
      { href: '/publicidad-en-glitchmentalmx/', label: 'Publicidad' },
      { href: '/servicios-editoriales-glitchmentalmx/', label: 'Servicios editoriales' },
      { href: '/editorial-services-glitchmentalmx/', label: 'Editorial Services (EN)' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/politica-de-privacidad/', label: 'Política de privacidad' },
      { href: '/aviso-legal-y-condiciones-de-uso/', label: 'Aviso legal' },
    ],
  },
  {
    title: 'Social',
    links: [
      { href: 'https://x.com/GlitchMentalMX', label: 'X (Twitter)', external: true },
      { href: 'https://www.linkedin.com/in/jorgediazelizondo', label: 'LinkedIn', external: true },
      { href: 'https://www.facebook.com/GlitchMentalMX/', label: 'Facebook', external: true },
      { href: 'https://mastodon.social/@GlitchMentalMX', label: 'Mastodon', external: true },
      { href: 'https://bsky.app/profile/glitchmentalmx.bsky.social', label: 'Bluesky', external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="cta">
      <div>
        <p class="cta-title">Lo que nadie te cuenta sobre la IA. Sin ads, sin spam.</p>
        <p class="cta-sub">Cancela cuando quieras, sin drama.</p>
      </div>
      <a href="/suscribete/" class="btn btn-primary">Suscríbete</a>
    </div>

    <div class="grid">
      {columns.map((col) => (
        <details class="col" open>
          <summary>
            <h3 class="eyebrow">{col.title}</h3>
            <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </details>
      ))}
    </div>

    <a href="/" class="brand-band" aria-label="glitchmentalMX — inicio">
      <span class="brand-word">
        <span class="w-glitch">glitch</span><span class="w-mental">Mental</span><span class="w-mx">MX</span>
      </span>
      <p class="stance">Este sitio no es neutral, los datos tampoco.</p>
    </a>

    <div class="bottom">
      <p>© {year} glitchmentalMX. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 96px;
    padding: 56px 0 32px;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    background: var(--bg-inset);
    border-radius: var(--radius);
    padding: 28px 32px;
    margin-bottom: 56px;
  }
  .cta-title { font-weight: 700; font-size: 1.05rem; margin: 0 0 4px; }
  .cta-sub { color: var(--text-muted); font-size: 0.88rem; margin: 0; }

  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: start;
    gap: 32px;
  }

  /* the signature brand moment — a big wordmark with a chromatic-aberration
     "glitch" flicker on hover/focus, tying the visual to the site's own name
     instead of generic footer decoration */
  .brand-band {
    position: relative;
    display: block;
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }
  /* ambient light source behind the wordmark — the one place on the site
     that departs from the flat background, kept to this single signature
     moment. Dark mode gets a visible glow (brightening reads well against
     near-black); light mode can't get "brighter than white", so it gets a
     much fainter tint instead — same idea, calibrated per theme rather than
     skipped in light mode. */
  .brand-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 700px 340px at 30% 55%, rgba(0, 102, 255, 0.07) 0%, rgba(0, 102, 255, 0.025) 40%, transparent 72%);
  }
  :global([data-theme='dark']) .brand-band::before {
    background: radial-gradient(ellipse 700px 340px at 30% 55%, rgba(0, 102, 255, 0.45) 0%, rgba(0, 102, 255, 0.16) 40%, transparent 72%);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brand-band::before {
      background: radial-gradient(ellipse 700px 340px at 30% 55%, rgba(0, 102, 255, 0.45) 0%, rgba(0, 102, 255, 0.16) 40%, transparent 72%);
    }
  }
  .brand-word {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.15rem, 9vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .w-glitch { color: var(--text); }
  .w-mental { color: var(--accent); }
  .w-mx { color: var(--text-faint); font-family: var(--font-mono); font-size: 0.72em; }

  .brand-band:hover .brand-word,
  .brand-band:focus-visible .brand-word,
  .brand-band:active .brand-word {
    animation: brandGlitch 0.7s steps(1) 1;
  }
  @keyframes brandGlitch {
    0%   { text-shadow: none; transform: translateX(0); }
    8%   { text-shadow: -3px 0 var(--down-line), 3px 0 var(--accent); transform: translateX(-2px); }
    18%  { text-shadow: 3px 0 var(--down-line), -3px 0 var(--accent); transform: translateX(2px); }
    28%  { text-shadow: -3px 0 var(--down-line), 3px 0 var(--accent); transform: translateX(-1px); }
    38%  { text-shadow: none; transform: translateX(0); }
    48%  { text-shadow: 3px 0 var(--down-line), -3px 0 var(--accent); transform: translateX(1px); }
    58%  { text-shadow: -3px 0 var(--down-line), 3px 0 var(--accent); transform: translateX(-2px); }
    72%  { text-shadow: none; transform: translateX(0); }
    100% { text-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-band:hover .brand-word,
    .brand-band:focus-visible .brand-word,
    .brand-band:active .brand-word { animation: none; }
  }
  .stance {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin: 14px 0 0;
  }

  /* footer column — renders as an always-open <details> on desktop, real
     accordion (closed by default) on mobile */
  .col { border: none; }
  .col summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    cursor: default;
    pointer-events: none;
    list-style: none;
  }
  .col summary::-webkit-details-marker { display: none; }
  .col .eyebrow { margin: 0; }
  .col .chevron { flex-shrink: 0; color: var(--text-faint); transition: transform .15s ease; display: none; }
  .col[open] summary .chevron { transform: rotate(180deg); }

  .col ul { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .col a { font-size: 0.88rem; color: var(--text-muted); }
  .col a:hover { color: var(--text); }

  .bottom {
    margin-top: 28px;
    padding-top: 20px;
    color: var(--text-faint);
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .grid { grid-template-columns: 1fr; }
    .cta { flex-direction: column; align-items: flex-start; }

    /* real accordion behavior only on mobile */
    .col { border-bottom: 1px solid var(--border); padding-bottom: 4px; }
    .col summary { padding: 14px 0; cursor: pointer; pointer-events: auto; }
    .col .chevron { display: block; }
    .col:not([open]) ul { display: none; }
    .col ul { margin-top: 4px; padding-bottom: 14px; }
  }
</style>

<script>
  // Every <details> starts "open" in the HTML (so content is never hidden if
  // this script fails to run). On mobile it becomes a real accordion — closed
  // by default, one section open at a time; on desktop it always stays open.
  const cols = document.querySelectorAll('footer .col');
  const isMobile = () => window.innerWidth <= 520;

  function syncFooterAccordion() {
    cols.forEach((col) => {
      col.open = !isMobile();
    });
  }
  syncFooterAccordion();

  let wasMobile = isMobile();
  window.addEventListener('resize', () => {
    if (isMobile() !== wasMobile) {
      wasMobile = isMobile();
      syncFooterAccordion();
    }
  });

  cols.forEach((col) => {
    col.addEventListener('toggle', () => {
      if (!isMobile()) return;
      if (col.open) {
        cols.forEach((other) => {
          if (other !== col) other.open = false;
        });
      }
    });
  });
</script>
