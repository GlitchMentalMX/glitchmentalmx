---
import { getCollection } from 'astro:content';
import { categories } from '../data/categories';

const series = (await getCollection('editorialCollections', ({ data }) => data.kind === 'series')).sort(
  (a, b) => a.data.order - b.data.order
);
const hubs = (await getCollection('editorialCollections', ({ data }) => data.kind === 'hub'))
  .sort((a, b) => a.data.order - b.data.order);
const standaloneHubs = hubs.filter((h) => !h.data.group);
const groupedHubs = hubs.filter((h) => h.data.group);
const groupName = groupedHubs[0]?.data.group ?? 'Recursos educativos';

const nav = [
  {
    href: '/categoria/',
    label: 'Leer',
    children: categories.map((c) => ({ href: `/categoria/${c.slug}/`, label: c.name })),
    groupLabel: 'Otros formatos',
    groupChildren: [
      { href: '/dato-incomodo/', label: 'Dato Incómodo' },
      { href: '/insights-visuales/', label: 'Insights Visuales' },
      { href: '/precios-ia/', label: 'Precios de IA' },
    ],
  },
  { href: '/archivo/', label: 'Archivo' },
  {
    href: '/series/',
    label: 'Series',
    children: series.map((s) => ({
      href: `/series/${s.id}/`,
      label: s.data.title,
      muted: s.data.status === 'coming-soon',
    })),
  },
  {
    href: '/colecciones/',
    label: 'Colecciones',
    children: standaloneHubs.map((h) => ({ href: `/colecciones/${h.id}/`, label: h.data.title })),
    groupLabel: groupName,
    groupChildren: groupedHubs.map((h) => ({ href: `/colecciones/${h.id}/`, label: h.data.title })),
  },
  {
    href: '/glitchsearch/',
    label: 'Herramientas',
    children: [
      { href: '/glitchsearch/', label: 'GlitchSearch' },
      { href: '/calculadora-de-riesgo-de-reemplazo-por-ia-2026/', label: 'Calculadora de Riesgo IA' },
      { href: '/buscar/', label: 'Buscar en el sitio' },
    ],
  },
  { href: '/indice-glitchmentalmx/', label: 'Índice' },
  { href: '/novelas/', label: 'Novelas' },
  {
    href: '/servicios-editoriales-glitchmentalmx/',
    label: '¿Trabajamos?',
    children: [
      { href: '/servicios-editoriales-glitchmentalmx/', label: 'Servicios Editoriales' },
      { href: '/editorial-services-glitchmentalmx/', label: 'Editorial Services (EN)' },
      { href: '/publicidad-en-glitchmentalmx/', label: 'Publicidad' },
      { href: '/colabora/', label: 'Colabora' },
      { href: '/contacto/', label: 'Contacto' },
    ],
  },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo notranslate" translate="no" aria-label="glitchmentalMX — inicio">
      <span class="logo-glitch">glitch</span><span class="logo-mental">Mental</span><span class="logo-mx">MX</span>
    </a>

    <nav class="primary-nav" aria-label="Navegación principal">
      <ul>
        {nav.map((item) => (
          <li class:list={{ 'has-dropdown': !!item.children }}>
            <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && (
                <svg class="chevron" viewBox="0 0 24 24" width="11" height="11" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
            </a>
            {item.children && (
              <div class="dropdown-panel">
                <ul>
                  {item.children.map((c) => (
                    <li><a href={c.href} class:list={{ muted: c.muted }}>{c.label}{c.muted && <span class="soon-tag">Pronto</span>}</a></li>
                  ))}
                </ul>
                {item.groupChildren && item.groupChildren.length > 0 && (
                  <>
                    <p class="dropdown-group-label">{item.groupLabel}</p>
                    <ul>
                      {item.groupChildren.map((c) => (
                        <li><a href={c.href}>{c.label}</a></li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a href="/buscar/" class="icon-btn" aria-label="Buscar en el sitio">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>
      <button id="theme-toggle" class="icon-btn" aria-label="Cambiar tema claro/oscuro" type="button">
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none"><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.4M12 19.1v2.4M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      </button>
      <a href="/suscribete/" class="btn btn-primary subscribe-btn">Suscríbete</a>
      <button id="menu-toggle" class="icon-btn menu-toggle" aria-label="Abrir menú" aria-expanded="false" type="button">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Navegación móvil">
    <ul>
      {nav.map((item) => (
        <li>
          {item.children ? (
            <details class="mobile-accordion">
              <summary>
                <span>{item.label}</span>
                <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <div class="accordion-body">
                <a href={item.href} class="see-all-link">Ver todo {item.label} →</a>
                <ul>
                  {item.children.map((c) => (
                    <li><a href={c.href} class:list={{ muted: c.muted }}>{c.label}{c.muted && <span class="soon-tag">Pronto</span>}</a></li>
                  ))}
                </ul>
                {item.groupChildren && item.groupChildren.length > 0 && (
                  <>
                    <p class="dropdown-group-label">{item.groupLabel}</p>
                    <ul>
                      {item.groupChildren.map((c) => (
                        <li><a href={c.href}>{c.label}</a></li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </details>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      ))}
      <li><a href="/suscribete/">Suscríbete</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 68px;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.28rem;
    letter-spacing: -0.01em;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .logo-glitch { color: var(--text); }
  .logo-mental { color: var(--accent); }
  .logo-mx { color: var(--text-faint); font-size: 0.75em; font-family: var(--font-mono); margin-left: 1px; }

  .primary-nav { flex: 1; min-width: 0; }
  .primary-nav > ul {
    list-style: none;
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 0;
  }
  .primary-nav > ul > li { position: relative; }
  .primary-nav a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    padding: 22px 0;
    border-bottom: 2px solid transparent;
    transition: color .15s ease, border-color .15s ease;
  }
  .primary-nav > ul > li > a:hover { color: var(--text); }
  .primary-nav > ul > li > a[aria-current='page'] {
    color: var(--text);
    border-color: var(--accent);
  }
  .chevron { flex-shrink: 0; transition: transform .15s ease; opacity: 0.6; }
  .has-dropdown:hover .chevron { transform: rotate(180deg); }

  /* Desktop hover dropdown */
  .dropdown-panel {
    display: none;
    position: absolute;
    top: 100%;
    left: -14px;
    min-width: 240px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    padding: 10px;
    z-index: 60;
  }
  .has-dropdown:hover .dropdown-panel,
  .has-dropdown:focus-within .dropdown-panel {
    display: block;
  }
  .dropdown-panel ul { list-style: none; margin: 0; padding: 0; }
  .dropdown-panel li a {
    display: block;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--text);
    white-space: normal;
    line-height: 1.35;
  }
  .dropdown-panel li a:hover { background: var(--bg-inset); color: var(--accent); }
  .dropdown-panel li a.muted { color: var(--text-faint); }
  .soon-tag {
    display: inline-block;
    margin-left: 6px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .dropdown-group-label {
    margin: 8px 10px 4px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background-color .15s ease, color .15s ease;
  }
  .icon-btn:hover { background: var(--bg-inset); color: var(--text); }
  .subscribe-btn { padding: 0.6em 1.3em; font-size: 0.85rem; margin-left: 8px; }

  .icon-moon { display: none; }
  :global([data-theme='dark']) .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-moon { display: block; }

  .menu-toggle { display: none; }

  .mobile-nav {
    display: none;
    border-top: 1px solid var(--border);
    background: var(--bg);
    max-height: calc(100vh - 68px);
    overflow-y: auto;
  }
  .mobile-nav > ul { list-style: none; margin: 0; padding: 10px 24px 18px; }
  .mobile-nav > ul > li > a {
    display: block;
    padding: 14px 0;
    font-size: 1rem;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }

  .mobile-accordion { border-bottom: 1px solid var(--border); }
  .mobile-accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }
  .mobile-accordion summary::-webkit-details-marker { display: none; }
  .mobile-accordion[open] summary .chevron { transform: rotate(180deg); }
  .accordion-body { padding: 0 0 16px 4px; }
  .see-all-link { display: block; padding: 8px 0; font-size: 0.85rem; font-weight: 600; color: var(--accent); }
  .accordion-body ul { list-style: none; margin: 0; padding: 0; }
  .accordion-body li a { display: block; padding: 9px 0 9px 10px; font-size: 0.92rem; color: var(--text-muted); }
  .accordion-body li a.muted { color: var(--text-faint); }
  .accordion-body .dropdown-group-label { margin: 6px 0 4px 10px; padding-top: 8px; border-top: 1px solid var(--border); }

  /* 1220px, no 860px: el nav de escritorio con 8 ítems ya no cabe a partir
     de ~1180px (el ancho máximo real de .container) hacia abajo — a 860px
     se ve un desbordamiento severo sobre los íconos de la derecha. Se sube
     el punto de quiebre para que el menú móvil (que sí funciona a cualquier
     ancho) cubra toda esa franja rota en vez de mostrar el nav de escritorio
     desbordado. */
  @media (max-width: 1220px) {
    .primary-nav { display: none; }
    .menu-toggle { display: inline-flex; }
    .subscribe-btn { display: none; }
    .mobile-nav.open { display: block; }
  }
</style>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('gm-theme', next);
  });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', String(!!isOpen));
  });
</script>
