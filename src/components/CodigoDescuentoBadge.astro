---
// Badge de color para la serie "¿[Herramienta] tiene código de descuento
// real, o es un cupón falso?". Mismo sistema de color e interfaz que
// VeredictoBadge/PruebaGratisBadge, pero con semántica propia: rojo (no
// existe ningún código real, todo lo que circula es falso), amarillo
// (existen promociones oficiales limitadas, pero no cupones públicos
// permanentes), verde (sí existe un código o promoción activa verificable
// hoy). El badge nunca lleva la respuesta completa — solo color + etiqueta
// corta; los matices viven en el artículo.
interface Props {
  veredicto: 'rojo' | 'verde' | 'amarillo';
  size?: 'sm' | 'lg';
}

const { veredicto, size = 'sm' } = Astro.props;

const CONFIG = {
  rojo: { emoji: '🔴', label: 'No existe ningún código real' },
  amarillo: { emoji: '🟡', label: 'Solo promos oficiales limitadas' },
  verde: { emoji: '🟢', label: 'Código o promoción activa hoy' },
};

const c = CONFIG[veredicto];
---

<span class={`veredicto veredicto-${veredicto} veredicto-${size}`}>
  <span aria-hidden="true">{c.emoji}</span> {c.label}
</span>

<style>
  .veredicto {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-weight: 500;
    border-radius: 999px;
    white-space: nowrap;
  }
  .veredicto-sm {
    padding: 3px 10px;
    font-size: 0.72rem;
  }
  .veredicto-lg {
    padding: 7px 16px;
    font-size: 0.85rem;
    letter-spacing: 0.01em;
  }
  .veredicto-rojo { background: var(--down-bg); color: var(--down-line); }
  .veredicto-verde { background: var(--up-bg); color: var(--up-line); }
  .veredicto-amarillo { background: var(--warn-bg); color: var(--warn-line); }
</style>
