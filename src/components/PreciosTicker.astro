---
// Cinta de precios estilo "ticker bursátil" — deliberadamente SIN el efecto
// decodificador de Señal en Vivo (esa es la firma de marca del sitio y no se
// toca aquí); esta cinta usa una forma distinta a propósito: scroll continuo
// y parejo, mostrando varios precios a la vez en vez de rotar uno por uno.
// Lee tipo-cambio.json y precios-ia-usd.json en build-time, igual que la
// calculadora de cada artículo — mismo dato, cero riesgo de desincronía.
import { getCollection } from 'astro:content';
import tipoCambio from '../data/tipo-cambio.json';
import preciosUSD from '../data/precios-ia-usd.json';

// Orden de producción original del brief — arranca con las marcas más
// reconocidas, no alfabético.
const ORDEN = [
  'chatgpt', 'claude', 'gemini', 'copilot', 'perplexity', 'grok', 'deepseek',
  'canva', 'meta-ai', 'notebooklm', 'adobe-firefly', 'elevenlabs', 'midjourney', 'runway',
  'suno', 'deepl', 'leonardo-ai', 'character-ai', 'github-copilot',
  'ideogram', 'kling-ai', 'cursor', 'notion-ai', 'pixverse',
  'grammarly', 'quillbot', 'jasper-ai', 'copy-ai', 'gamma', 'heygen', 'synthesia',
  'capcut', 'descript', 'photoroom', 'remove-bg', 'krea-ai', 'recraft-ai',
  'playground-ai', 'freepik', 'udio', 'murf-ai', 'otter-ai', 'fireflies-ai',
  'replit', 'tabnine', 'windsurf', 'poe', 'le-chat', 'speechify', 'invideo-ai',
  'pictory', 'elicit', 'amazon-q-developer', 'lovable', 'bolt-new', 'v0',
  'framer', 'manychat', 'zapier', 'beautiful-ai',
  'amazon-prime', 'ring-protect', 'nest-aware', '23andme-plus',
];

const posts = await getCollection('preciosIA', ({ data }) => !data.draft);
const postByHerramientaId = new Map(posts.map((p) => [p.data.herramientaId, p]));

const items = ORDEN.map((id) => {
  const post = postByHerramientaId.get(id);
  const precio = (preciosUSD as Record<string, { precioUSD: number }>)[id];
  if (!post || !precio) return null;
  const esGratis = precio.precioUSD === 0;
  const label = esGratis
    ? 'Gratis'
    : (precio.precioUSD * tipoCambio.valor).toLocaleString('es-MX', {
        style: 'currency',
        currency: 'MXN',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      });
  return { herramienta: post.data.herramienta, label, esGratis, href: `/articulos/${post.id}/` };
}).filter((i): i is NonNullable<typeof i> => i !== null);

// La duración escala con la cantidad de herramientas para que la velocidad
// visual (px/segundo) se mantenga constante sin importar cuántas se agreguen
// en rondas futuras — antes era un valor fijo (55s) que se sentía cada vez
// más rápido conforme crecía la lista, de 14 a 52 herramientas.
const duracionSegundos = items.length * 4.5;
---

{items.length > 0 && (
  <section class="precios-ticker container" aria-label="Cuánto cuesta la IA hoy">
    <div class="ticker-wrap">
      <a href="/precios-ia/" class="ticker-title">Cuánto cuesta la IA hoy:</a>
      <div class="ticker-viewport">
        <div class="ticker-track" style={`--ticker-duration: ${duracionSegundos}s`}>
          {[0, 1].map((copy) => (
            <span class="ticker-copy" aria-hidden={copy === 1 ? 'true' : undefined}>
              {items.map((item) => (
                <a href={item.href} class="ticker-item">
                  <span class="ticker-name">{item.herramienta}</span>
                  <span class="ticker-price">{item.label}{!item.esGratis && <sub class="ticker-currency">MXN</sub>}</span>
                </a>
              ))}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .precios-ticker { padding: 0 24px 8px; }
  .ticker-wrap {
    display: flex;
    align-items: center;
    gap: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    padding: 0 20px;
    height: 52px;
    overflow: hidden;
  }
  .ticker-title {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--text-faint);
    white-space: nowrap;
  }
  .ticker-title:hover { color: var(--accent); }
  .ticker-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 24px, black calc(100% - 24px), transparent);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll var(--ticker-duration, 180s) linear infinite;
  }
  .ticker-wrap:hover .ticker-track,
  .ticker-wrap:focus-within .ticker-track {
    animation-play-state: paused;
  }
  .ticker-copy {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .ticker-item {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 0 22px;
    white-space: nowrap;
    color: var(--text);
    border-right: 1px solid var(--border);
  }
  .ticker-item:hover .ticker-name { color: var(--accent); }
  .ticker-name { font-size: 0.86rem; font-weight: 600; }
  .ticker-price { font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-muted); }
  .ticker-currency {
    margin-left: 3px;
    font-size: 0.65em;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-faint);
  }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
    .ticker-copy[aria-hidden='true'] { display: none; }
    .ticker-viewport { overflow-x: auto; }
  }

  @media (max-width: 640px) {
    .ticker-wrap { gap: 12px; padding: 0 14px; height: 46px; }
    .ticker-title { display: none; }
  }
</style>
