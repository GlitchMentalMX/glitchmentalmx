<style is:global>
  [data-lightbox],
  .prose img {
    cursor: zoom-in;
  }
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(8, 9, 12, 0.92);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 300;
    padding: 48px 24px;
    cursor: zoom-out;
  }
  .lightbox-overlay.open {
    display: flex;
  }
  .lightbox-overlay img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 6px;
    cursor: default;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    display: block;
  }
  .lightbox-frame {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    max-height: 100%;
  }
  .lightbox-caption {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 48px 24px 20px;
    background: linear-gradient(to top, rgba(8, 9, 12, 0.92), rgba(8, 9, 12, 0.55) 60%, transparent);
    border-radius: 0 0 6px 6px;
    pointer-events: none;
  }
  .lightbox-overlay.has-caption .lightbox-caption {
    display: block;
  }
  .lightbox-caption h3 {
    color: #fff;
    font-size: 1.05rem;
    line-height: 1.3;
    margin: 0 0 6px;
  }
  /* Dato Incómodo no tiene un título propio distinto del mensaje (su
     `titulo` interno siempre es literal "Dato Incómodo") — su caption solo
     manda data-desc, nunca data-title, así que el h3 queda vacío. Sin
     :empty se ve un hueco en blanco arriba del texto. */
  .lightbox-caption h3:empty {
    display: none;
  }
  .lightbox-caption p {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0;
    max-width: 640px;
  }
  .lightbox-close,
  .lightbox-permalink,
  .lightbox-nav {
    position: absolute;
    z-index: 2;
    border: none;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-close:hover,
  .lightbox-permalink:hover,
  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .lightbox-close {
    top: 20px;
    right: 24px;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    font-size: 22px;
    line-height: 1;
  }
  /* Único punto de acceso visible del sitio a la página individual de una
     pieza (SPEC punto 2) — discreto a propósito, arriba a la izquierda,
     lejos del botón de cerrar. Solo aparece si la imagen trae
     data-permalink (ver showAt() abajo); las imágenes de .prose y los
     hero de artículo no lo traen, así que ahí nunca se muestra. */
  .lightbox-permalink {
    top: 20px;
    left: 24px;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    display: none;
  }
  .lightbox-permalink svg {
    width: 18px;
    height: 18px;
  }
  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 999px;
  }
  .lightbox-nav svg { width: 22px; height: 22px; }
  .lightbox-prev { left: 12px; }
  .lightbox-next { right: 12px; }
  .lightbox-overlay.single .lightbox-nav {
    display: none;
  }
  @media (max-width: 640px) {
    .lightbox-nav { width: 40px; height: 40px; }
    .lightbox-prev { left: 6px; }
    .lightbox-next { right: 6px; }
    .lightbox-overlay.has-caption .lightbox-caption { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var gallery = [];
    var currentIndex = -1;

    function getOverlay() {
      var overlay = document.getElementById('lightbox-overlay');
      if (overlay) return overlay;
      overlay = document.createElement('div');
      overlay.id = 'lightbox-overlay';
      overlay.className = 'lightbox-overlay';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');

      var prevBtn = document.createElement('button');
      prevBtn.className = 'lightbox-nav lightbox-prev';
      prevBtn.setAttribute('aria-label', 'Imagen anterior');
      prevBtn.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      prevBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        step(-1);
      });

      var nextBtn = document.createElement('button');
      nextBtn.className = 'lightbox-nav lightbox-next';
      nextBtn.setAttribute('aria-label', 'Imagen siguiente');
      nextBtn.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      nextBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        step(1);
      });

      var closeBtn = document.createElement('button');
      closeBtn.className = 'lightbox-close';
      closeBtn.setAttribute('aria-label', 'Cerrar imagen ampliada');
      closeBtn.textContent = '×';

      var permalinkBtn = document.createElement('a');
      permalinkBtn.className = 'lightbox-permalink';
      permalinkBtn.setAttribute('aria-label', 'Ver esta pieza en su propia página');
      permalinkBtn.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none"><path d="M9 15l6-6M11 6l1-1a4 4 0 015.66 5.66l-1 1M13 18l-1 1A4 4 0 016.34 13.34l1-1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      permalinkBtn.addEventListener('click', function (e) {
        e.stopPropagation();
      });

      var frame = document.createElement('div');
      frame.className = 'lightbox-frame';

      var img = document.createElement('img');

      var caption = document.createElement('div');
      caption.className = 'lightbox-caption';
      var captionTitle = document.createElement('h3');
      var captionDesc = document.createElement('p');
      caption.appendChild(captionTitle);
      caption.appendChild(captionDesc);

      frame.appendChild(img);
      frame.appendChild(caption);

      overlay.appendChild(prevBtn);
      overlay.appendChild(nextBtn);
      overlay.appendChild(closeBtn);
      overlay.appendChild(permalinkBtn);
      overlay.appendChild(frame);
      document.body.appendChild(overlay);

      overlay.addEventListener('click', function (e) {
        if (e.target === overlay || e.target === closeBtn) close();
      });
      document.addEventListener('keydown', function (e) {
        if (!overlay.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
      });

      return overlay;
    }

    function showAt(index) {
      if (!gallery.length) return;
      currentIndex = (index + gallery.length) % gallery.length;
      var el = gallery[currentIndex];
      var overlay = getOverlay();
      var img = overlay.querySelector('img');
      img.src = el.currentSrc || el.src;
      img.alt = el.alt || '';
      overlay.classList.toggle('single', gallery.length < 2);

      var title = el.getAttribute('data-title');
      var desc = el.getAttribute('data-desc');
      overlay.querySelector('.lightbox-caption h3').textContent = title || '';
      overlay.querySelector('.lightbox-caption p').textContent = desc || '';
      overlay.classList.toggle('has-caption', !!(title || desc));

      var permalink = el.getAttribute('data-permalink');
      var permalinkBtn = overlay.querySelector('.lightbox-permalink');
      if (permalink) {
        permalinkBtn.href = permalink;
        permalinkBtn.style.display = 'flex';
      } else {
        permalinkBtn.removeAttribute('href');
        permalinkBtn.style.display = 'none';
      }
    }

    function step(delta) {
      var nextIndex = currentIndex + delta;
      if (nextIndex < 0 || nextIndex >= gallery.length) {
        // Fin de la galería de ESTA página — si la página paginada define
        // una siguiente/anterior (window.__lightboxPaging), navegamos de
        // verdad en vez de dar la vuelta dentro del mismo set: se guarda
        // en sessionStorage si hay que reabrir en la primera o última
        // imagen, y se retoma justo después de la recarga.
        var paging = window.__lightboxPaging;
        var targetUrl = paging && (delta > 0 ? paging.next : paging.prev);
        if (targetUrl) {
          try {
            sessionStorage.setItem('lightboxContinue', delta > 0 ? 'first' : 'last');
          } catch (err) {}
          window.location.href = targetUrl;
          return;
        }
      }
      showAt(nextIndex);
    }

    function open(clickedEl) {
      gallery = Array.prototype.slice.call(
        document.querySelectorAll('[data-lightbox], .prose img')
      );
      var overlay = getOverlay();
      showAt(gallery.indexOf(clickedEl));
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      var overlay = document.getElementById('lightbox-overlay');
      if (!overlay) return;
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!(t instanceof HTMLImageElement)) return;
      if (!t.matches('[data-lightbox], .prose img')) return;
      e.preventDefault();
      open(t);
    });

    // Retoma el lightbox justo después de cruzar a la página siguiente o
    // anterior (ver step() arriba), en la punta correcta de la nueva galería.
    (function resumeAcrossPage() {
      var mode;
      try {
        mode = sessionStorage.getItem('lightboxContinue');
        if (mode) sessionStorage.removeItem('lightboxContinue');
      } catch (err) {
        mode = null;
      }
      if (!mode) return;
      gallery = Array.prototype.slice.call(
        document.querySelectorAll('[data-lightbox], .prose img')
      );
      if (!gallery.length) return;
      var overlay = getOverlay();
      showAt(mode === 'last' ? gallery.length - 1 : 0);
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    })();
  })();
</script>
