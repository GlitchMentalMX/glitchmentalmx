---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const includes = [
  'Ready-to-publish article in HTML (text + metadata)',
  'Original editorial image — no stock, no templates',
  'Source-verified research, mandatory URL fetch',
  'Structured SEO alt text per file',
  'Meticulous grammar and editorial correction',
  '5 posts adapted per social media platform',
  'Final human editorial review on every piece',
  'Publishing handled by your team',
];

const quality = [
  'Real-time trend intelligence with mandatory source verification',
  'Mandatory URL fetch before writing — unconfirmed data is removed, not published',
  'Writing with strict factual accuracy, style and grammar rules',
  'Editorial art direction — unique visual prompt per article, consistent brand aesthetic',
  'Meticulous grammar correction with language-specific rules',
  'Final human editorial review — nothing goes out without that filter',
];

const tiers = [
  { name: 'Editorial Unit 1', price: '$3,500/mo', vol: 'Up to 40 pieces/month', desc: 'Consistent weekly delivery. Full workflow included. Ideal for growing publications building cadence.' },
  { name: 'Editorial Unit 3', price: '$7,000/mo', vol: 'Up to 70 pieces/month', desc: 'High-volume production with full editorial consistency. Equivalent to 2–3 full-time writers.' },
  { name: 'Editorial Unit 5', price: '$12,000/mo', vol: '100+ pieces/month', desc: 'Maximum output. For media operations that compete on volume and speed.' },
];
---

<Layout
  title="Editorial Services"
  description="The complete operation of a digital newsroom. Without the team."
>
  <PageHeader
    eyebrow="Editorial Services"
    title="The complete operation of a digital newsroom. Without the team."
    dek="You're not buying content. You're buying editorial continuity. Writing, editing, art direction, SEO and social distribution — orchestrated with multiple AI models and human review on every piece."
  />

  <p class="container lang-switch"><a href="/servicios-editoriales-glitchmentalmx/">Leer esto en español →</a></p>

  <section class="container two-col">
    <div>
      <h2>What's included in every delivery</h2>
      <ul class="checks">{includes.map((i) => <li>→ {i}</li>)}</ul>
    </div>
    <div>
      <h2>Quality workflow</h2>
      <ul class="checks">{quality.map((i) => <li>✓ {i}</li>)}</ul>
    </div>
  </section>

  <section class="container prose">
    <h2>Visual art direction — not stock</h2>
    <p>Every article gets an editorial image generated with a unique visual prompt — built specifically for that concept, with its own metaphor and brand aesthetic. No composition is reused. No stock. No templates.</p>

    <h2>Adaptable to any content niche</h2>
    <p>The editorial system is configured to your subject area. Categories, tone, sourcing criteria, and visual style are adjusted to match your publication — not the other way around.</p>

    <h2>This system isn't a pitch</h2>
    <p>It's what you're looking at right now. GlitchMentalMX runs on this pipeline in production: 300+ published pieces, a unique editorial image on every article, zero stock, human review on every delivery. The site is the demo.</p>
  </section>

  <section class="container pricing">
    <p class="eyebrow section-label">Monthly editorial capacity (USD)</p>
    <div class="grid">
      {tiers.map((t) => (
        <div class="tier-card">
          <h3>{t.name}</h3>
          <p class="price">{t.price}</p>
          <p class="vol">{t.vol}</p>
          <p class="desc">{t.desc}</p>
        </div>
      ))}
    </div>
    <p class="footnote">Includes full editorial execution: research, writing, art direction, SEO, and distribution-ready formatting. Publishing, analytics and CMS handled by client. * Organizations based in Latin America: reach out for regional pricing.</p>
  </section>

  <section class="container closing">
    <h3>Need to run this operation yourself?</h3>
    <p>The full system — 4-model AI orchestration, 6 documented modules, prompts, workflows, quality protocols and niche configuration — is available for direct acquisition.</p>
    <a class="btn btn-primary" href="mailto:jorge@glitchmental.com">Get in touch — proposal in 48 hours, no cost →</a>
  </section>
</Layout>

<style>
  .lang-switch { padding: 0 24px; margin: -8px 0 8px; font-size: 0.88rem; }
  .two-col {
    padding: 8px 24px 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .two-col h2 { font-size: 1.2rem; margin-bottom: 14px; }
  .checks { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .checks li { color: var(--text-muted); font-size: 0.92rem; line-height: 1.5; }

  .prose { padding: 24px 24px 8px; }

  .pricing { padding: 16px 24px; }
  .section-label { margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .tier-card { background: var(--bg-inset); border-radius: var(--radius); padding: 26px; }
  .tier-card h3 { font-size: 1.05rem; }
  .price { font-family: var(--font-mono); color: var(--accent); font-weight: 600; font-size: 1.1rem; margin: 8px 0 2px; }
  .vol { font-size: 0.82rem; color: var(--text-faint); margin: 0 0 12px; }
  .desc { font-size: 0.88rem; color: var(--text-muted); line-height: 1.55; margin: 0; }
  .footnote { font-size: 0.82rem; color: var(--text-faint); margin-top: 20px; }

  .closing { padding: 40px 24px 96px; max-width: 620px; }
  .closing h3 { font-size: 1.3rem; margin-bottom: 10px; }
  .closing p { color: var(--text-muted); margin-bottom: 20px; }

  @media (max-width: 800px) {
    .two-col, .grid { grid-template-columns: 1fr; }
  }
</style>
