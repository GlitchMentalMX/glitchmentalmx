---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const hubs = (await getCollection('editorialCollections', ({ data }) => data.kind === 'hub')).sort(
  (a, b) => a.data.order - b.data.order
);

const grouped = hubs.filter((h) => h.data.group);
const standalone = hubs.filter((h) => !h.data.group);
const groupName = grouped[0]?.data.group;
---

<Layout
  title="Colecciones"
  description="Selecciones temáticas curadas de artículos de glitchmentalMX."
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <section class="container header">
    <p class="eyebrow">Colecciones</p>
    <h1>Lecturas <span class="accent">curadas por tema</span></h1>
    <p class="sub">Bibliotecas de referencia, guías y recursos organizados para explorar un tema a fondo.</p>
  </section>

  <section class="container grid">
    {standalone.map((h) => (
      <a href={`/colecciones/${h.id}/`} class="card">
        <p class="eyebrow">{h.data.postSlugs.length} artículos</p>
        <h2>{h.data.title}</h2>
        <p class="dek">{h.data.description}</p>
      </a>
    ))}
  </section>

  {grouped.length > 0 && (
    <section class="container group-section">
      <p class="eyebrow group-label">{groupName}</p>
      <div class="grid">
        {grouped.map((h) => (
          <a href={`/colecciones/${h.id}/`} class="card">
            <p class="eyebrow">{h.data.postSlugs.length} artículos</p>
            <h2>{h.data.title}</h2>
            <p class="dek">{h.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .header { padding: 56px 24px 40px; max-width: 700px; }
  .header h1 { font-size: clamp(2rem, 4vw, 2.6rem); margin: 12px 0 10px; }
  .sub { color: var(--text-muted); font-size: 1.05rem; }

  .group-section { padding: 8px 24px 8px; }
  .group-label {
    margin: 40px 0 22px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .grid {
    padding: 0 24px 72px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .group-section .grid { padding: 0 0 72px; }
  .card {
    padding: 30px;
    border-radius: var(--radius);
    background: var(--bg-inset);
    color: var(--text);
  }
  .card:hover { outline: 1.5px solid var(--accent); }
  .card h2 { font-size: 1.5rem; margin: 10px 0 12px; }
  .card .dek { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin: 0; }

  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
