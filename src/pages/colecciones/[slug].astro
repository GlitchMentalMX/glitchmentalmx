---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CollectionArticleRow from '../../components/CollectionArticleRow.astro';
import { getCollection, getEntry } from 'astro:content';
import { mdBold } from '../../lib/format';

export async function getStaticPaths() {
  const hubs = await getCollection('editorialCollections', ({ data }) => data.kind === 'hub');
  return hubs.map((h) => ({ params: { slug: h.id }, props: { hub: h } }));
}

const { hub } = Astro.props;

const postEntries = await Promise.all(
  hub.data.postSlugs.map(async (slug: string) => [slug, await getEntry('posts', slug)] as const)
);
const postMap = new Map(postEntries.filter(([, p]) => Boolean(p)));
const posts = hub.data.postSlugs
  .map((slug) => postMap.get(slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const { sections } = hub.data;

const related = hub.data.related.length
  ? (
      await Promise.all(hub.data.related.map((slug: string) => getEntry('editorialCollections', slug)))
    ).filter((r): r is NonNullable<typeof r> => Boolean(r))
  : [];

// Ruta de inicio recomendada: los artículos marcados "ancla", en el orden en que aparecen
// y sin repetir uno que ya haya salido en una sección anterior.
const seenAnchorSlugs = new Set<string>();
const anchorPosts = sections
  ? sections
      .flatMap((s) => s.posts.filter((p) => p.tag === 'ancla'))
      .filter((p) => (seenAnchorSlugs.has(p.slug) ? false : (seenAnchorSlugs.add(p.slug), true)))
      .map((p) => postMap.get(p.slug))
      .filter((p): p is NonNullable<typeof p> => Boolean(p))
  : [];

const tagCopy = {
  ancla: ['Ancla', 'punto de partida recomendado'],
  serie: ['Serie', 'parte de una investigación de varias entregas'],
  caso: ['Caso', 'ejemplo real documentado'],
  debate: ['Debate', 'posiciones enfrentadas, sin respuesta única'],
} as const;
const usedTags = sections
  ? (Object.keys(tagCopy) as (keyof typeof tagCopy)[]).filter((t) =>
      sections.some((s) => s.posts.some((p) => p.tag === t))
    )
  : [];

// Colecciones tipo "investigación" (con hallazgos, conclusión o pieza de cierre)
// se muestran como grid de tarjetas en vez de lista de filas.
const isInvestigative = Boolean(hub.data.findings || hub.data.conclusion || hub.data.capstone);
const capstonePost = hub.data.capstone ? postMap.get(hub.data.capstone) : undefined;
---

<Layout title={hub.data.title} description={hub.data.description}>
  <Breadcrumbs items={[
    { name: 'Colecciones', url: '/colecciones/' },
    { name: hub.data.title },
  ]} />
  <section class="container header">
    <p class="eyebrow">
      Colección · {posts.length} artículos{sections ? ` · ${sections.length} secciones` : ''}
    </p>
    <h1>{hub.data.title}</h1>
    <p class="dek">{hub.data.description}</p>
  </section>

  {hub.data.intro && (
    <section class="container intro-box">
      <p set:html={mdBold(hub.data.intro)} />
    </section>
  )}

  {hub.data.findings && (
    <section class="container findings-box">
      <p class="eyebrow findings-label">Hallazgos principales</p>
      <ul class="findings-list">
        {hub.data.findings.map((f) => (
          <li set:html={mdBold(f)} />
        ))}
      </ul>
    </section>
  )}

  {hub.data.conclusion && (
    <section class="container conclusion-box">
      <p class="eyebrow conclusion-label">Conclusión</p>
      <p set:html={mdBold(hub.data.conclusion)} />
    </section>
  )}

  {sections ? (
    <>
      {anchorPosts.length > 0 && (
        <section class="container start-box">
          <p class="eyebrow start-label">¿Por dónde empiezo?</p>
          <p class="start-copy">
            Si es tu primera vez aquí, esta es la ruta más corta: {anchorPosts.length} textos que dan
            el contexto que el resto de la colección da por hecho.
          </p>
          <ol class="start-list">
            {anchorPosts.map((post) => (
              <li><a href={`/articulos/${post.id}/`}>{post.data.title}</a></li>
            ))}
          </ol>
        </section>
      )}

      <nav class="container toc" aria-label="Índice de secciones">
        <p class="eyebrow toc-label">Índice de secciones</p>
        <div class="toc-grid">
          {sections.map((s, i) => (
            <a href={`#s${String(i + 1).padStart(2, '0')}`}>
              {String(i + 1).padStart(2, '0')} · {s.title}
            </a>
          ))}
        </div>
        {usedTags.length > 0 && (
          <p class="tag-legend">
            {usedTags.map((t, i) => (
              <>
                {i > 0 && <span class="dot">·</span>}
                <span class={`tag tag-${t}`}>{tagCopy[t][0]}</span> {tagCopy[t][1]}
              </>
            ))}
          </p>
        )}
      </nav>

      {sections.map((section, si) => {
        const num = String(si + 1).padStart(2, '0');
        return (
          <section class="container coll-section" id={`s${num}`}>
            <div class="sec-head">
              <span class="sec-num">{num}</span>
              <div class="sec-info">
                <h2 class="sec-title">{section.title}</h2>
                <p class="sec-desc">{section.description}</p>
              </div>
              <span class="sec-count eyebrow">{section.posts.length} artículos</span>
            </div>
            {isInvestigative ? (
              <div class="card-grid">
                {section.posts.map((entry) => {
                  const post = postMap.get(entry.slug);
                  if (!post) return null;
                  return (
                    <a class="inv-card" href={`/articulos/${post.id}/`}>
                      {entry.label && <span class="inv-card-id">{entry.label}</span>}
                      <span class="inv-card-title">{post.data.title}</span>
                      <span class="inv-card-desc">{post.data.description}</span>
                      <span class="inv-card-arrow">→</span>
                    </a>
                  );
                })}
              </div>
            ) : (
              <div class="sec-list">
                {section.posts.map((entry, i) => {
                  const post = postMap.get(entry.slug);
                  if (!post) return null;
                  return (
                    <CollectionArticleRow
                      index={i + 1}
                      slug={post.id}
                      title={post.data.title}
                      description={post.data.description}
                      pubDate={post.data.pubDate}
                      body={post.body}
                      tag={entry.tag}
                    />
                  );
                })}
              </div>
            )}
          </section>
        );
      })}

      {capstonePost && (
        <section class="container capstone-wrap">
          <a class="capstone" href={`/articulos/${capstonePost.id}/`}>
            <span class="capstone-badge">Entregable final</span>
            {hub.data.capstoneLabel && <span class="inv-card-id">{hub.data.capstoneLabel}</span>}
            <span class="capstone-title">{capstonePost.data.title}</span>
            <span class="capstone-desc">{capstonePost.data.description}</span>
          </a>
        </section>
      )}
    </>
  ) : (
    <section class="container list">
      <p class="eyebrow list-label">El índice</p>
      {posts.map((post, i) => (
        <CollectionArticleRow
          index={i + 1}
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          body={post.body}
        />
      ))}
    </section>
  )}

  {related.length > 0 && (
    <nav class="container related-nav" aria-label="Colecciones relacionadas">
      {related.map((r) => (
        <a class="related-card" href={`/colecciones/${r.id}/`}>
          <span class="eyebrow">Colección relacionada</span>
          <span class="related-title">{r.data.title} →</span>
        </a>
      ))}
    </nav>
  )}
</Layout>

<style>
  .header { padding: 56px 24px 24px; max-width: 760px; }
  .header h1 { font-family: var(--font-display); font-size: clamp(2.1rem, 4.6vw, 3rem); margin: 12px 0 16px; }
  .dek { color: var(--text-muted); font-size: 1.1rem; line-height: 1.55; }

  .intro-box {
    max-width: 760px;
    margin: 8px auto 0;
    padding: 18px 22px;
    border-left: 4px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: var(--accent-soft);
  }
  .intro-box p { font-size: 0.98rem; line-height: 1.65; color: var(--text); }
  .intro-box p :global(strong) { color: var(--text); font-weight: 700; }

  .findings-box {
    max-width: 760px;
    margin: 24px auto 0;
    padding: 20px 22px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
  }
  .findings-label { color: var(--accent); margin-bottom: 12px; }
  .findings-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .findings-list li {
    position: relative;
    padding-left: 18px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text);
  }
  .findings-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
  .findings-list li :global(strong) { color: var(--text); font-weight: 700; }

  .conclusion-box {
    max-width: 760px;
    margin: 24px auto 0;
    padding: 20px 22px;
    border-left: 4px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: var(--accent-soft);
  }
  .conclusion-label { color: var(--accent); margin-bottom: 8px; }
  .conclusion-box p:not(.conclusion-label) { font-size: 0.96rem; line-height: 1.7; color: var(--text); }
  .conclusion-box p :global(strong) { color: var(--text); font-weight: 700; }

  .start-box {
    max-width: 760px;
    margin: 24px auto 0;
    padding: 20px 22px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
  }
  .start-label { color: var(--accent); margin-bottom: 6px; }
  .start-copy { color: var(--text-muted); font-size: 0.92rem; line-height: 1.55; margin-bottom: 14px; }
  .start-list { list-style: none; counter-reset: step; display: flex; flex-direction: column; gap: 8px; }
  .start-list li { counter-increment: step; display: flex; gap: 10px; align-items: baseline; }
  .start-list li::before {
    content: counter(step);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateY(1px);
  }
  .start-list a { font-size: 0.95rem; color: var(--text); }
  .start-list a:hover { color: var(--accent); }

  .toc {
    max-width: 760px;
    margin: 24px auto 0;
    padding: 18px 22px 20px;
    border-radius: var(--radius-sm);
    background: var(--bg-inset);
  }
  .toc-label { color: var(--text-faint); margin-bottom: 10px; }
  .toc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px; }
  .toc-grid a { font-size: 0.88rem; color: var(--accent); padding: 3px 0; }
  .toc-grid a:hover { text-decoration: underline; }
  .tag-legend {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--text-faint);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .tag-legend .dot { margin: 0 2px; }

  .coll-section { max-width: 800px; padding: 40px 24px 8px; scroll-margin-top: 88px; }
  .coll-section:last-of-type { padding-bottom: 40px; }
  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-bottom: 14px;
    margin-bottom: 4px;
    border-bottom: 2px solid var(--border-strong);
  }
  .sec-num { font-family: var(--font-mono); font-size: 1rem; color: var(--accent); font-weight: 600; }
  .sec-info { flex: 1; min-width: 0; }
  .sec-title { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.25; }
  .sec-desc { color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin-top: 4px; }
  .sec-count { white-space: nowrap; color: var(--text-faint); }
  .sec-list { padding: 0; }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    padding: 4px 0 8px;
  }
  .inv-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text);
    position: relative;
  }
  .inv-card:hover { border-color: var(--accent); }
  .inv-card-id {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    font-weight: 600;
  }
  .inv-card-title { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.3; }
  .inv-card:hover .inv-card-title { color: var(--accent); }
  .inv-card-desc { color: var(--text-muted); font-size: 0.86rem; line-height: 1.5; }
  .inv-card-arrow {
    position: absolute;
    bottom: 18px;
    right: 20px;
    color: var(--border-strong);
    font-family: var(--font-mono);
  }
  .inv-card:hover .inv-card-arrow { color: var(--accent); }

  .capstone-wrap { max-width: 800px; padding: 8px 24px 8px; }
  .capstone {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 30px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--text);
  }
  .capstone:hover .capstone-title { color: var(--accent); }
  .capstone-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 4px 10px;
    border-radius: 4px;
    font-weight: 600;
  }
  .capstone-title { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.3; }
  .capstone-desc { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; max-width: 62ch; }

  .related-nav {
    max-width: 800px;
    padding: 32px 24px 96px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    background: var(--bg-elevated);
  }
  .related-card:hover { border-color: var(--accent); }
  .related-card .eyebrow { color: var(--text-faint); margin-bottom: 6px; }
  .related-title { font-family: var(--font-display); font-size: 1.05rem; }

  .list { padding: 24px 24px 96px; max-width: 780px; }
  .list-label { margin-bottom: 6px; }

  @media (max-width: 640px) {
    .toc-grid { grid-template-columns: 1fr; }
    .sec-head { flex-wrap: wrap; }
    .sec-count { display: none; }
    .related-nav { grid-template-columns: 1fr; }
  }
</style>
