---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const hubs = await getCollection('editorialCollections', ({ data }) => data.kind === 'hub');
  return hubs.map((h) => ({ params: { slug: h.id }, props: { hub: h } }));
}

const { hub } = Astro.props;
const posts = (
  await Promise.all(hub.data.postSlugs.map((slug: string) => getEntry('posts', slug)))
).filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Layout title={hub.data.title} description={hub.data.description}>
  <section class="container header">
    <p class="eyebrow">Colección · {posts.length} artículos</p>
    <h1>{hub.data.title}</h1>
    <p class="dek">{hub.data.description}</p>
  </section>

  <section class="container grid">
    {posts.map((post) => (
      <ArticleCard
        slug={post.id}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        heroImage={post.data.heroImage}
        heroImageAlt={post.data.heroImageAlt}
        body={post.body}
        variant="compact"
      />
    ))}
  </section>
</Layout>

<style>
  .header { padding: 56px 24px 24px; max-width: 720px; }
  .header h1 { font-family: var(--font-display); font-size: clamp(2.1rem, 4.6vw, 3rem); margin: 12px 0 16px; }
  .dek { color: var(--text-muted); font-size: 1.1rem; line-height: 1.55; }

  .grid {
    padding: 24px 24px 96px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 28px;
  }
  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
