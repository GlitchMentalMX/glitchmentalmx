---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { books as published, upcomingBooks as upcoming } from '../../data/books';
import BookActions from '../../components/BookActions.astro';
import { getCollection } from 'astro:content';

// Serie de origen de cada novela: sale de `relatedBook` en las colecciones.
const seriesList = await getCollection('editorialCollections', ({ data }) => data.kind === 'series' && !!data.relatedBook);
const seriesByBook = new Map(seriesList.map((s) => [s.data.relatedBook!, s]));
---

<Layout
  title="Novelas sobre IA y tecnología en español"
  description="Tecnothrillers en español sobre inteligencia artificial, vigilancia algorítmica y edición genética, de Jorge A. Diaz Elizondo. Ficción anclada en hechos reales."
>
  <PageHeader
    eyebrow="Novelas · Jorge A. Diaz Elizondo"
    title="Tecnothriller de **credibilidad periodística.**"
    dek="Ficción anclada en hechos reales. Cada novela nace de la misma fuente: investigación documentada, datos verificables y la convicción de que hay verdades que el periodismo puede documentar pero no puede hacer sentir."
  />

  <section class="container prose">
    <p>
      Jorge A. Diaz Elizondo es escritor y director editorial de glitchMentalMX, publicación independiente
      en español especializada en inteligencia artificial, tecnología y cultura digital. La investigación
      detrás de sus novelas nace ahí — en el cruce entre el análisis crítico y la pregunta que los datos
      no responden solos.
    </p>
    <p>
      Son historias sobre tecnología, inteligencia artificial y lo que ocurre cuando esas tecnologías
      dejan de ser teoría. Cada novela nace de una serie editorial del sitio: primero el análisis, después la ficción.
    </p>
  </section>

  <section class="container catalog">
    <p class="eyebrow section-label">Catálogo · Disponible</p>
    <div class="grid">
      {published.map((b) => (
        <div class="book-card">
          <a href={`/novelas/${b.id}/`} class="cover-link">
            <img class="cover" src={b.cover} alt={`Portada de ${b.title}`} loading="lazy" width="400" height="620" />
          </a>
          <div class="body">
            <span class="tag">{b.genre}</span>
            <div class="title-row">
              <h3><a href={`/novelas/${b.id}/`}>{b.title}</a></h3>
              <a class="title-more link-accent" href={`/novelas/${b.id}/`}>Ver novela →</a>
            </div>
            <p>{b.desc}</p>
            {seriesByBook.get(b.id) && (
              <p class="origin">
                Nació de la serie <a href={`/series/${seriesByBook.get(b.id)!.id}/`}>{seriesByBook.get(b.id)!.data.title}</a>
              </p>
            )}
            <BookActions book={b} />
          </div>
        </div>
      ))}
    </div>

    {upcoming.length > 0 && (
      <>
        <p class="eyebrow section-label upcoming-label">En desarrollo · Vienen más</p>
        <div class="grid">
          {upcoming.map((b) => (
            <div class="book-card muted">
              <h3>{b.title}</h3>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>
        <p class="footnote">* Estas son las próximas en desarrollo — los títulos y sinopsis pueden cambiar antes de su publicación.</p>
      </>
    )}
  </section>

  <section class="container actions">
    <a class="btn btn-ghost" href="https://www.amazon.com.mx/stores/author/B0H5BZ5LPM/allbooks" target="_blank" rel="noopener">Amazon Author Page →</a>
    <a class="btn btn-ghost" href="https://www.goodreads.com/author/show/70678530.Jorge_A_Diaz_Elizondo" target="_blank" rel="noopener">Goodreads →</a>
    <a class="btn btn-ghost" href="mailto:jorge@glitchmental.com">jorge@glitchmental.com</a>
  </section>
</Layout>

<style>
  .prose { padding: 0 24px 8px; max-width: var(--measure); }
  .catalog { padding: 16px 24px 8px; }
  .section-label { padding: 0; margin-bottom: 14px; }
  .upcoming-label { margin-top: 40px; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .book-card {
    background: var(--bg-inset);
    border-radius: var(--radius);
    padding: 22px;
    display: flex;
    gap: 20px;
  }
  .book-card.muted { opacity: 0.75; padding: 26px; }
  .cover {
    width: 108px;
    height: 168px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
    box-shadow: 0 6px 18px rgba(20, 22, 28, 0.18);
  }
  .book-card .body { min-width: 0; }
  .cover-link { display: block; flex-shrink: 0; }
  .title-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 12px; margin: 10px 0 10px; }
  .book-card h3 { font-family: var(--font-display); font-size: 1.3rem; margin: 0; }
  /* En escritorio "Ver la novela" va junto al título; en móvil baja a las acciones. */
  .title-more { display: none; font-size: 0.85rem; font-weight: 600; white-space: nowrap; }
  .title-more:hover { text-decoration: underline; }
  .book-card h3 a { color: var(--text); }
  .book-card h3 a:hover { color: var(--accent); }
  .book-card p { color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0 0 18px; }
  .book-card .origin { font-size: 0.85rem; margin: -6px 0 16px; color: var(--text-faint); }
  .book-card .origin a { color: var(--accent); }
  .book-card .origin a:hover { text-decoration: underline; }
  .footnote { font-size: 0.82rem; color: var(--text-faint); margin-top: 16px; }

  .actions { padding: 24px 24px 96px; display: flex; flex-wrap: wrap; gap: 12px; }

  @media (min-width: 701px) {
    .title-more { display: inline; }
    .book-card :global(.book-actions .more) { display: none; }
    .book-card :global(.book-actions) { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 10px; }
    .book-card :global(.book-actions.block .main) { width: auto; flex: 1 1 auto; }
  }
  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; }
    .book-card { flex-direction: column; }
    .cover { width: 96px; height: 148px; }
  }
</style>
