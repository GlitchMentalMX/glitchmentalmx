---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const includes = [
  'Artículo en HTML listo para publicar (texto + metadatos)',
  'Imagen editorial única — sin stock, sin plantillas',
  'Investigación con fuentes verificadas, fetch obligatorio',
  'Alt text SEO estructurado por archivo',
  'Corrección ortográfica y gramatical meticulosa',
  '5 posts adaptados por plataforma de redes sociales',
  'Revisión editorial humana final en cada pieza',
  'Publicación gestionada por el cliente',
];

const quality = [
  'Inteligencia de tendencias en tiempo real con verificación de fuente',
  'Fetch obligatorio de cada URL antes de redactar — dato no confirmado, dato eliminado',
  'Redacción con reglas estrictas de veracidad, estilo y gramática',
  'Imagen editorial con dirección de arte propia — prompt único por artículo, estética de marca',
  'Corrección gramatical meticulosa con reglas fonéticas del español',
  'Revisión editorial humana final — ninguna pieza sale sin ese filtro',
];

const tiers = [
  { name: 'Editorial Unit 1', price: '$3,500/mes', vol: 'Hasta 40 piezas mensuales', desc: 'Entregas semanales consistentes. Flujo completo incluido. Ideal para publicaciones en crecimiento.' },
  { name: 'Editorial Unit 3', price: '$7,000/mes', vol: 'Hasta 70 piezas mensuales', desc: 'Alto volumen con consistencia editorial completa. Equivalente a 2–3 redactores de tiempo completo.' },
  { name: 'Editorial Unit 5', price: '$12,000/mes', vol: '100+ piezas mensuales', desc: 'Capacidad máxima. Para operaciones de medios que compiten por volumen y velocidad.' },
];
---

<Layout
  title="Servicios Editoriales"
  description="La operación completa de una sala de redacción digital. Sin el equipo."
>
  <PageHeader
    eyebrow="Servicios editoriales"
    title="La operación completa de una sala de redacción digital. Sin el equipo."
    dek="No compras contenido. Compras continuidad editorial. Redacción, corrección, dirección de arte, SEO y distribución social — orquestados con múltiples modelos de IA y revisión humana en cada pieza."
  />

  <p class="container lang-switch"><a href="/editorial-services-glitchmentalmx/">Read this in English →</a></p>

  <section class="container two-col">
    <div>
      <h2>Qué incluye cada entrega</h2>
      <ul class="checks">{includes.map((i) => <li>→ {i}</li>)}</ul>
    </div>
    <div>
      <h2>Proceso de calidad</h2>
      <ul class="checks">{quality.map((i) => <li>✓ {i}</li>)}</ul>
    </div>
  </section>

  <section class="container prose">
    <h2>Dirección de arte visual — no es stock</h2>
    <p>Cada artículo recibe una imagen editorial generada con un prompt visual único — construido específicamente para ese concepto, con metáfora propia y estética de marca. No se reutilizan composiciones. No hay stock. No hay plantillas.</p>

    <h2>Adaptable a cualquier nicho de contenido</h2>
    <p>El sistema editorial se configura según tu área temática. Categorías, tono, criterios de fuentes y estética visual se ajustan a tu publicación — no al revés.</p>

    <h2>Este sistema no es una promesa</h2>
    <p>Es lo que estás viendo ahora mismo. GlitchMentalMX opera con este pipeline en producción: 300+ piezas publicadas, imagen editorial única en cada artículo, cero stock, revisión humana en cada entrega. El sitio es la demo.</p>
  </section>

  <section class="container pricing">
    <p class="eyebrow section-label">Capacidad editorial mensual (USD)</p>
    <div class="grid">
      {tiers.map((t) => (
        <div class="tier-card">
          <h3>{t.name}</h3>
          <p class="price">{t.price}</p>
          <p class="vol">{t.vol}</p>
          <p class="desc">{t.desc}</p>
        </div>
      ))}
    </div>
    <p class="footnote">Incluye la ejecución completa de la función editorial: investigación, redacción, dirección de arte, SEO y preparación para distribución. Publicación, analítica y CMS a cargo del cliente. * Organizaciones en Latinoamérica: escríbeme para condiciones de precio regionales.</p>
  </section>

  <section class="container closing">
    <h3>¿Prefieres operar el sistema tú mismo?</h3>
    <p>El sistema completo — orquestación de 4 modelos de IA, 6 módulos documentados, prompts, workflows, protocolos de calidad y configuración por nicho — está disponible para adquisición directa.</p>
    <a class="btn btn-primary" href="mailto:jorge@glitchmental.com">Escríbeme — propuesta en 48 horas, sin costo →</a>
  </section>
</Layout>

<style>
  .lang-switch { padding: 0 24px; margin: -8px 0 8px; font-size: 0.88rem; }
  .two-col {
    padding: 8px 24px 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .two-col h2 { font-size: 1.2rem; margin-bottom: 14px; }
  .checks { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .checks li { color: var(--text-muted); font-size: 0.92rem; line-height: 1.5; }

  .prose { padding: 24px 24px 8px; }

  .pricing { padding: 16px 24px; }
  .section-label { margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .tier-card { background: var(--bg-inset); border-radius: var(--radius); padding: 26px; }
  .tier-card h3 { font-size: 1.05rem; }
  .price { font-family: var(--font-mono); color: var(--accent); font-weight: 600; font-size: 1.1rem; margin: 8px 0 2px; }
  .vol { font-size: 0.82rem; color: var(--text-faint); margin: 0 0 12px; }
  .desc { font-size: 0.88rem; color: var(--text-muted); line-height: 1.55; margin: 0; }
  .footnote { font-size: 0.82rem; color: var(--text-faint); margin-top: 20px; }

  .closing { padding: 40px 24px 96px; max-width: 620px; }
  .closing h3 { font-size: 1.3rem; margin-bottom: 10px; }
  .closing p { color: var(--text-muted); margin-bottom: 20px; }

  @media (max-width: 800px) {
    .two-col, .grid { grid-template-columns: 1fr; }
  }
</style>
