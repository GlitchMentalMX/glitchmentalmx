---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="Esta página no existe." noIndex>
  <section class="container not-found">
    <p class="eyebrow">Error 404</p>
    <h1>Esto no es lo que buscabas.</h1>
    <p class="dek">La página que buscas no existe o cambió de dirección durante la migración.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Ir al inicio</a>
      <a class="btn btn-ghost" href="/buscar/">Buscar en el sitio</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: 120px 24px;
    max-width: 640px;
    text-align: center;
    margin: 0 auto;
  }
  .not-found h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 14px 0 14px;
  }
  .dek { color: var(--text-muted); font-size: 1.05rem; margin-bottom: 32px; }
  .actions { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
</style>
