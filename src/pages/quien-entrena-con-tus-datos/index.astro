---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EntrenaIARow from '../../components/EntrenaIARow.astro';
import BuscadorPreciosIA from '../../components/BuscadorPreciosIA.astro';
import { getCollection } from 'astro:content';

const VEREDICTO_ORDEN = { rojo: 0, amarillo: 1, verde: 2 };

const posts = (await getCollection('entrenaIA', ({ data }) => !data.draft)).sort((a, b) => {
  const porVeredicto = VEREDICTO_ORDEN[a.data.veredicto] - VEREDICTO_ORDEN[b.data.veredicto];
  return porVeredicto !== 0 ? porVeredicto : a.data.herramienta.localeCompare(b.data.herramienta, 'es');
});

// {nombre, slug} generado en build-time desde la colección — mismo buscador
// que /precios-ia/, sin lista escrita a mano.
const buscadorItems = posts.map((post) => ({
  nombre: post.data.herramienta,
  slug: post.id,
}));

const title = 'Quién entrena su IA con tus datos';
const description =
  '¿Meta, TikTok, LinkedIn o Adobe usan lo que subes o escribes para entrenar su inteligencia artificial? Verificado directamente en cada política de privacidad, con la opción de salir si existe.';
---

<Layout title={title} description={description}>
  <Breadcrumbs items={[
    { name: 'IA sin letra chiquita', url: '/ia-sin-letra-chiquita/' },
    { name: 'Quién entrena con tus datos' },
  ]} />
  <section class="container header">
    <p class="eyebrow">Privacidad de IA · {posts.length} herramientas verificadas</p>
    <h1>Quién entrena su IA con tus datos</h1>
    <p class="dek">
      Cada herramienta que usas todos los días — sea una app, un asistente de voz, la cámara de tu
      puerta o el coche que manejas — tiene una respuesta distinta a la misma pregunta: ¿mis fotos,
      mensajes o archivos alimentan un modelo de IA sin que yo lo decida? Aquí está la respuesta de
      cada una, verificada en su política de privacidad oficial — no en lo que dice su equipo de prensa.
    </p>
  </section>

  <section class="container leyenda">
    <span class="leyenda-item"><span aria-hidden="true">🔴</span> Entrena con tus datos, sin opción real de salir</span>
    <span class="leyenda-item"><span aria-hidden="true">🟡</span> Depende del plan, la región o requiere que tú lo desactives</span>
    <span class="leyenda-item"><span aria-hidden="true">🟢</span> No entrena, o no lo hace por default</span>
  </section>

  <section class="container list">
    <p class="eyebrow list-label">Las herramientas</p>
    <BuscadorPreciosIA items={buscadorItems} />
    {posts.map((post, i) => (
      <EntrenaIARow
        index={i + 1}
        slug={post.id}
        herramienta={post.data.herramienta}
        veredicto={post.data.veredicto}
        fraseCorta={post.data.fraseCorta}
      />
    ))}
  </section>
</Layout>

<style>
  .header { padding: 56px 24px 24px; max-width: 760px; }
  .header h1 { font-family: var(--font-display); font-size: clamp(2.1rem, 4.6vw, 3rem); margin: 12px 0 16px; }
  .dek { color: var(--text-muted); font-size: 1.1rem; line-height: 1.55; }

  .leyenda {
    max-width: 760px;
    padding: 0 24px 28px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px 20px;
  }
  .leyenda-item {
    font-size: 0.84rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 700px) {
    .leyenda { grid-template-columns: 1fr; }
  }

  .list { padding: 24px 24px 96px; max-width: 780px; }
  .list-label { margin-bottom: 6px; }
</style>
