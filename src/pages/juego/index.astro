---
// Ruta independiente del juego. A propósito NO usa Layout.astro: así no hereda
// header, footer, Lightbox, banner de cookies ni el beacon de analytics, y no
// hay que tocar ningún componente compartido del sitio editorial. El juego no
// guarda cookies ni manda datos a ningún lado — su único almacenamiento es el
// localStorage del propio navegador (ver src/game/core/save.ts).
// noindex mientras Jorge no autorice lo contrario; también está fuera del
// sitemap (ver el filtro en astro.config.mjs).
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0b10" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Juego (prototipo)</title>
  </head>
  <body>
    <div id="stage-bg" aria-hidden="true"></div>
    <div id="game" role="application" aria-label="Videojuego de exploración"></div>
    <noscript>
      <p class="nojs">Este juego necesita JavaScript activado para funcionar.</p>
    </noscript>
  </body>
</html>

<script>
  import '../../game/main';
</script>

<style is:global>
  html,
  body {
    margin: 0;
    height: 100%;
    background: #0b0b10;
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    font-family: ui-rounded, 'Trebuchet MS', system-ui, sans-serif;
  }
  #game {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
  }
  #game canvas {
    display: block;
    touch-action: none;
  }
  /* Relleno decorativo para pantallas horizontales: el escenario es 9:16 y
     nunca se deforma, así que a los lados queda este collage abstracto. */
  #stage-bg {
    position: fixed;
    inset: 0;
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 14px, transparent 14px 28px),
      radial-gradient(circle at 12% 18%, rgba(255, 64, 129, 0.18), transparent 38%),
      radial-gradient(circle at 88% 78%, rgba(0, 229, 255, 0.16), transparent 40%),
      radial-gradient(circle at 80% 12%, rgba(255, 214, 0, 0.12), transparent 32%),
      #0b0b10;
  }
  .nojs {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    text-align: center;
    padding: 24px;
    margin: 0;
  }
</style>
