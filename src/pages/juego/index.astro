---
// Ruta independiente del juego. A propósito NO usa Layout.astro: así no hereda
// header, footer, Lightbox ni banner de cookies, y no hay que tocar ningún
// componente compartido del sitio editorial. Solo reusa el beacon de
// analytics (anónimo, sin cookies, respeta ?gm-optout=1). El progreso del
// juego vive únicamente en el localStorage del navegador (src/game/core/save.ts).
// Indexable desde 2026-10-22 (autorizado por Jorge). Como la página es un canvas
// sin texto propio, el SEO vive en: <title>/description/OG, el JSON-LD VideoGame,
// el bloque .sr-only (texto real para lectores de pantalla y buscadores) y los
// enlaces internos desde el sitio (Footer + tarjeta en artículos afines).
import Analytics from '../../components/Analytics.astro';

const site = Astro.site ?? new URL('https://glitchmental.com');
const url = new URL('/juego/', site).toString();
const image = new URL('/juego/og.png', site).toString();
const siteName = 'glitchMentalMX';
const gameName = 'Pulsa para Empeorar';
const title = `${gameName}: juego web gratis de humor absurdo · ${siteName}`;
const description =
  'Intenta cancelar una suscripción en una sala de espera absurda. Juego web gratis en español, sin descargas ni registro. 5 personajes y varios finales.';
const imageAlt = 'Pulsa para Empeorar: captura del juego, una sala de espera de atención al cliente con una máquina de cookies que te hace un examen.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${url}#juego`,
      name: gameName,
      url,
      description:
        'Videojuego de aventura y humor absurdo en español para navegador y celular. Estás en la sala de espera de Atención al Cliente e intentas cancelar una suscripción que nunca pediste: una máquina de cookies que no te deja rechazarlas, un asistente de IA que insiste en retenerte y una puerta de salida escondida detrás de una planta. Cinco personajes, varios finales y secretos por descubrir. Sátira de los patrones oscuros y la atención al cliente automatizada.',
      image,
      inLanguage: 'es',
      genre: ['Aventura', 'Comedia', 'Sátira'],
      gamePlatform: ['Navegador web', 'iOS', 'Android'],
      applicationCategory: 'Game',
      operatingSystem: 'Cualquier sistema con navegador web',
      playMode: 'SinglePlayer',
      numberOfPlayers: { '@type': 'QuantitativeValue', value: 1 },
      isAccessibleForFree: true,
      datePublished: '2026-10-22',
      keywords:
        'juego web gratis, juego en el navegador, juego sin descargar, juego sin registro, juego de humor absurdo, juego indie en español, juego satírico, juego para celular, cancelar suscripción, atención al cliente, patrones oscuros, cookies, chatbot, sala de espera',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'MXN', availability: 'https://schema.org/InStock' },
      author: { '@type': 'Organization', name: siteName, url: site.toString() },
      publisher: { '@type': 'Organization', name: siteName, url: site.toString() },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.toString() },
        { '@type': 'ListItem', position: 2, name: gameName, item: url },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#0b0b10" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GlitchMentalMX" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <div id="stage-bg" aria-hidden="true"></div>
    <!-- Texto real de la página (el juego es un canvas sin texto propio). Visible para
         lectores de pantalla y buscadores; se oculta solo visualmente (no display:none). -->
    <div class="sr-only">
      <h1>Pulsa para Empeorar: un juego web gratis de humor absurdo</h1>
      <p>
        Pulsa para Empeorar es un videojuego de aventura y humor en español que se juega en el navegador, en el celular
        o en la computadora, sin descargar nada y sin crear una cuenta. Estás en la sala de espera de Atención al Cliente
        de una empresa absurda e intentas cancelar una suscripción que nunca pediste. Hay una máquina de cookies que no te
        deja rechazarlas, un asistente de inteligencia artificial que insiste en retenerte, una sombra que se independiza
        y una puerta de salida escondida detrás de una planta.
      </p>
      <p>
        Eliges entre cinco personajes, cada uno con sus propias rutas, secretos y finales. Es una sátira de los patrones
        oscuros, los términos y condiciones que nadie lee y la atención al cliente automatizada. Lo creó glitchMentalMX,
        un sitio de análisis crítico de tecnología, inteligencia artificial y cultura digital.
      </p>
      <p>
        Para entender el mecanismo real detrás del juego, lee
        <a href="/articulos/cancelar-cuesta-mas-que-contratar-patron-oscuro/">Cancelar cuesta más que contratar: jugamos al patrón oscuro</a>.
        <a href="/">Ir a glitchMentalMX</a>
      </p>
    </div>
    <div id="game" role="application" aria-label="Pulsa para Empeorar, videojuego de humor absurdo"></div>
    <Analytics />
    <!-- Aviso para teléfonos y tabletas en horizontal. El juego está diseñado en
         vertical (9:16): así caben el escenario completo, los diálogos y las
         decisiones sin estirar ni recortar nada. Solo se muestra con pantalla
         táctil + horizontal; en monitores de escritorio no aparece. El juego se
         pausa mientras tanto (ver main.ts) y la partida no se pierde. -->
    <div id="rotate" role="alert">
      <svg class="rotate-icon" viewBox="0 0 64 64" width="96" height="96" aria-hidden="true">
        <rect x="18" y="4" width="28" height="56" rx="6" fill="none" stroke="#f6f3ec" stroke-width="3.5" />
        <circle cx="32" cy="52" r="2.4" fill="#f6f3ec" />
        <rect x="26" y="9" width="12" height="2.6" rx="1.3" fill="#f6f3ec" />
      </svg>
      <p class="rotate-title">Gira tu teléfono</p>
      <p class="rotate-text">
        Este juego se juega en vertical: así caben el escenario completo, los diálogos y tus decisiones sin estirar ni recortar nada.
      </p>
      <p class="rotate-note">Tu partida sigue en pausa. Al volver a ponerlo derecho, continúas donde estabas.</p>
    </div>
    <noscript>
      <p class="nojs">Este juego necesita JavaScript activado para funcionar. <a href="/" style="color:#ffd23f">Volver a glitchMentalMX</a></p>
    </noscript>
  </body>
</html>

<script>
  import '../../game/main';
</script>

<style is:global>
  html,
  body {
    margin: 0;
    height: 100%;
    background: #0b0b10;
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    font-family: ui-rounded, 'Trebuchet MS', system-ui, sans-serif;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  #game {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
  }
  #game canvas {
    display: block;
    touch-action: none;
  }
  /* Relleno decorativo para pantallas horizontales: el escenario es 9:16 y
     nunca se deforma, así que a los lados queda este collage abstracto. */
  #stage-bg {
    position: fixed;
    inset: 0;
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 14px, transparent 14px 28px),
      radial-gradient(circle at 12% 18%, rgba(255, 64, 129, 0.18), transparent 38%),
      radial-gradient(circle at 88% 78%, rgba(0, 229, 255, 0.16), transparent 40%),
      radial-gradient(circle at 80% 12%, rgba(255, 214, 0, 0.12), transparent 32%),
      #0b0b10;
  }
  #rotate {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #0b0b10;
    color: #f6f3ec;
    text-align: center;
    padding: 20px 32px;
    box-sizing: border-box;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  @media (hover: none) and (pointer: coarse) and (orientation: landscape) {
    #rotate {
      display: flex;
    }
  }
  .rotate-icon {
    animation: rotate-hint 2.4s ease-in-out infinite;
    margin-bottom: 4px;
  }
  @keyframes rotate-hint {
    0%, 20% { transform: rotate(90deg); }
    55%, 100% { transform: rotate(0deg); }
  }
  .rotate-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffd23f;
  }
  .rotate-text {
    margin: 0;
    max-width: 30em;
    font-size: 1rem;
    line-height: 1.4;
  }
  .rotate-note {
    margin: 4px 0 0;
    max-width: 30em;
    font-size: 0.85rem;
    color: #a9a5b8;
  }
  @media (prefers-reduced-motion: reduce) {
    .rotate-icon {
      animation: none;
      transform: rotate(0deg);
    }
  }
  .nojs {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    text-align: center;
    padding: 24px;
    margin: 0;
  }
</style>
