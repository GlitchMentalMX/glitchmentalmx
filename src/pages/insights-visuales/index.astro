---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('visualInsights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Insights Visuales"
  description="Ideas complejas. Una imagen. Un análisis."
>
  <PageHeader eyebrow="Insights Visuales" title="Ideas complejas. Una imagen. Un análisis." />

  <section class="container grid">
    {items.map(({ data: item }) => {
      const Tag = item.enlace ? 'a' : 'div';
      const linkProps = item.enlace
        ? item.enlace.startsWith('http')
          ? { href: item.enlace, target: '_blank', rel: 'noopener' }
          : { href: item.enlace }
        : {};
      return (
        <Tag class="card" {...linkProps}>
          <img src={item.imagen} alt={item.titulo} loading="lazy" width="900" height="506" />
          <div class="body">
            <h3>{item.titulo}</h3>
            <p>{item.resumen}</p>
          </div>
        </Tag>
      );
    })}
  </section>
</Layout>

<style>
  .grid {
    padding: 0 24px 96px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-inset);
    color: var(--text);
  }
  .card img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; }
  .card .body { padding: 18px 20px 22px; }
  .card h3 { font-size: 1.05rem; line-height: 1.3; margin-bottom: 8px; }
  .card:hover h3 { color: var(--accent); }
  .card p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.55; margin: 0; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
