---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { insightCategoryLinks } from '../../data/insightCategoryLinks';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const items = (await getCollection('visualInsights', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return paginate(items, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const pageSuffix = page.currentPage > 1 ? ` — página ${page.currentPage}` : '';
const title = `Insights Visuales${pageSuffix}`;
const description =
  page.currentPage > 1
    ? `Una imagen. Una idea. Un momento para pensar — página ${page.currentPage} de ${page.lastPage}.`
    : 'Una imagen. Una idea. Un momento para pensar.';
const modifiedTime = page.data.reduce(
  (max, item) => (item.data.date > max ? item.data.date : max),
  page.data[0]?.data.date
);
---

<Layout
  title={title}
  description={description}
  modifiedTime={modifiedTime}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <PageHeader eyebrow="Insights Visuales" title="Una imagen. Una idea. **Un momento para pensar.**" />

  <script define:vars={{ prevUrl: page.url.prev ?? null, nextUrl: page.url.next ?? null }}>
    window.__lightboxPaging = { prev: prevUrl, next: nextUrl };
  </script>

  <p class="container intro">
    Una microcolumna visual sobre tecnología y cultura digital. Cada pieza propone una idea, una
    provocación o una pregunta. Los enlaces llevan a lecturas relacionadas para seguir explorando
    el tema — no al artículo que inspiró esta reflexión.
  </p>

  <p class="container hint">Haz clic en la imagen para agrandarla.</p>

  <section class="container grid">
    {page.data.map(({ data: item }) => (
      <div class="card">
        <img src={item.imagen} alt={item.imagenAlt || item.titulo} data-lightbox loading="lazy" width="900" height="506" />
        <div class="body">
          <h3>{item.titulo}</h3>
          <p>{item.resumen}</p>
          {item.categoria ? (
            <a class="category-link" href={insightCategoryLinks[item.categoria]}>{item.categoria} →</a>
          ) : (
            item.enlace && (
              <a
                class="link-accent"
                href={item.enlace}
                target={item.enlace.startsWith('http') ? '_blank' : undefined}
                rel={item.enlace.startsWith('http') ? 'noopener' : undefined}
              >
                Ir al artículo →
              </a>
            )
          )}
        </div>
      </div>
    ))}
  </section>

  <nav class="container pager" aria-label="Paginación">
    {page.url.prev ? <a href={page.url.prev} class="btn btn-ghost">← Más recientes</a> : <span />}
    <span class="eyebrow">Página {page.currentPage} de {page.lastPage}</span>
    {page.url.next ? <a href={page.url.next} class="btn btn-ghost">Más antiguos →</a> : <span />}
  </nav>
</Layout>

<style>
  .intro {
    padding: 0 24px;
    max-width: 760px;
    margin: -8px auto 20px;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .hint { padding: 0 24px; color: var(--text); font-size: 0.92rem; font-weight: 500; margin: 0 auto 24px; }

  .grid {
    padding: 0 24px 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-inset);
    color: var(--text);
  }
  .card img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; }
  .card .body { padding: 18px 20px 22px; }
  .card h3 { font-size: 1.05rem; line-height: 1.3; margin-bottom: 8px; }
  .card p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.55; margin: 0 0 12px; }
  .card .link-accent { font-size: 0.86rem; font-weight: 600; }
  .card .category-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .card .category-link:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }

  .pager {
    padding: 32px 24px 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
</style>
