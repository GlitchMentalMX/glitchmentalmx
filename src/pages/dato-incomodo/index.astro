---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('datoIncomodo')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Dato Incómodo"
  description="Lo que no te conviene saber... publicado de todas formas."
>
  <PageHeader eyebrow="Dato Incómodo" title="Lo que no te conviene saber... publicado de todas formas." />

  <p class="container hint">Haz clic en la imagen para agrandarla.</p>

  <section class="container grid">
    {items.map(({ data: item }, i) => (
      <div class="card">
        <img src={item.imagen} alt={item.resumen} data-lightbox loading="lazy" width="900" height="506" />
        <div class="body">
          <p class="eyebrow num">Dato incómodo №{i + 1}</p>
          <p class="text">{item.resumen}</p>
        </div>
      </div>
    ))}
  </section>
</Layout>

<style>
  .hint { padding: 0 24px; color: var(--text-muted); font-size: 0.92rem; font-weight: 500; margin: -8px auto 24px; }

  .grid {
    padding: 0 24px 96px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-inset);
  }
  .card img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; }
  .card .body { padding: 18px 20px 22px; }
  .num { margin-bottom: 8px; }
  .text { font-family: var(--font-display); font-size: 1.1rem; line-height: 1.4; margin: 0; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
