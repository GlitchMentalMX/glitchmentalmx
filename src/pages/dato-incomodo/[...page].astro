---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { assignPieceSlugs } from '../../lib/pieceSlug.mjs';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const items = (await getCollection('datoIncomodo', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return paginate(items, { pageSize: 18 });
}) satisfies GetStaticPaths;

// Mismo cálculo que src/pages/dato-incomodo/[slug].astro — el permalink que
// se muestra en el lightbox (ver data-permalink abajo) tiene que apuntar a
// exactamente la misma URL que esa página genera para la misma pieza.
const slugs = assignPieceSlugs(
  (await getCollection('datoIncomodo', ({ data }) => !data.draft)).map((item) => ({
    id: item.id,
    override: item.data.slug,
    text: item.data.resumen,
  }))
);

const { page } = Astro.props;

const pageSuffix = page.currentPage > 1 ? ` — página ${page.currentPage}` : '';
const title = `Dato Incómodo${pageSuffix}`;
const description =
  page.currentPage > 1
    ? `Lo que no te conviene saber... publicado de todas formas — página ${page.currentPage} de ${page.lastPage}.`
    : 'Lo que no te conviene saber... publicado de todas formas.';
const modifiedTime = page.data.reduce(
  (max, item) => (item.data.date > max ? item.data.date : max),
  page.data[0]?.data.date
);
---

<Layout
  title={title}
  description={description}
  modifiedTime={modifiedTime}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <Breadcrumbs items={[{ name: 'Dato Incómodo' }]} />
  <PageHeader eyebrow="Dato Incómodo" title="Lo que no te conviene saber... **publicado de todas formas.**" />

  <script define:vars={{ prevUrl: page.url.prev ?? null, nextUrl: page.url.next ?? null }}>
    window.__lightboxPaging = { prev: prevUrl, next: nextUrl };
  </script>

  <p class="container hint">Haz clic en la imagen para agrandarla.</p>

  <section class="container grid">
    {page.data.map((entry) => (
      <div class="card">
        <img
          src={entry.data.imagen}
          alt={entry.data.imagenAlt}
          data-lightbox
          data-desc={entry.data.resumen}
          data-permalink={`/dato-incomodo/${slugs.get(entry.id)}/`}
          loading="lazy"
          width="900"
          height="506"
        />
        <div class="body">
          <p class="text">{entry.data.resumen}</p>
        </div>
      </div>
    ))}
  </section>

  <nav class="container pager" aria-label="Paginación">
    {page.url.prev ? <a href={page.url.prev} class="btn btn-ghost">← Más recientes</a> : <span />}
    <span class="eyebrow">Página {page.currentPage} de {page.lastPage}</span>
    {page.url.next ? <a href={page.url.next} class="btn btn-ghost">Más antiguos →</a> : <span />}
  </nav>
</Layout>

<style>
  .hint { padding: 0 24px; color: var(--text-muted); font-size: 0.92rem; font-weight: 500; margin: -8px auto 24px; }

  .grid {
    padding: 0 24px 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-inset);
  }
  .card img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; }
  .card .body { padding: 18px 20px 22px; }
  .text { font-family: var(--font-display); font-size: 1.1rem; line-height: 1.4; margin: 0; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }

  .pager {
    padding: 32px 24px 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
</style>
