---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { isDue } from '../../lib/publishing';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const items = (await getCollection('datoIncomodo', ({ data }) => isDue(data.date))).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return paginate(items, { pageSize: 18 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout
  title="Dato Incómodo"
  description="Lo que no te conviene saber... publicado de todas formas."
>
  <PageHeader eyebrow="Dato Incómodo" title="Lo que no te conviene saber... **publicado de todas formas.**" />

  <p class="container hint">Haz clic en la imagen para agrandarla.</p>

  <section class="container grid">
    {page.data.map(({ data: item }, i) => (
      <div class="card">
        <img src={item.imagen} alt={item.resumen} data-lightbox loading="lazy" width="900" height="506" />
        <div class="body">
          <p class="eyebrow num">Dato incómodo №{page.start + i + 1}</p>
          <p class="text">{item.resumen}</p>
        </div>
      </div>
    ))}
  </section>

  <nav class="container pager" aria-label="Paginación">
    {page.url.prev ? <a href={page.url.prev} class="btn btn-ghost">← Más recientes</a> : <span />}
    <span class="eyebrow">Página {page.currentPage} de {page.lastPage}</span>
    {page.url.next ? <a href={page.url.next} class="btn btn-ghost">Más antiguos →</a> : <span />}
  </nav>
</Layout>

<style>
  .hint { padding: 0 24px; color: var(--text-muted); font-size: 0.92rem; font-weight: 500; margin: -8px auto 24px; }

  .grid {
    padding: 0 24px 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-inset);
  }
  .card img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; }
  .card .body { padding: 18px 20px 22px; }
  .num { margin-bottom: 8px; }
  .text { font-family: var(--font-display); font-size: 1.1rem; line-height: 1.4; margin: 0; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }

  .pager {
    padding: 32px 24px 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
</style>
