---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getEntry } from 'astro:content';
import { mdStrip } from '../../lib/format';

const entry = await getEntry('pages', 'suscribete');
const { title, description, eyebrow, headline, dek, noIndex } = entry.data;

const CONSENT_TEXT = 'Sí quiero recibir el Manual del Caos Digital y la versión ejecutiva del Índice glitchMentalMX.';

const deliverables = [
  {
    name: 'Manual del Caos Digital',
    cadence: 'Un tema, cada mes',
    desc: 'Un análisis a profundidad de un solo tema — IA, Cultura Digital o el futuro del trabajo — que no publicamos en el sitio. Solo lo lee quien está suscrito.',
  },
  {
    name: 'Índice glitchMentalMX — versión ejecutiva',
    cadence: 'PDF descargable',
    desc: 'El ranking de 20 tecnologías B2B en un PDF listo para imprimir o compartir con tu equipo, tus jefes o tus colegas. Incluye acceso al historial completo, mes a mes, también en PDF.',
  },
];
---

<Layout
  title={title}
  description={description}
  noIndex={noIndex}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <Breadcrumbs items={[{ name: mdStrip(headline) }]} />
  <PageHeader eyebrow={eyebrow} title={headline} dek={dek} />

  <section class="container deliverables">
    {deliverables.map((d) => (
      <div class="deliverable-card">
        <p class="eyebrow">{d.cadence}</p>
        <h2>{d.name}</h2>
        <p>{d.desc}</p>
      </div>
    ))}
  </section>

  <section class="container form-wrap">
    <form id="subscribe-form" novalidate>
      <div class="form-field">
        <label for="name">Nombre</label>
        <input id="name" name="name" type="text" autocomplete="name" required maxlength="200" />
      </div>

      <div class="form-field">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="320" />
      </div>

      <!-- Honeypot — invisible to real visitors, off-screen rather than
           display:none so simple bots that skip hidden fields still fill it. -->
      <div class="form-honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="consent">
        <input id="consent" name="consent" type="checkbox" required />
        <span>{CONSENT_TEXT}</span>
      </label>

      <button type="submit" class="btn btn-primary">Suscribirme</button>

      <p class="form-status" role="status" aria-live="polite"></p>
    </form>

    <p class="benefit">Cancela cuando quieras, sin drama.</p>
  </section>
</Layout>

<script>
  const WORKER_URL = 'https://glitchmental-subscribe.glitchmental-web.workers.dev/';
  const formLoadedAt = Date.now();

  const form = document.getElementById('subscribe-form') as HTMLFormElement;
  const statusEl = form.querySelector('.form-status') as HTMLParagraphElement;
  const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const nameInput = document.getElementById('name') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const consentInput = document.getElementById('consent') as HTMLInputElement;
  const websiteInput = document.getElementById('website') as HTMLInputElement;

  function setStatus(message: string, kind: 'ok' | 'error' | '') {
    statusEl.textContent = message;
    statusEl.className = 'form-status' + (kind ? ` ${kind}` : '');
  }

  function isValidEmail(value: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setStatus('', '');

    const name = nameInput.value.trim();
    const email = emailInput.value.trim();

    if (name.length < 2) {
      setStatus('Escribe tu nombre.', 'error');
      nameInput.focus();
      return;
    }
    if (!isValidEmail(email)) {
      setStatus('Escribe un correo válido.', 'error');
      emailInput.focus();
      return;
    }
    if (!consentInput.checked) {
      setStatus('Debes aceptar la casilla para suscribirte.', 'error');
      consentInput.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';

    try {
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          consent: consentInput.checked,
          website: websiteInput.value,
          formLoadedAt,
        }),
      });
      const data = await res.json();

      if (res.ok && data.ok) {
        setStatus('Listo — ya estás suscrito.', 'ok');
        form.reset();
      } else {
        setStatus(data.error || 'Algo salió mal, intenta de nuevo.', 'error');
      }
    } catch {
      setStatus('No se pudo conectar. Intenta de nuevo en unos minutos.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Suscribirme';
    }
  });
</script>

<style>
  .deliverables {
    padding: 0 24px 40px;
    max-width: 760px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .deliverable-card {
    border-radius: var(--radius);
    border-top: 2px solid var(--accent);
    padding: 22px 24px 24px;
    background: var(--bg-inset);
  }
  .deliverable-card .eyebrow { color: var(--text-muted); margin: 0; }
  .deliverable-card h2 { font-size: 1.1rem; margin: 8px 0 10px; }
  .deliverable-card p:last-child { color: var(--text-muted); font-size: 0.9rem; line-height: 1.55; margin: 0; }

  @media (max-width: 700px) {
    .deliverables { grid-template-columns: 1fr; }
  }

  .form-wrap { padding: 8px 24px 96px; max-width: 480px; }

  #subscribe-form { display: flex; flex-direction: column; gap: 20px; }
  #subscribe-form button[type='submit'] { justify-content: center; }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
    cursor: pointer;
  }
  .consent input {
    margin-top: 3px;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .benefit { color: var(--text-muted); font-size: 0.9rem; margin-top: 28px; }
</style>
