---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="Suscríbete" description="Análisis crítico de tech e IA, directo a tu inbox. Sin hype, sin spam.">
  <PageHeader
    eyebrow="Únete al flujo"
    title="Análisis crítico de tech e IA, directo a tu inbox."
    dek="Sin hype, sin spam. Cancela cuando quieras, sin drama."
  />

  <section class="container cta-block">
    <a class="btn btn-primary" href="https://tally.so/r/ODazJM" target="_blank" rel="noopener">Suscribirme ahora</a>
    <p class="note">Al suscribirte recibes acceso al Índice GlitchMentalMX mensual y al Manual del Caos Digital — <a href="/gracias/">ver los archivos</a>.</p>
  </section>
</Layout>

<style>
  .cta-block { padding: 0 24px 96px; max-width: 560px; }
  .note { margin-top: 18px; color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; }
</style>
