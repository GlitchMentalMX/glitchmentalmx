---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE, cargarVeredictos, cargarPrecios, type Veredicto } from '../../lib/datos';
import { cargarFichas, edicion as edicionExp, RUTA as RUTA_EXP, AVISO as AVISO_EXP } from '../../lib/exposicion';

const fichasExp = cargarFichas();
const conteoNivel = (n: string) => fichasExp.filter((f) => f.puntuacion.nivel === n).length;

const { filas, resumen, ultimaActualizacion, primeraPublicacion } = await cargarVeredictos();
const precios = await cargarPrecios();

const totalHerramientas = new Set(filas.map((f) => f.herramienta_id)).size;
const pct = (n: number, total: number) => (total === 0 ? 0 : Math.round((n / total) * 100));
const orden: Veredicto[] = ['verde', 'amarillo', 'rojo'];
const emoji: Record<Veredicto, string> = { verde: '🟢', amarillo: '🟡', rojo: '🔴' };

// La frase de cada serie se arma con los conteos reales: nunca se escribe a
// mano una cifra que pueda quedar vieja.
const cuenta = (key: string) => resumen.find((r) => r.serie.key === key)!;
const frases: Record<string, string> = {
  entrena: (() => {
    const r = cuenta('entrena');
    return `${r.conteo.rojo} de ${r.total} herramientas entrenan su IA con lo que haces; ${r.conteo.verde} no lo hacen por defecto.`;
  })(),
  prueba: (() => {
    const r = cuenta('prueba');
    return `Solo ${r.conteo.verde} de ${r.total} dejan probar su plan de pago sin tarjeta.`;
  })(),
  codigos: (() => {
    const r = cuenta('codigos');
    return `Solo ${r.conteo.verde} de ${r.total} tienen hoy un código o promoción activa verificable; en ${r.conteo.rojo} no existe ningún código real.`;
  })(),
  estudiantes: (() => {
    const r = cuenta('estudiantes');
    return `Solo ${r.conteo.verde} de ${r.total} ofertas para estudiantes aplican en México sin trabas.`;
  })(),
};

const hoy = new Date();
// Las fechas de las fichas son medianoche UTC: se formatean en UTC para que el
// día mostrado coincida con el de dateModified aunque el build corra en CDMX.
const actualizado = ultimaActualizacion
  ? ultimaActualizacion.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : '';
const citaFecha = hoy.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Mexico_City' });
const anio = hoy.getFullYear();

const title = 'Datos verificados de IA y servicios digitales en México';
const description =
  'Cuántas herramientas de IA entrenan con tus datos, piden tarjeta en su prueba gratis o tienen códigos reales. Datos abiertos, verificados en fuente oficial.';

const csvVeredictos = `${SITE}/datos/veredictos.csv`;
const csvPrecios = `${SITE}/datos/precios.csv`;

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Datos verificados de IA y servicios digitales en México (glitchMentalMX)',
  description:
    `Veredictos verificados en fuentes oficiales para ${totalHerramientas} herramientas y servicios digitales: si entrenan su IA con los datos del usuario, si su prueba gratis pide tarjeta, si existe un código de descuento real y si su oferta para estudiantes aplica en México. Incluye el precio de entrada de cada ficha en dólares y en pesos mexicanos con el tipo de cambio FIX de Banxico.`,
  url: `${SITE}/datos/`,
  inLanguage: 'es',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  keywords: [
    'inteligencia artificial',
    'privacidad',
    'entrenamiento de IA',
    'prueba gratis',
    'códigos de descuento',
    'descuentos para estudiantes',
    'precios en México',
    'tipo de cambio Banxico',
  ],
  spatialCoverage: { '@type': 'Place', name: 'México' },
  ...(primeraPublicacion && ultimaActualizacion
    ? { temporalCoverage: `${primeraPublicacion.toISOString().slice(0, 10)}/..` }
    : {}),
  ...(ultimaActualizacion ? { dateModified: ultimaActualizacion.toISOString().slice(0, 10) } : {}),
  creator: {
    '@type': 'Person',
    name: 'Jorge A. Diaz Elizondo',
    url: `${SITE}/acerca-de/`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'glitchMentalMX',
    url: SITE,
  },
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/csv',
      name: 'Veredictos por herramienta (CSV)',
      contentUrl: csvVeredictos,
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/csv',
      name: 'Precios de entrada en USD y MXN (CSV)',
      contentUrl: csvPrecios,
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  modifiedTime={ultimaActualizacion}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />
  <Breadcrumbs items={[
    { name: 'IA sin letra chiquita', url: '/ia-sin-letra-chiquita/' },
    { name: 'Datos' },
  ]} />
  <PageHeader
    eyebrow={`Datos abiertos · actualizado el ${actualizado}`}
    title={title}
    dek={`Revisamos en la fuente oficial ${totalHerramientas} herramientas y servicios digitales, uno por uno, y publicamos lo que encontramos: aquí están las cifras, cómo se calculan y los archivos para descargarlas.`}
  />

  <section class="container cifras">
    {resumen.map((r) => (
      <article class="cifra">
        <p class="eyebrow"><a href={r.serie.hub}>{r.serie.label}</a> · {r.total} herramientas</p>
        <h2>{frases[r.serie.key]}</h2>
        <p class="pregunta">{r.serie.pregunta}</p>
        <table>
          <tbody>
            {orden.map((v) => (
              <tr>
                <th scope="row"><span aria-hidden="true">{emoji[v]}</span> {r.serie.significados[v]}</th>
                <td>{r.conteo[v]}</td>
                <td class="pct">{pct(r.conteo[v], r.total)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </article>
    ))}
  </section>

  <section class="container texto">
    <h2>Exposición laboral a la IA</h2>
    <p>El <a href={RUTA_EXP}>Índice de Exposición Laboral a la IA</a> califica {fichasExp.length} ocupaciones en una escala de 0 a 100 (edición {edicionExp.numero}, {edicionExp.etiquetaFecha}): {conteoNivel('Alta')} en exposición alta, {conteoNivel('Moderada')} moderada, {conteoNivel('Baja')} baja y {conteoNivel('Muy baja')} muy baja. {AVISO_EXP} Es una medición editorial de glitchMentalMX con fuentes públicas (O*NET, Anthropic Economic Index y Eloundou et al.), no una estadística oficial.</p>
  </section>

  <section class="container texto">
    <h2>Cómo se verifica</h2>
    <ul>
      <li>Cada dato sale de la fuente oficial de la herramienta (su página de precios, su política de privacidad, su centro de ayuda), consultada por nosotros. Lo que no se puede confirmar ahí no se publica.</li>
      <li>Cada ficha lleva la fecha de su última verificación y se revisa de forma periódica. Los veredictos son un juicio editorial sobre lo que dice la fuente en esa fecha; si la empresa cambia sus condiciones, el veredicto cambia.</li>
      <li>Los precios son el precio oficial en dólares de la página global de cada empresa, antes de impuestos, convertido a pesos con el tipo de cambio FIX de Banxico del día. El precio que ves en tu tienda de apps o con tu tarjeta puede ser distinto.</li>
    </ul>
    <p>Los criterios completos de cada serie están en su página: <a href="/quien-entrena-con-tus-datos/">Quién entrena con tus datos</a>, <a href="/prueba-gratis-sin-tarjeta/">Prueba gratis sin tarjeta</a>, <a href="/codigos-descuento-ia/">Códigos de descuento</a> y <a href="/descuentos-para-estudiantes-ia/">Descuentos para estudiantes</a>.</p>
  </section>

  <section class="container texto">
    <h2>Descargas</h2>
    <p>Tres archivos CSV (se abren en Excel, Google Sheets o cualquier herramienta de datos), generados con las mismas fichas que ves en el sitio:</p>
    <ul class="descargas">
      <li>
        <a href="/datos/veredictos.csv" download>veredictos.csv</a> — {filas.length} filas, una por herramienta y serie. Columnas: serie, herramienta, herramienta_id, veredicto, veredicto_significado, frase_corta, fuente_verificada, publicada, actualizada, url.
      </li>
      <li>
        <a href="/datos/precios.csv" download>precios.csv</a> — {precios.length} filas, una por ficha de precios. Columnas: serie, herramienta_id, plan, empresa, precio_usd, precio_mxn_hoy, periodo, tipo_cambio_fix, fecha_tipo_cambio, url.
      </li>
      <li>
        <a href="/datos/indice-exposicion.csv" download>indice-exposicion.csv</a> — {fichasExp.length} filas, una por ocupación (sin el detalle de actividades). Columnas: edicion, ocupacion, ocupacion_id, sector, puntuacion, nivel, rango_min, rango_max, exposicion_E, automatizacion_A, complementariedad_C, tope_aplicado, confianza, onet, isco08, revision, url.
      </li>
      {/* Laboratorio 01 — descomentar al salir el lote de 3 experimentos (feat/laboratorio).
      <li>
        <a href="/datos/laboratorio-01-brecha-exposicion.csv" download>laboratorio-01-brecha-exposicion.csv</a> — desglose por actividad de 8 ocupaciones (4 pares del mismo sector) del Experimento 01 del <a href="/laboratorio/">Laboratorio</a>, más una fila resumen por ocupación. Columnas: sector, ocupacion, slug, puntuacion_ocupacion, actividad, peso_onet, E_0_4, A_0_4, C_0_4, evidencia.
      </li>
      */}
      {/* Laboratorio 02 — descomentar al salir el lote de 3 experimentos (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-02-mapa-privacidad.csv" download>laboratorio-02-mapa-privacidad.csv</a> — 23 filas, una por herramienta de IA del recomendador, del Experimento 02 del <a href="/laboratorio/">Laboratorio</a>. Columnas: herramienta, slug, tipo_herramienta, categoria_uso, entrena_por_default, permite_opt_out, privacidad_por_plan, valor_recomendador, fecha_verificacion, url_ficha_sitio.
      </li>
      */}
      {/* Laboratorio 03 — descomentar al salir el lote de 3 experimentos (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-03-costo-real-ia.csv" download>laboratorio-03-costo-real-ia.csv</a> — 23 filas, una por herramienta de IA del recomendador, del Experimento 03 del <a href="/laboratorio/">Laboratorio</a>: plan gratuito, tarjeta, límites y primer escalón de pago. Columnas: herramienta, slug, tipo_herramienta, categoria_uso, tiene_plan_gratis, pide_tarjeta_gratis, limite_plan_gratis, precio_primer_plan_usd, precio_mxn_referencia, fecha_verificacion, url_ficha_sitio.
      </li>
      */}
      {/* Laboratorio 04 — descomentar al salir el lote de 3 experimentos (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-04-actividades-intocables.csv" download>laboratorio-04-actividades-intocables.csv</a> — 181 filas del Experimento 04 del <a href="/laboratorio/">Laboratorio</a>: las 160 actividades de las 21 ocupaciones del Índice de Exposición Laboral y una fila resumen por ocupación con el porcentaje de peso en C = 4 y E = 0. Columnas: sector, ocupacion, slug, puntuacion_ocupacion, actividad, peso_onet, E_0_4, A_0_4, C_0_4, evidencia, nota_resumen.
      </li>
      */}
      {/* Laboratorio 05 — descomentar al salir el lote de 3 experimentos (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-05-especialista-vs-generalista.csv" download>laboratorio-05-especialista-vs-generalista.csv</a> — 23 filas, una por herramienta de IA del recomendador, del Experimento 05 del <a href="/laboratorio/">Laboratorio</a>: naturaleza de la salida, primer escalón de pago, entrenamiento por defecto, opt-out en México y cobertura frente a un chat general. Columnas: herramienta, slug, tipo_herramienta, categoria_uso, naturaleza_salida, precio_primer_plan_usd, entrena_por_default, opt_out_mexico, regla_recomendador, ventaja_frente_generalista.
      </li>
      */}
      {/* Laboratorio 06 — descomentar al salir el lote (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-06-ia-fiscal-laboral-mexico.csv" download>laboratorio-06-ia-fiscal-laboral-mexico.csv</a> — 18 filas (3 modelos por 6 casos) del Experimento 06 del <a href="/laboratorio/">Laboratorio</a>: cifra esperada, cifra del modelo, puntaje de 0 a 2, uso de búsqueda web y diagnóstico del error. Columnas: modelo, version_modelo, fecha_ejecucion, caso_id, categoria_legal, cifra_esperada_mxn, cifra_modelo_mxn, puntaje_0_2, uso_busqueda_web, diagnostico_error.
      </li>
      */}
      {/* Laboratorio 07 — descomentar al salir el lote (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-07-citas-enlaces-inventados-2026.csv" download>laboratorio-07-citas-enlaces-inventados-2026.csv</a> — 18 filas (3 modelos por 6 casos) del Experimento 07 del <a href="/laboratorio/">Laboratorio</a>: URLs entregadas, estado HTTP real verificado, cita exacta, puntaje de 0 a 2 y diagnóstico del error. Columnas: modelo, version_modelo, fecha_ejecucion, caso_id, tipo_fuente, url_entregada, http_status_real, cita_exacta, puntaje_0_2, diagnostico_error.
      </li>
      */}
      {/* Laboratorio 08 — descomentar al salir el lote (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-08-letra-chiquita-contratos-mexico.csv" download>laboratorio-08-letra-chiquita-contratos-mexico.csv</a> — 15 filas (3 modelos por 5 contratos) del Experimento 08 del <a href="/laboratorio/">Laboratorio</a>: detección de cada trampa, validez del fundamento legal, puntaje de 0 a 2 y diagnóstico del error. Columnas: modelo, version_modelo, fecha_ejecucion, caso_id, tipo_contrato, trampa_1_detectada, trampa_2_detectada, fundamento_valido, puntaje_0_2, diagnostico_error.
      </li>
      */}
      {/* Laboratorio 09 — descomentar al salir el lote (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-09-humanizar-texto-ia.csv" download>laboratorio-09-humanizar-texto-ia.csv</a> — 15 filas (3 modelos por 5 textos) del Experimento 09 del <a href="/laboratorio/">Laboratorio</a>: extensión, diversidad léxica (TTR), datos duros conservados, muletillas de IA y puntaje de 0 a 2 al pedirle a la IA que un texto suene más humano. Columnas: modelo, version_modelo, fecha_ejecucion, caso_id, categoria, palabras_original, palabras_salida, delta_palabras_pct, ttr_salida, datos_conservados_0_3, muletillas_ia, puntaje_0_2.
      </li>
      */}
      {/* Laboratorio 10 — descomentar al salir el lote (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-10-aduloneria-ia-premisas-falsas.csv" download>laboratorio-10-aduloneria-ia-premisas-falsas.csv</a> — 30 filas (3 modelos por 10 premisas falsas) del Experimento 10 del <a href="/laboratorio/">Laboratorio</a>: si el modelo rechazó la premisa, si empezó con complacencia, puntaje de 0 a 2, veredicto y diagnóstico del error. Columnas: modelo, version_modelo, fecha_ejecucion, premisa_id, categoria, premisa_rechazada, complacencia_inicial, puntaje_0_2, veredicto_corto, diagnostico_error.
      </li>
      */}
      {/* Laboratorio 11 — descomentar al salir el lote (feat/laboratorio). Licencia CC BY 4.0.
      <li>
        <a href="/datos/laboratorio-11-espanol-mexicano-vs-traduccion-robotica.csv" download>laboratorio-11-espanol-mexicano-vs-traduccion-robotica.csv</a> — 45 filas (3 modelos por 15 tareas) del Experimento 11 del <a href="/laboratorio/">Laboratorio</a>: calcos y anglicismos, regionalismos ajenos, cumplimiento del límite de palabras, puntaje de 0 a 2 y diagnóstico por tarea. Columnas: modelo, version_modelo, fecha_ejecucion, tarea_id, bloque, calcos_o_anglicismos, regionalismos_ajenos, cumple_limite_palabras, puntaje_0_2, diagnostico.
      </li>
      */}
    </ul>
  </section>

  <section class="container texto">
    <h2>Licencia y cómo citar</h2>
    <p>Puedes usar, copiar y compartir estos datos, también con fines comerciales, bajo la licencia <a href="https://creativecommons.org/licenses/by/4.0/deed.es" rel="license noopener" target="_blank">Creative Commons Atribución 4.0</a>: solo pide que menciones la fuente. Una forma de citarlo:</p>
    <blockquote class="cita">
      glitchMentalMX ({anio}). <em>{title}</em>. https://glitchmental.com/datos/. Consultado el {citaFecha}.
    </blockquote>
    <p>Los datos los verifica y mantiene <a href="/acerca-de/">Jorge A. Diaz Elizondo</a>. Si ves un dato que ya cambió, avísanos desde el botón que aparece al final de cada ficha.</p>
  </section>
</Layout>

<style>
  .cifras {
    max-width: 760px;
    padding: 0 24px 24px;
    display: grid;
    gap: 20px;
  }
  .cifra {
    border-radius: var(--radius);
    border-top: 2px solid var(--accent);
    padding: 22px 24px 20px;
    background: var(--bg-inset);
  }
  .cifra .eyebrow { margin: 0; color: var(--text-muted); }
  .cifra .eyebrow a { color: inherit; text-decoration: none; }
  .cifra .eyebrow a:hover { color: var(--accent); }
  .cifra h2 { font-size: 1.3rem; line-height: 1.3; margin: 8px 0 6px; }
  .pregunta { color: var(--text-muted); font-size: 0.9rem; margin: 0 0 14px; }

  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  th, td { padding: 8px 0; border-top: 1px solid var(--border); text-align: left; }
  th { font-weight: 400; color: var(--text-muted); }
  td { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; width: 48px; }
  td.pct { color: var(--text-muted); font-weight: 400; width: 56px; }

  .texto { max-width: 760px; padding: 16px 24px 24px; }
  .texto h2 { font-size: 1.3rem; margin: 0 0 12px; }
  .texto p, .texto li { color: var(--text-muted); line-height: 1.6; }
  .texto ul { padding-left: 20px; display: grid; gap: 10px; margin: 0 0 14px; }
  .texto a { color: var(--accent); }
  .descargas { list-style: none; padding-left: 0; }
  .cita {
    margin: 14px 0;
    padding: 14px 18px;
    border-left: 3px solid var(--accent);
    background: var(--bg-inset);
    color: var(--text);
    font-size: 0.92rem;
  }
  .texto:last-of-type { padding-bottom: 96px; }
</style>
