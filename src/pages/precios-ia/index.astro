---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CollectionArticleRow from '../../components/CollectionArticleRow.astro';
import BuscadorPreciosIA from '../../components/BuscadorPreciosIA.astro';
import { getCollection } from 'astro:content';
import tipoCambio from '../../data/tipo-cambio.json';
import { formatDate } from '../../lib/format';

const posts = (await getCollection('preciosIA', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.herramienta.localeCompare(b.data.herramienta, 'es')
);

// Alias cortos para el buscador — solo para los casos donde el nombre real
// cambió o difiere de lo que la gente probablemente teclea. Opcional a
// propósito: la mayoría de las herramientas no necesita ninguno.
const ALIAS: Record<string, string[]> = {
  'cuanto-cuesta-gemini-hoy': ['google gemini'],
  'cuanto-cuesta-notebooklm-hoy': ['gemini notebook'],
  'cuanto-cuesta-copilot-hoy': ['microsoft 365 copilot', 'office copilot'],
};

// {nombre, slug} generado en build-time desde la colección — nunca una
// lista escrita a mano que haya que mantener aparte.
const buscadorItems = posts.map((post) => ({
  nombre: post.data.herramienta,
  slug: post.id,
  alias: ALIAS[post.id],
}));

const title = 'Precios de IA: cuánto cuesta cada herramienta hoy en México';
const description =
  'Cuánto cuesta ChatGPT, Claude, Gemini y el resto de las herramientas de IA hoy en México, en pesos mexicanos, con el tipo de cambio oficial de Banxico actualizado a diario.';
const fechaDato = new Date(`${tipoCambio.fecha}T12:00:00-06:00`);
---

<Layout title={title} description={description}>
  <Breadcrumbs items={[
    { name: 'IA sin letra chiquita', url: '/ia-sin-letra-chiquita/' },
    { name: 'Precios de IA' },
  ]} />
  <section class="container header">
    <p class="eyebrow">Precios de IA · {posts.length} herramientas · dato del {formatDate(fechaDato)}</p>
    <h1>Cuánto cuesta cada herramienta de IA hoy en México</h1>
    <p class="dek">
      El precio oficial en dólares de cada herramienta, convertido a pesos mexicanos con el tipo de
      cambio FIX de Banxico, actualizado a diario. Sin hacer cuentas antes de contratar.
    </p>
  </section>

  <section class="container list">
    <p class="eyebrow list-label">Las herramientas</p>
    <BuscadorPreciosIA items={buscadorItems} />
    {posts.map((post, i) => (
      <CollectionArticleRow
        index={i + 1}
        slug={post.id}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        body={post.body}
      />
    ))}
  </section>
</Layout>

<style>
  .header { padding: 56px 24px 24px; max-width: 760px; }
  .header h1 { font-family: var(--font-display); font-size: clamp(2.1rem, 4.6vw, 3rem); margin: 12px 0 16px; }
  .dek { color: var(--text-muted); font-size: 1.1rem; line-height: 1.55; }

  .list { padding: 24px 24px 96px; max-width: 780px; }
  .list-label { margin-bottom: 6px; }
</style>
