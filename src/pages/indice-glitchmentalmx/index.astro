---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const ranking = [
  { pos: 1, name: 'Agentes de IA autónomos orientados a procesos', pts: 95 },
  { pos: 2, name: 'Plataformas de gobernanza de IA', pts: 93 },
  { pos: 3, name: 'Ciberseguridad con detección basada en comportamiento', pts: 89 },
  { pos: 4, name: 'Sistemas multiagente y orquestación de agentes', pts: 88 },
  { pos: 5, name: 'Automatización operativa inteligente (RPA + AI)', pts: 86 },
  { pos: 6, name: 'Infraestructura de datos y gobernanza para IA generativa', pts: 84 },
  { pos: 7, name: 'Observabilidad y AIOps cloud', pts: 82 },
  { pos: 8, name: 'Modelos de lenguaje especializados por industria', pts: 80 },
  { pos: 9, name: 'Copilots empresariales integrados', pts: 78 },
  { pos: 10, name: 'FinOps y optimización de costos cloud', pts: 77 },
  { pos: 11, name: 'Vector databases y retrieval systems', pts: 76 },
  { pos: 12, name: 'Infraestructura GPU cloud especializada', pts: 75 },
  { pos: 13, name: 'Plataformas de fine-tuning y evaluación de modelos', pts: 74 },
  { pos: 14, name: 'Analítica predictiva aplicada a supply chain', pts: 73 },
  { pos: 15, name: 'Edge AI empresarial', pts: 71 },
  { pos: 16, name: 'Digital twins industriales', pts: 70 },
  { pos: 17, name: 'Plataformas low-code con IA', pts: 69 },
  { pos: 18, name: 'Voice AI empresarial', pts: 67 },
  { pos: 19, name: 'Herramientas de generación de contenido automatizado', pts: 61 },
  { pos: 20, name: 'Startups de AI wrappers sin diferenciación técnica', pts: 53 },
];

const archive = [
  { label: 'Agosto 2026', href: 'https://drive.google.com/file/d/1qJlPltrp1rgbl7FWZpV7zJeVbSVLbT6K/view?usp=sharing', isNew: true },
  { label: 'Julio 2026', href: 'https://drive.google.com/file/d/1ErtgNPHWrne1lOWVuOTiYQoYdhbD5_Tn/view?usp=sharing' },
  { label: 'Junio 2026', href: 'https://drive.google.com/file/d/1Mz0wSSvVgbTmQ446iIdOHbB1jtsmdQ1e/view?usp=sharing' },
  { label: 'Mayo 2026', href: 'https://drive.google.com/file/d/1u77SnHO5NypzpN4qON4PfHxUbk_IMSqp/view?usp=sharing' },
  { label: 'Abril 2026', href: 'https://drive.google.com/file/d/15kVXZyhDkDxFNvEeAxKhv1fexb20WUyu/view?usp=sharing' },
  { label: 'Marzo 2026', href: 'https://drive.google.com/file/d/1hTDT8Tzou_0qbsvsG8w_GWerh9UWhjHX/view?usp=sharing' },
  { label: 'Febrero 2026', href: 'https://drive.google.com/file/d/1Gq2KKYxymrJW1Tkw0V67BtfNjxcg-6_Y/view?usp=sharing' },
  { label: 'Enero 2026', href: 'https://drive.google.com/file/d/16_ufNH4PEcsmpRFr2uChdvrb12WwPS3U/view?usp=sharing' },
];
---

<Layout
  title="Índice GlitchMentalMX"
  description="20 tecnologías B2B rankeadas por adopción real, integración operativa y señales públicas verificables. Sin patrocinadores, sin agenda."
>
  <PageHeader
    eyebrow="Índice GlitchMentalMX · Agosto 2026"
    title="20 tecnologías B2B, rankeadas sin patrocinadores."
    dek="Adopción real, integración operativa y señales públicas verificables. Un ranking mensual — no un listado promocional."
  />

  <section class="container table-wrap">
    <table class="ranking">
      <thead>
        <tr><th>#</th><th>Tecnología / Herramienta</th><th>Pts</th></tr>
      </thead>
      <tbody>
        {ranking.map((r) => (
          <tr>
            <td class="pos">{r.pos}</td>
            <td>{r.name}</td>
            <td class="pts">{r.pts}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="container archive">
    <h2>Archivo mensual completo</h2>
    <p class="sub">Cada reporte incluye el ranking completo y el análisis detrás de los movimientos del mes, en PDF.</p>
    <ul class="file-list">
      {archive.map((f) => (
        <li>
          <a href={f.href} target="_blank" rel="noopener">
            <span>{f.label}{f.isNew && <span class="tag new">Nuevo</span>}</span>
            <span class="dl">Descargar ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container cta">
    <p>Recibe el índice cada mes en tu correo.</p>
    <a class="btn btn-primary" href="/suscribete/">Suscríbete</a>
  </section>
</Layout>

<style>
  .table-wrap { padding: 8px 24px 8px; overflow-x: auto; }
  table.ranking { width: 100%; border-collapse: collapse; max-width: 820px; }
  table.ranking th, table.ranking td {
    text-align: left;
    padding: 12px 10px;
    border-bottom: 1px solid var(--border);
    font-size: 0.94rem;
  }
  table.ranking th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .pos { font-family: var(--font-mono); color: var(--text-faint); width: 36px; }
  .pts { font-family: var(--font-mono); color: var(--accent); text-align: right; width: 50px; }

  .archive { padding: 40px 24px 8px; max-width: 760px; }
  .archive h2 { font-size: 1.3rem; }
  .sub { color: var(--text-muted); margin: 6px 0 20px; }
  .file-list { list-style: none; margin: 0; padding: 0; }
  .file-list li { border-bottom: 1px solid var(--border); }
  .file-list a { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 4px; color: var(--text); }
  .file-list a:hover { color: var(--accent); }
  .dl { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-faint); flex-shrink: 0; }

  .cta { padding: 40px 24px 96px; display: flex; align-items: center; gap: 18px; }
  .cta p { color: var(--text-muted); margin: 0; }
</style>
