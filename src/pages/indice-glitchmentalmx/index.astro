---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { indiceRanking as ranking } from '../../data/indice-ranking';
---

<Layout
  title="Índice GlitchMentalMX"
  description="20 tecnologías B2B rankeadas por adopción real, integración operativa y señales públicas verificables. Sin patrocinadores, sin agenda."
>
  <PageHeader
    eyebrow="Índice GlitchMentalMX · Agosto 2026"
    title="20 tecnologías B2B, rankeadas sin patrocinadores."
    dek="Adopción real, integración operativa y señales públicas verificables. Un ranking mensual — no un listado promocional."
  />

  <section class="container table-wrap">
    <table class="ranking">
      <thead>
        <tr><th>#</th><th>Tecnología / Herramienta</th><th>Pts</th></tr>
      </thead>
      <tbody>
        {ranking.map((r) => (
          <tr>
            <td class="pos">{r.pos}</td>
            <td>{r.name}</td>
            <td class="pts">{r.pts}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="container cta">
    <div>
      <p class="cta-title">El reporte completo en PDF, cada mes, por correo.</p>
      <p class="cta-sub">El ranking a fondo y el análisis detrás de los movimientos del mes — exclusivo para suscriptores.</p>
    </div>
    <a class="btn btn-primary" href="/suscribete/">Suscríbete</a>
  </section>
</Layout>

<style>
  .table-wrap { padding: 8px 24px 8px; overflow-x: auto; }
  table.ranking { width: 100%; border-collapse: collapse; max-width: 820px; }
  table.ranking th, table.ranking td {
    text-align: left;
    padding: 12px 10px;
    border-bottom: 1px solid var(--border);
    font-size: 0.94rem;
  }
  table.ranking th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .pos { font-family: var(--font-mono); color: var(--text-faint); width: 36px; }
  .pts { font-family: var(--font-mono); color: var(--accent); text-align: right; width: 50px; }

  .cta {
    margin: 48px 24px 96px;
    max-width: 820px;
    padding: 28px 32px;
    background: var(--bg-inset);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .cta-title { font-weight: 700; font-size: 1.05rem; margin: 0 0 4px; }
  .cta-sub { color: var(--text-muted); font-size: 0.9rem; margin: 0; max-width: 46ch; }
</style>
