---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getEntry, getCollection } from 'astro:content';
import { parseMesEs } from '../../lib/format';

const entry = await getEntry('indiceGlitchmentalmx', 'actual');
const { mes, ranking, destacados, sube, baja, insight } = entry!.data;
const maxPts = Math.max(...ranking.map((r) => r.pts));
const lastUpdated = parseMesEs(mes);

const title = `Índice glitchMentalMX: ranking de adopción real de IA B2B (${mes})`;
const description = `20 tecnologías B2B rankeadas por adopción real e integración operativa, con fuentes verificables. Sin patrocinadores, sin agenda. Actualizado en ${mes}.`;
const toolImage = '/images/posts/el-indice-que-separa-la-ia-real-del-humo-tecnologico/hero.jpg';

// Lote evergreen sobre adopción/autonomía de IA — deliberadamente NO atado a
// los nombres exactos de las categorías del ranking de este mes (esos
// cambian cada vez que se reemplaza actual.json), para no quedar obsoleto
// cuando el índice se actualice el próximo mes.
const RELATED_SLUGS = [
  'agentes-de-ia-en-tu-trabajo-el-salto-del-5-al-40-en-2026',
  'de-asistente-a-agente-como-cambio-el-lenguaje-de-la-ia',
  'un-agente-de-ia-borro-la-base-de-datos-en-9-segundos',
  'automatizacion-y-autonomia-no-son-lo-mismo-confundirlas-tiene-consecuencias',
  'stanford-ai-index-2026-la-paridad-que-eeuu-no-quiere-ver',
  'el-papel-de-big-tech-en-decidir-que-tecnologia-viene',
];
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const relatedPosts = RELATED_SLUGS.map((slug) => allPosts.find((p) => p.id === slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p)
);

// ItemList generado directo del ranking — sobrevive el reemplazo mensual de
// actual.json sin mantenimiento aparte, a diferencia de un schema escrito a
// mano que quedaría desincronizado en cuanto cambie el top 20.
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Índice glitchMentalMX — ${mes}`,
  description,
  numberOfItems: ranking.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: ranking.map((r) => ({
    '@type': 'ListItem',
    position: r.pos,
    name: r.nombre,
  })),
};
---

<Layout
  title={title}
  description={description}
  image={toolImage}
  modifiedTime={lastUpdated}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  locale="es_MX"
  titleSuffix={false}
>
  <Breadcrumbs items={[{ name: 'Índice glitchMentalMX' }]} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <section class="container hero">
    <p class="eyebrow">Ranking B2B — Actualización mensual</p>
    <h1>El índice que separa<br /><span class="accent">el hype del impacto real.</span></h1>
    <p class="dek">
      20 tecnologías B2B rankeadas por adopción real, integración operativa y señales públicas verificables. Sin
      patrocinadores, sin agenda.
    </p>
    <details class="methodology">
      <summary>+ Metodología</summary>
      <p>
        El Índice glitchMentalMX se basa exclusivamente en señales públicas verificables: cobertura especializada,
        documentación oficial, casos de uso, actividad técnica visible y tendencias sostenidas. Las fuentes de
        referencia incluyen reportes de Gartner, McKinsey e IDC, entre otras. Cada posición refleja adopción real e
        integración operativa en el mercado B2B.
      </p>
    </details>
  </section>

  <section class="container">
    <p class="month-label">Mes actual</p>
    <h2 class="month-title">— {mes}</h2>

    <h3 class="section-label">Ranking general</h3>
    <div class="table-wrap">
      <table class="ranking">
        <thead>
          <tr><th>#</th><th>Tecnología / Herramienta</th><th>Pts</th></tr>
        </thead>
        <tbody>
          {ranking.map((r) => (
            <tr class:list={{ top: r.pos === 1 }}>
              <td class="pos">{r.pos}</td>
              <td class="name">{r.nombre}</td>
              <td class="pts-cell">
                <span class="bar-track"><span class="bar-fill" style={`width:${(r.pts / maxPts) * 100}%`}></span></span>
                <span class="pts">{r.pts}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container cta">
    <div>
      <p class="cta-title">La versión ejecutiva en PDF, cada mes, por correo.</p>
      <p class="cta-sub">El ranking a fondo y el análisis detrás de los movimientos del mes — exclusivo para suscriptores. El historial completo, con todos los meses anteriores, también vive ahí.</p>
    </div>
    <a class="btn btn-primary" href="/suscribete/">Quiero la versión ejecutiva</a>
  </section>

  <section class="container">
    <h3 class="section-label destacados-label">Destacados del Top 5</h3>
    <div class="destacados">
      {destacados.map((d) => (
        <div class="destacado" class:list={{ top: d.pos === 1 }}>
          <div class="num">{d.pos}</div>
          <div>
            <h4 class="destacado-name">{d.nombre}</h4>
            <p class="destacado-text">{d.texto}</p>
          </div>
        </div>
      ))}
    </div>

    <h3 class="section-label">Qué sube / qué baja vs. mes anterior</h3>
    <div class="movers">
      <div class="mover up">
        <p class="mover-label">↑ Sube</p>
        <p>{sube}</p>
      </div>
      <div class="mover down">
        <p class="mover-label">↓ Baja</p>
        <p>{baja}</p>
      </div>
    </div>

    <h3 class="section-label">Insight editorial del mes</h3>
    <div class="insight">
      <p>{insight}</p>
    </div>
  </section>

  <section class="container related">
    <p class="eyebrow">Contexto y lecturas relacionadas</p>
    <h2>Cómo llegamos hasta aquí</h2>
    <div class="related-grid">
      {relatedPosts.map((post) => (
        <ArticleCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          heroImage={post.data.heroImage}
          heroImageAlt={post.data.heroImageAlt}
          body={post.body}
          variant="grid"
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 56px 24px 8px; max-width: 720px; margin-left: auto; margin-right: auto; }
  .hero .eyebrow { color: var(--accent); }
  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.2;
    margin: 14px 0 16px;
  }
  .hero h1 .accent { color: var(--accent); }
  .hero .dek { color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin: 0 0 18px; max-width: 60ch; }

  .methodology summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .methodology summary::-webkit-details-marker { display: none; }
  .methodology p {
    background: var(--bg-inset);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.6;
    margin-top: 10px;
    max-width: 580px;
    padding: 14px 16px;
  }

  .month-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 40px auto 4px;
    max-width: 820px;
  }
  .month-title { font-size: 1.4rem; margin: 0 auto 28px; max-width: 820px; }

  .section-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 auto 14px;
    max-width: 820px;
  }
  .destacados-label { margin-top: 40px; }

  .table-wrap { overflow-x: auto; margin: 0 auto 12px; max-width: 820px; }
  table.ranking { width: 100%; border-collapse: collapse; max-width: 820px; }
  table.ranking th {
    text-align: left;
    padding: 8px 10px;
    background: var(--bg-inset);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  table.ranking th:first-child { width: 36px; text-align: center; }
  table.ranking th:last-child { width: 130px; text-align: right; }
  table.ranking td {
    padding: 9px 10px;
    border-bottom: 1px solid var(--border);
    font-size: 0.92rem;
  }
  table.ranking tr.top td { font-weight: 600; }
  table.ranking tr.top { background: var(--accent-soft); }
  .pos { font-family: var(--font-mono); color: var(--text-faint); text-align: center; width: 36px; }
  tr.top .pos { color: var(--accent); font-weight: 700; }
  .pts-cell { display: flex; align-items: center; gap: 8px; justify-content: flex-end; }
  .bar-track { width: 56px; height: 3px; border-radius: 2px; background: var(--border); overflow: hidden; }
  .bar-fill { display: block; height: 100%; background: var(--accent); border-radius: 2px; }
  .pts { font-family: var(--font-mono); color: var(--accent); font-weight: 700; font-size: 0.86rem; width: 24px; text-align: right; }

  .destacados { max-width: 820px; margin: 0 auto 8px; }
  .destacado {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .destacado:last-child { border-bottom: none; }
  .destacado .num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    min-width: 32px;
    color: var(--text-faint);
  }
  .destacado.top .num { color: var(--accent); }
  .destacado-name { font-weight: 700; font-size: 0.95rem; line-height: 1.3; margin: 0 0 6px; }
  .destacado-text { color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin: 0; }

  .movers { max-width: 820px; display: flex; flex-direction: column; gap: 10px; margin: 0 auto 8px; }
  .mover {
    border-radius: 0 8px 8px 0;
    padding: 14px 16px;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text);
  }
  .mover p:last-child { margin: 0; }
  .mover-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  .mover.up { background: var(--up-bg); border-left: 3px solid var(--up-line); }
  .mover.up .mover-label { color: var(--up-line); }
  .mover.down { background: var(--down-bg); border-left: 3px solid var(--down-line); }
  .mover.down .mover-label { color: var(--down-line); }

  .insight {
    max-width: 820px;
    display: flex;
    margin: 0 auto 8px;
  }
  .insight { border-left: 4px solid var(--accent); border-radius: 0 8px 8px 0; background: var(--accent-soft); }
  .insight p { padding: 16px 18px; margin: 0; font-size: 0.94rem; line-height: 1.65; color: var(--text); }

  .archive-note { max-width: 820px; color: var(--text-faint); font-size: 0.84rem; margin: 32px auto 0; }

  .cta {
    margin: 40px auto 48px;
    max-width: 820px;
    padding: 28px 32px;
    background: var(--bg-inset);
    border-radius: var(--radius);
    border-top: 2px solid var(--accent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .cta-title { font-weight: 700; font-size: 1.05rem; margin: 0 0 4px; }
  .cta-sub { color: var(--text-muted); font-size: 0.9rem; margin: 0; max-width: 46ch; }

  .related { padding: 24px 24px 72px; max-width: 900px; margin: 0 auto; }
  .related h2 { font-family: var(--font-display); font-size: 1.7rem; margin: 8px 0 28px; }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }
</style>
