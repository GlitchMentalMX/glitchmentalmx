---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(posts, { pageSize: 24 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title="Archivo" description="Todos los artículos de glitchmentalMX, en orden cronológico.">
  <section class="container header">
    <p class="eyebrow">Archivo</p>
    <h1>Todos los artículos</h1>
    <p class="sub">{page.total} artículos publicados desde noviembre de 2025.</p>
  </section>

  <section class="container grid">
    {page.data.map((post) => (
      <ArticleCard
        slug={post.id}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        heroImage={post.data.heroImage}
        heroImageAlt={post.data.heroImageAlt}
        body={post.body}
        variant="grid"
      />
    ))}
  </section>

  <nav class="container pager" aria-label="Paginación">
    {page.url.prev ? <a href={page.url.prev} class="btn btn-ghost">← Más recientes</a> : <span />}
    <span class="eyebrow">Página {page.currentPage} de {page.lastPage}</span>
    {page.url.next ? <a href={page.url.next} class="btn btn-ghost">Más antiguos →</a> : <span />}
  </nav>
</Layout>

<style>
  .header { padding: 56px 24px 32px; max-width: 700px; }
  .header h1 { font-size: clamp(2rem, 4vw, 2.6rem); margin: 12px 0 10px; }
  .sub { color: var(--text-muted); }

  .grid {
    padding: 20px 24px 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }

  .pager {
    padding: 32px 24px 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
</style>
