---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ReportarDato from '../../components/ReportarDato.astro';
import { render } from 'astro:content';
import { existsSync } from 'node:fs';
import { formatDate, readingTime } from '../../lib/format';
import { cargarLaboratorio, RUTA_LABORATORIO } from '../../lib/laboratorio';

export async function getStaticPaths() {
  const piezas = await cargarLaboratorio();
  return piezas.map((pieza) => ({ params: { slug: pieza.id }, props: { pieza } }));
}

const { pieza } = Astro.props;
const { Content } = await render(pieza);
const { title, seoTitle, description, kicker, pubDate, updatedDate, heroImage, heroImageAlt, draft, nota, roles, csv } = pieza.data;
const tituloCorto = seoTitle ?? title;

const url = new URL(`${RUTA_LABORATORIO}${pieza.id}/`, Astro.site).toString();
const minutos = readingTime(pieza.body || '');
// La imagen solo viaja a og:image/JSON-LD cuando la pieza ya está publicada:
// mientras draft sea true el archivo todavía puede no existir.
const imagen = !draft && heroImage ? heroImage : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: tituloCorto,
  ...(seoTitle ? { alternativeHeadline: title } : {}),
  description,
  url,
  ...(imagen ? { image: new URL(imagen, Astro.site).toString() } : {}),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    '@id': new URL('/#jorge', Astro.site).toString(),
    name: 'Jorge A. Diaz Elizondo',
    url: new URL('/acerca-de/', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).toString(),
    name: 'glitchMentalMX',
    url: Astro.site?.toString(),
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).toString(), width: 180, height: 180 },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isPartOf: { '@type': 'WebSite', name: 'glitchMentalMX', url: Astro.site?.toString() },
  articleSection: 'Laboratorio',
  ...(csv ? { isBasedOn: { '@type': 'Dataset', '@id': `${url}#dataset` } } : {}),
  about: [{ '@type': 'Thing', name: 'Laboratorio' }],
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'meta[name="description"]'],
  },
};

// Dataset del experimento: cada pieza publica su CSV bajo CC BY 4.0 (y, en los
// experimentos 06 a 11, el texto íntegro de las respuestas de los modelos).
// Se declara como Dataset para que buscadores y asistentes de IA lo reconozcan
// como datos abiertos reutilizables y no solo como un artículo con un enlace.
const absoluto = (ruta: string) => new URL(ruta, Astro.site).toString();
const rutaRespuestas = csv ? csv.replace(/\.csv$/, '-respuestas.md') : undefined;
const hayRespuestas = rutaRespuestas ? existsSync(`${process.cwd()}/public${rutaRespuestas}`) : false;
const datasetSchema = csv
  ? {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      '@id': `${url}#dataset`,
      name: `Datos del experimento: ${tituloCorto}`,
      description,
      url,
      inLanguage: 'es',
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      spatialCoverage: { '@type': 'Place', name: 'México' },
      datePublished: pubDate.toISOString().slice(0, 10),
      dateModified: (updatedDate ?? pubDate).toISOString().slice(0, 10),
      creator: { '@type': 'Person', '@id': absoluto('/#jorge'), name: 'Jorge A. Diaz Elizondo', url: absoluto('/acerca-de/') },
      publisher: { '@type': 'Organization', '@id': absoluto('/#organization'), name: 'glitchMentalMX', url: Astro.site?.toString() },
      isPartOf: { '@type': 'CollectionPage', name: 'Laboratorio de glitchMentalMX', url: absoluto(RUTA_LABORATORIO) },
      citation: absoluto(`${RUTA_LABORATORIO}metodologia/`),
      distribution: [
        { '@type': 'DataDownload', encodingFormat: 'text/csv', name: 'Resultados del experimento (CSV)', contentUrl: absoluto(csv) },
        ...(hayRespuestas && rutaRespuestas
          ? [{ '@type': 'DataDownload', encodingFormat: 'text/markdown', name: 'Respuestas íntegras de cada modelo (Markdown)', contentUrl: absoluto(rutaRespuestas) }]
          : []),
      ],
    }
  : undefined;
---

<Layout
  title={tituloCorto}
  description={description}
  image={imagen}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  hideFooterCta
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {datasetSchema && <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />}
  <Breadcrumbs items={[
    { name: 'Laboratorio', url: RUTA_LABORATORIO },
    { name: title },
  ]} />

  <article class="post">
    <header class="post-header container">
      {draft && <p class="borrador-aviso" role="note">Borrador: esta pieza no está publicada. Solo es visible en local o en un build de revisión.</p>}
      <p class="kicker">{kicker}</p>
      <p class="eyebrow">
        Por <a href="/acerca-de/" class="byline-link" rel="author">Jorge A. Diaz Elizondo</a> · {formatDate(pubDate)} · {minutos} min de lectura{updatedDate ? ` · Actualizado el ${formatDate(updatedDate)}` : ''}
      </p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
    </header>

    {heroImage && (
      <figure class="hero container">
        <img src={heroImage} alt={heroImageAlt ?? ''} width="1672" height="941" fetchpriority="high" />
      </figure>
    )}


    {nota && (
      <aside class="transparencia container" aria-label="Nota de transparencia">
        <p>
          <strong>Nota de transparencia:</strong>{' '}
          {nota === 'modelos'
            ? 'los tres modelos probados también participaron en este experimento.'
            : 'este experimento no prueba modelos: parte de datos del propio sitio, compilados con ayuda de modelos de IA.'}
          {roles ? ` ${roles}` : ''} No hubo evaluador humano independiente.{' '}
          {nota === 'modelos'
            ? 'Por eso los puntajes describen esta muestra y no son un ranking general de los modelos. El CSV trae cada fila y su diagnóstico para que rehagas la cuenta.'
            : 'Por eso las cifras describen esta muestra, no el mercado ni el empleo nacional. El CSV trae cada fila para que rehagas la cuenta.'}{' '}
          <a href="/laboratorio/metodologia/">Cómo hacemos todos los experimentos →</a>
        </p>
      </aside>
    )}

    <div class="content container">
      <div class="prose">
        <Content />
      </div>
    </div>

    <ReportarDato titulo={title} pagina={`${RUTA_LABORATORIO}${pieza.id}/`} />
  </article>
</Layout>

<style>
  .post-header { max-width: 760px; padding: 48px 24px 32px; }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .byline-link { color: var(--text-muted); text-decoration: underline; text-underline-offset: 2px; }
  .byline-link:hover { color: var(--accent); }
  .post-header h1 { font-size: clamp(1.9rem, 4.6vw, 2.9rem); margin: 14px 0 18px; }
  .dek { font-size: 1.15rem; color: var(--text-muted); line-height: 1.5; }
  .borrador-aviso {
    margin: 0 0 20px;
    padding: 10px 14px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-inset);
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .hero { max-width: 760px; margin: 0 auto; padding: 0 24px 28px; }
  .hero img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); }
  .transparencia { max-width: 760px; margin: 0 auto; padding: 0 24px 28px; }
  .transparencia p {
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--bg-inset);
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .transparencia strong { color: var(--text); }
  .transparencia a { color: var(--accent); }
  .content { padding: 0 24px 40px; display: flex; flex-direction: column; align-items: center; }
  .prose :global(caption) {
    caption-side: top;
    text-align: left;
    color: var(--text-muted);
    font-size: 0.85rem;
    padding-bottom: 8px;
  }
  .prose :global(thead th) { background: var(--bg-inset); }
</style>
