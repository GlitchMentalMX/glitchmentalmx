---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import { formatDate } from '../../lib/format';
import { cargarLaboratorio, BAJADA_LABORATORIO, RUTA_LABORATORIO } from '../../lib/laboratorio';

const piezas = (await cargarLaboratorio()).slice().reverse(); // más reciente primero

const title = 'Laboratorio';
const description = BAJADA_LABORATORIO;
---

<Layout
  title={title}
  description={description}
  image="/images/laboratorio/landing/og.jpg"
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <Breadcrumbs items={[{ name: 'Laboratorio' }]} />
  <PageHeader eyebrow="Datos abiertos · CC BY 4.0" title={title} dek={BAJADA_LABORATORIO} />

  <figure class="container emblema">
    <img src="/images/laboratorio/landing/hero.webp" alt="Banco de laboratorio con una campana de cristal que guarda una red luminosa de filamentos ámbar y turquesa, rodeada de un microscopio, una balanza, una brújula con imán, un matraz, viales y un calibrador." width="1672" height="941" fetchpriority="high" />
  </figure>

  <section class="container lista">
    {piezas.length === 0 ? (
      <p class="vacio">Todavía no hay experimentos publicados.</p>
    ) : (
      <ol>
        {piezas.map((p) => (
          <li>
            <article>
              {p.data.heroImage && (
                <a href={`${RUTA_LABORATORIO}${p.id}/`} class="thumb" tabindex="-1" aria-hidden="true">
                  <img src={p.data.heroImage} alt="" width="1672" height="941" loading="lazy" />
                </a>
              )}
              <p class="kicker">{p.data.kicker}{p.data.draft ? ' · borrador' : ''}</p>
              <h2><a href={`${RUTA_LABORATORIO}${p.id}/`}>{p.data.title}</a></h2>
              <p class="resumen">{p.data.description}</p>
              <p class="fecha">{formatDate(p.data.pubDate)}</p>
            </article>
          </li>
        ))}
      </ol>
    )}
  </section>
</Layout>

<style>
  /* Contenedor editorial del sitio (--container); el grid se ajusta solo. */
  .emblema { margin: 0 auto; padding: 0 24px 40px; }
  .emblema img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); }
  .lista { padding: 0 24px 96px; }
  ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media (min-width: 768px) {
    ol { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 36px; }
  }
  li { display: flex; border-top: 1px solid var(--border); padding-top: 22px; }
  /* La tarjeta ocupa toda la celda: la fecha baja al pie para que las filas
     queden alineadas aunque los titulares tengan distinta longitud. */
  article { display: flex; flex-direction: column; width: 100%; }
  .thumb { display: block; margin: 0 0 14px; }
  .thumb img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
  }
  h2 { font-size: 1.25rem; line-height: 1.3; margin: 0 0 8px; }
  h2 a { color: var(--text); text-decoration: none; }
  h2 a:hover { color: var(--accent); }
  .resumen {
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0 0 12px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fecha { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-faint); margin: auto 0 0; }
  .vacio { color: var(--text-muted); }
</style>
