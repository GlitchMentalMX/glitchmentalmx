---
import Layout from '../../layouts/Layout.astro';

const GCSE_CX = 'a28d59cfd89f948f4';
---

<Layout
  title="GlitchSearch"
  description="Curamos la web antes que tú la leas. Búsqueda con veredicto de IA incluido."
>
  <main class="wrap container">
    <p class="eyebrow kicker">GlitchSearch</p>
    <p class="lead">Curamos la web <span class="accent">antes que tú la leas.</span></p>

    <div class="search">
      <input autocomplete="off" id="q" spellcheck="false" type="text" placeholder="Busca en tecnología, IA y cultura digital" />
      <button id="clearBtn" type="button" aria-label="Limpiar">×</button>
      <span class="search-ai-badge">✨ AI</span>
      <button aria-label="Buscar" id="go">
        <svg class="arrow" viewBox="0 0 24 24">
          <path d="M6 12 L18 12 M13 7 L18 12 L13 17" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" stroke="currentColor"></path>
        </svg>
      </button>
    </div>

    <p class="results-note" id="resultsNote" style="display: none;">El 90% de la gente nunca pasa de los primeros 10 resultados. ¿Para qué mostrarte más? Sería pura vanidad.</p>

    <div id="aiVerdict" class="ai-verdict" style="display:none;">
      <div class="ai-verdict-row">
        <span class="ai-verdict-label">🤖 EL VEREDICTO SIN RODEOS</span>
        <span class="ai-badge">✨ AI Powered</span>
      </div>
      <p id="aiVerdictText"></p>
    </div>

    <div id="officialSite" class="official-site" style="display:none;">
      <span class="official-label">🔗 SITIO OFICIAL</span>
      <a id="officialSiteLink" href="#" target="_blank" rel="noopener"></a>
    </div>

    <section id="results"></section>

    <div style="display: none;">
      <div class="gcse-searchresults-only"></div>
    </div>

    <div class="badges">
      <span>✓ Gratis</span><span>•</span><span>🔒 Privado</span><span>•</span><span>🚫 Sin ads</span><span>•</span><span>🎯 Curado</span>
    </div>
  </main>
</Layout>

<script define:vars={{ GCSE_CX }}>
  var currentRequestId = 0;

  window.__gcse = window.__gcse || {};
  window.__gcse.searchCallbacks = {
    web: {
      ready: function (gname, query, promos, results, resultsDiv) {
        if (resultsDiv) resultsDiv.style.display = 'none';
        currentRequestId++;
        var requestId = currentRequestId;
        glitchSearchOnResults(gname, query, results);
        fetchOwnSiteResult(lastQuery, requestId);
        fetchAiSignals(lastQuery, lastResults, requestId);
      },
      starting: function () {},
    },
  };

  (function () {
    var s = document.createElement('script');
    s.src = 'https://cse.google.com/cse.js?cx=' + GCSE_CX;
    s.async = true;
    document.head.appendChild(s);
  })();

  var lastResults = [];
  var lastQuery = '';

  var GEMINI_WORKER_URL = 'https://glitchsearch-gemini-proxy.glitchmental-web.workers.dev/';
  var GEMINI_MODELS = ['gemini-flash-latest', 'gemini-2.5-flash', 'gemini-2.5-flash-lite'];
  var GROQ_WORKER_URL = 'https://glitchsearch-groq-proxy.glitchmental-web.workers.dev/';

  // Veredicto + sitio oficial fusionados en UNA sola llamada de IA (antes
  // eran 2 peticiones concurrentes al mismo Worker, lo que causaba una
  // carrera intermitente — "Failed to fetch" — cuando ambas salían en el
  // mismo instante justo al terminar de renderizar Google. Al pedir ambos
  // datos en un solo JSON, solo queda 1 llamada al Worker por búsqueda.
  function fetchAiSignals(query, results, requestId) {
    var verdictBox = document.getElementById('aiVerdict');
    var verdictText = document.getElementById('aiVerdictText');
    var officialBox = document.getElementById('officialSite');
    var officialLink = document.getElementById('officialSiteLink');

    verdictBox.style.display = 'none';
    verdictBox.className = 'ai-verdict';
    verdictText.textContent = '';
    officialBox.style.display = 'none';
    if (!results || results.length === 0) return;

    var snippets = results
      .slice(0, 5)
      .map(function (r) {
        return (r.titleNoFormatting || r.title || '') + ': ' + (r.contentNoFormatting || r.content || '');
      })
      .join('\n');

    var prompt =
      'Eres GlitchMentalMX: tono ácido, directo, sin hype, pero SIEMPRE constructivo y ' +
      'nunca oscuro, violento u ofensivo. Evita por completo cualquier referencia a violencia, ' +
      'tragedias, terrorismo, religión o política sensible, incluso si aparece de forma tangencial ' +
      'en los resultados — enfócate solo en el ángulo tecnológico o de producto.\n\n' +
      'Alguien buscó "' + query + '" y estos son los resultados encontrados:\n\n' + snippets +
      '\n\nResponde ÚNICAMENTE con un objeto JSON, sin texto fuera de él ni bloques de código, ' +
      'con exactamente estas dos claves:\n' +
      '{"veredicto": "una sola frase (máximo 150 caracteres) sintetizando lo que realmente importa ' +
      'de estos resultados, en español, tono ácido pero responsable, sin saludos ni preámbulo, sin ' +
      'markdown ni asteriscos", "dominio": "si la búsqueda es el nombre de una marca, empresa, ' +
      'producto o herramienta específica y conocida, su dominio oficial exacto (ejemplo: nike.com); ' +
      'si es un tema general o no corresponde a una marca específica, la palabra NONE"}';

    function applyResult(rawText) {
      if (requestId !== currentRequestId) return;
      var parsed;
      try {
        var cleaned = rawText.trim().replace(/^```json/i, '').replace(/^```/, '').replace(/```$/, '').trim();
        parsed = JSON.parse(cleaned);
      } catch (e) {
        return false;
      }

      var applied = false;
      if (parsed.veredicto) {
        verdictText.textContent = String(parsed.veredicto).trim();
        verdictBox.className = 'ai-verdict ready';
        verdictBox.style.display = 'block';
        applied = true;
      }
      if (parsed.dominio) {
        var text = String(parsed.dominio).trim().replace(/^https?:\/\//, '').replace(/\/$/, '').replace(/["'.]+$/, '');
        var domainPattern = /^[a-z0-9-]+(\.[a-z0-9-]+)+$/i;
        if (text.toUpperCase() !== 'NONE' && domainPattern.test(text)) {
          officialLink.href = 'https://' + text;
          officialLink.textContent = text + ' ↗';
          officialBox.style.display = 'flex';
        }
        applied = true;
      }
      return applied;
    }

    function tryModel(modelIndex) {
      if (modelIndex >= GEMINI_MODELS.length) {
        fetchViaGroq();
        return;
      }
      fetch(GEMINI_WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: GEMINI_MODELS[modelIndex],
          contents: [{ parts: [{ text: prompt }] }],
          generationConfig: { maxOutputTokens: 1200, responseMimeType: 'application/json' },
        }),
      })
        .then(function (res) {
          if (res.status === 429) {
            tryModel(modelIndex + 1);
            return null;
          }
          return res.json();
        })
        .then(function (data) {
          if (!data) return;
          var text =
            data.candidates && data.candidates[0] && data.candidates[0].content &&
            data.candidates[0].content.parts && data.candidates[0].content.parts[0].text;
          if (!text || !applyResult(text)) tryModel(modelIndex + 1);
        })
        .catch(function () {
          tryModel(modelIndex + 1);
        });
    }

    function fetchViaGroq(isRetry) {
      fetch(GROQ_WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: 'llama-3.1-8b-instant',
          messages: [{ role: 'user', content: prompt }],
          response_format: { type: 'json_object' },
        }),
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          var text = data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content;
          if (text) applyResult(text);
        })
        .catch(function () {
          if (!isRetry) setTimeout(function () { fetchViaGroq(true); }, 500);
        });
    }

    tryModel(0);
  }

  // Local replacement for the old Blogger-feed "also on our site" lookup —
  // searches this site's own build-time search index instead.
  function fetchOwnSiteResult(query, requestId) {
    var hasOwnDomain = lastResults.some(function (r) {
      return domainFromUrl(r).indexOf('glitchmental.com') !== -1;
    });
    if (hasOwnDomain) return;

    fetch('/search-index.json')
      .then(function (res) { return res.json(); })
      .then(function (index) {
        if (requestId !== currentRequestId) return;
        var normQuery = normalize(query).toLowerCase();
        var terms = normQuery.split(/\s+/).filter(Boolean);
        var match = index.find(function (item) {
          var haystack = normalize(item.title + ' ' + item.excerpt).toLowerCase();
          return terms.every(function (t) { return haystack.indexOf(t) !== -1; });
        });
        if (!match) return;

        var existingSeparator = document.querySelector('.own-site-separator');
        if (existingSeparator) {
          var existingCard = existingSeparator.nextElementSibling;
          if (existingCard) existingCard.remove();
          existingSeparator.remove();
        }

        var html =
          '<div class="own-site-separator">También en GlitchMentalMX</div>' +
          '<a class="card-link" href="' + match.url + '">' +
          '<article class="card own-site-card">' +
          '<h3>' + match.title + '</h3>' +
          '<p>' + match.excerpt + '</p>' +
          '</article></a>';
        document.getElementById('results').insertAdjacentHTML('beforeend', html);
      })
      .catch(function () {});
  }

  function normalize(str) { return str.normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }

  function highlight(text, term) {
    if (!term || !text) return text || '';
    var source = text;
    var normSource = normalize(source).toLowerCase();
    var normTerm = normalize(term).toLowerCase();
    var index = normSource.indexOf(normTerm);
    if (index === -1) return source;
    var map = [];
    var pos = 0;
    for (var i = 0; i < source.length; i++) {
      var ch = normalize(source[i]);
      for (var j = 0; j < ch.length; j++) map[pos++] = i;
    }
    var start = map[index];
    var end = map[index + normTerm.length - 1] + 1;
    return source.slice(0, start) + '<strong>' + source.slice(start, end) + '</strong>' + source.slice(end);
  }

  function domainFromUrl(r) {
    if (r.visibleUrl) return r.visibleUrl.replace(/^www\./, '');
    try { return new URL(r.url).hostname.replace(/^www\./, ''); } catch (e) { return ''; }
  }

  function renderCards() {
    var results = document.getElementById('results');
    var note = document.getElementById('resultsNote');
    if (lastResults.length === 0) {
      results.innerHTML =
        '<div class="no-results">' +
        '<svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>' +
        '<h3>No encontramos resultados</h3>' +
        '<p>Prueba con otras palabras. Recuerda: solo buscamos dentro de nuestras fuentes curadas.</p>' +
        '</div>';
      note.style.display = 'none';
      return;
    }
    var html = '';
    for (var i = 0; i < lastResults.length; i++) {
      var r = lastResults[i];
      var domain = domainFromUrl(r);
      var title = highlight(r.titleNoFormatting || r.title || '', lastQuery);
      var snippet = highlight(r.contentNoFormatting || r.content || '', lastQuery);
      html +=
        '<a class="card-link" href="' + r.url + '" target="_blank" rel="noopener">' +
        '<article class="card">' +
        '<div class="domain">' + domain + '</div>' +
        '<h3>' + title + '</h3>' +
        '<p>' + snippet + '</p>' +
        '</article>' +
        '</a>';
    }
    results.innerHTML = html;
    note.style.display = 'block';
  }

  function glitchSearchOnResults(gname, query, results) {
    lastQuery = query || lastQuery;
    lastResults = results || [];
    document.getElementById('q').disabled = false;
    document.getElementById('go').disabled = false;
    document.getElementById('q').style.cursor = 'text';
    document.body.classList.remove('gsc-overflow-hidden');
    renderCards();
    document.getElementById('q').focus();
  }

  function runSearch() {
    var term = document.getElementById('q').value.trim();
    if (!term) return;
    lastQuery = term;
    document.getElementById('q').disabled = true;
    document.getElementById('go').disabled = true;
    document.getElementById('q').style.cursor = 'wait';
    document.getElementById('results').innerHTML = '<div class="search-loading"></div>';
    document.getElementById('resultsNote').style.display = 'none';
    document.getElementById('aiVerdict').style.display = 'none';

    try {
      var el = google.search.cse.element.getElement('searchresults-only0');
      el.execute(term);
    } catch (e) {
      document.getElementById('q').disabled = false;
      document.getElementById('go').disabled = false;
      document.getElementById('results').innerHTML =
        '<div class="connection-error">' +
        '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="17" r="1.2" fill="currentColor"/></svg>' +
        '<h3>No fue posible completar la búsqueda</h3>' +
        '<p>Inténtalo nuevamente en unos segundos.</p>' +
        '</div>';
    }
  }

  window.addEventListener('load', function () {
    document.getElementById('go').onclick = function (e) { e.preventDefault(); runSearch(); };
    document.getElementById('q').onkeydown = function (e) {
      if (e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); runSearch(); return false; }
    };

    var qInput = document.getElementById('q');
    var clearBtn = document.getElementById('clearBtn');
    qInput.addEventListener('input', function () {
      clearBtn.style.display = qInput.value.length > 0 ? 'flex' : 'none';
    });
    clearBtn.onclick = function (e) {
      e.preventDefault();
      qInput.value = '';
      clearBtn.style.display = 'none';
      qInput.focus();
    };

    var urlParams = new URLSearchParams(window.location.search);
    var incomingQuery = urlParams.get('q');
    if (incomingQuery) {
      qInput.value = incomingQuery;
      qInput.focus();
      runSearch();
    }
  });
</script>

<style>
  .wrap { max-width: 820px; padding: 56px 24px 96px; }
  .kicker { margin-bottom: 6px; }
  .lead { font-family: var(--font-display); font-size: 1.6rem; margin: 0 0 28px; }

  .search { position: relative; width: 100%; }
  .search input {
    width: 100%;
    height: 58px;
    padding: 0 170px 0 22px;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    background: var(--bg-elevated);
    color: var(--text);
    font: 400 17px var(--font-body);
    outline: none;
    transition: 0.2s;
  }
  .search input:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  #go {
    position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
    width: 42px; height: 42px; border: none; border-radius: 999px;
    background: var(--bg-inset); color: var(--text-muted);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
  }
  #go:hover { color: var(--accent); }
  .arrow { width: 18px; height: 18px; }
  .search-ai-badge {
    position: absolute; right: 56px; top: 50%; transform: translateY(-50%);
    font: 400 10px var(--font-mono); color: #fff; background: #7c5cff;
    padding: 3px 8px; border-radius: 999px; pointer-events: none; white-space: nowrap;
  }
  #clearBtn {
    position: absolute; right: 118px; top: 50%; transform: translateY(-50%);
    width: 30px; height: 30px; border: none; background: none; color: var(--text-faint);
    cursor: pointer; display: none; align-items: center; justify-content: center;
    font-size: 22px; line-height: 1; border-radius: 999px;
  }
  #clearBtn:hover { color: var(--text); }

  .results-note {
    margin: 20px 0 10px; text-align: center; font-size: 13px;
    font-family: var(--font-mono); color: var(--text-faint);
  }

  .ai-verdict {
    max-width: 620px; margin: 20px auto; padding: 14px 18px; border-radius: 12px;
    background: rgba(124, 92, 255, 0.08); border-left: 3px solid #7c5cff; text-align: left;
  }
  .ai-verdict-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .ai-verdict-label { font: 400 10px var(--font-mono); color: #7c5cff; letter-spacing: 0.04em; }
  .ai-badge { font: 400 9px var(--font-mono); color: #fff; background: #7c5cff; padding: 2px 8px; border-radius: 999px; }
  .ai-verdict p { margin: 0; font: 400 14px var(--font-body); color: var(--text); line-height: 1.5; }

  .official-site {
    max-width: 620px; margin: 0 auto 16px; padding: 10px 18px; border-radius: 12px;
    background: var(--accent-soft); border-left: 3px solid var(--accent);
    text-align: left; display: flex; align-items: center; gap: 12px;
  }
  .official-label { font: 400 10px var(--font-mono); color: var(--accent); letter-spacing: 0.04em; }
  .official-site a { font: 700 14px var(--font-body); color: var(--text); }
  .official-site a:hover { text-decoration: underline; }

  #results { margin-top: 20px; }
  .card { padding: 18px 0; border-bottom: 1px solid var(--border); }
  .card:last-child { border-bottom: none; }
  .card-link { display: block; color: inherit; }
  .card h3 { margin: 0 0 4px; font: 400 17px var(--font-body); line-height: 1.3; color: var(--text); }
  .card p { font-size: 14px; font-weight: 300; margin: 4px 0; color: var(--text-muted); line-height: 1.5; }
  .card h3 strong, .card p strong { color: var(--accent); font-weight: 600; }
  .domain { font: 400 11px var(--font-mono); color: var(--text-faint); margin-bottom: 8px; }
  .own-site-separator {
    font: 700 12px var(--font-mono); color: var(--accent); letter-spacing: 0.08em;
    text-align: center; margin: 44px 0 20px; text-transform: uppercase;
  }
  .own-site-card { padding-top: 6px; }
  .own-site-card h3 { font-size: 19px; }

  .search-loading { position: relative; width: 100%; height: 18px; margin: 22px 0 10px; overflow: hidden; }
  .search-loading::after {
    content: ''; position: absolute; left: 50%; top: 8px; width: 0; height: 2px; border-radius: 999px;
    background: var(--accent); transform: translateX(-50%);
    animation: glitchLoading 1.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes glitchLoading { 0% { width: 0; opacity: 0.35; } 50% { width: 70%; opacity: 1; } 100% { width: 0; opacity: 0.35; } }

  .no-results, .connection-error { padding: 34px 0; text-align: center; }
  .no-results svg, .connection-error svg { width: 26px; height: 26px; color: var(--text-faint); margin-bottom: 14px; }
  .no-results h3, .connection-error h3 { margin: 0 0 8px; font-size: 18px; font-weight: 600; color: var(--text); }
  .no-results p, .connection-error p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--text-muted); }

  .badges {
    display: flex; justify-content: center; align-items: center; gap: 6px;
    color: var(--text-faint); font-size: 10px; margin-top: 24px;
  }
</style>
