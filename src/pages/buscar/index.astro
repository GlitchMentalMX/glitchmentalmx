---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="Buscar en el sitio" description="Busca entre todos los artículos de glitchmentalMX.">
  <PageHeader
    eyebrow="Buscar"
    title="Busca en **el archivo de glitchMentalMX.**"
  />
  <p class="container search-dek">
    Esto busca solo dentro de este sitio. Si quieres explorar la web curada por nosotros, usa <a href="/glitchsearch/" class="link-accent">GlitchSearch</a>.
  </p>

  <section class="container search-box">
    <input id="q" type="text" placeholder="Escribe una palabra o tema…" autocomplete="off" spellcheck="false" />
    <p id="count" class="eyebrow count"></p>
  </section>

  <section id="results" class="container grid"></section>
</Layout>

<script>
  let index: { title: string; url: string; excerpt: string; image: string; imageAlt: string; category: string; date: string }[] = [];

  function normalize(str: string) {
    return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  }

  function renderResults(items: typeof index) {
    const results = document.getElementById('results')!;
    const count = document.getElementById('count')!;
    if (!items.length) {
      results.innerHTML = '';
      count.textContent = '';
      return;
    }
    count.textContent = `${items.length} resultado${items.length === 1 ? '' : 's'}`;
    results.innerHTML = items
      .slice(0, 30)
      .map(
        (item) => `
        <a class="card" href="${item.url}">
          <img src="${item.image}" alt="${item.imageAlt}" loading="lazy" width="800" height="500" />
          <div class="body">
            <p class="eyebrow meta">${item.category}</p>
            <h3>${item.title}</h3>
            <p class="dek">${item.excerpt}</p>
          </div>
        </a>`
      )
      .join('');
  }

  function runSearch(query: string) {
    const term = query.trim();
    if (!term) {
      renderResults([]);
      return;
    }
    const terms = normalize(term).split(/\s+/).filter(Boolean);
    const matches = index.filter((item) => {
      const haystack = normalize(item.title + ' ' + item.excerpt + ' ' + item.category);
      return terms.every((t) => haystack.indexOf(t) !== -1);
    });
    renderResults(matches);
  }

  const input = document.getElementById('q') as HTMLInputElement;
  fetch('/search-index.json')
    .then((res) => res.json())
    .then((data) => {
      index = data;
      const urlParams = new URLSearchParams(window.location.search);
      const incoming = urlParams.get('q');
      if (incoming) {
        input.value = incoming;
        runSearch(incoming);
      }
    });

  input.addEventListener('input', () => runSearch(input.value));
  input.focus();
</script>

<style>
  .search-dek {
    margin: -24px auto 28px;
    padding: 0 24px;
    max-width: 620px;
    font-size: 1.12rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .search-box { padding: 0 24px 8px; max-width: 620px; }
  #q {
    width: 100%;
    height: 52px;
    padding: 0 20px;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: var(--bg-elevated);
    color: var(--text);
    font: 400 16px var(--font-body);
    outline: none;
  }
  #q:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .count { margin: 12px 0 0; }

  .grid {
    padding: 24px 24px 96px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  /* Result cards are injected client-side via innerHTML, so Astro's scoped
     CSS (which only tags build-time markup) never reaches them — these
     selectors must stay global to actually apply. */
  :global(#results .card) { display: block; border-radius: var(--radius); overflow: hidden; background: var(--bg-inset); color: var(--text); }
  :global(#results .card img) { width: 100%; aspect-ratio: 16/9; height: auto; object-fit: cover; }
  :global(#results .card .body) { padding: 16px 18px 20px; }
  :global(#results .card h3) { font-size: 1.02rem; line-height: 1.3; margin: 6px 0 8px; }
  :global(#results .card:hover h3) { color: var(--accent); }
  :global(#results .card .dek) { color: var(--text-muted); font-size: 0.86rem; line-height: 1.5; margin: 0; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
