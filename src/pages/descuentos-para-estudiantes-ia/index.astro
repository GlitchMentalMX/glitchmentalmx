---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EstudiantesRow from '../../components/EstudiantesRow.astro';
import BuscadorPreciosIA from '../../components/BuscadorPreciosIA.astro';
import { getCollection } from 'astro:content';

// A diferencia de las otras series (que ponen primero lo "peor"), aquí va
// primero lo que SÍ aplica: quien llega buscando "gratis para estudiantes"
// quiere ver de entrada qué puede reclamar hoy en México.
const VEREDICTO_ORDEN = { verde: 0, amarillo: 1, rojo: 2 };

const posts = (await getCollection('estudiantes', ({ data }) => !data.draft)).sort((a, b) => {
  const porVeredicto = VEREDICTO_ORDEN[a.data.veredicto] - VEREDICTO_ORDEN[b.data.veredicto];
  return porVeredicto !== 0 ? porVeredicto : a.data.herramienta.localeCompare(b.data.herramienta, 'es');
});

const buscadorItems = posts.map((post) => ({
  nombre: post.data.herramienta,
  slug: post.id,
}));

// Conteos calculados en build-time: el gancho de la página ("de N, solo X
// aplican de verdad en México") nunca puede quedar desfasado de las fichas.
const verdes = posts.filter((p) => p.data.veredicto === 'verde').length;
const amarillos = posts.filter((p) => p.data.veredicto === 'amarillo').length;
const rojos = posts.filter((p) => p.data.veredicto === 'rojo').length;
const aplica = (n: number) => (n === 1 ? 'aplica' : 'aplican');

const title = 'Descuentos para estudiantes: IA y apps que sí aplican en México';
const description =
  'Qué herramientas de IA y apps tienen plan gratis o descuento para estudiantes, y cuáles de esas ofertas aplican de verdad en México. Verificado en la fuente oficial.';
const modifiedTime = posts.reduce(
  (max, p) => ((p.data.updatedDate ?? p.data.pubDate) > max ? (p.data.updatedDate ?? p.data.pubDate) : max),
  posts[0]?.data.pubDate
);
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  description,
  numberOfItems: posts.length,
  itemListOrder: 'https://schema.org/ItemListUnordered',
  itemListElement: posts.map((post, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: post.data.herramienta,
    url: new URL(`/articulos/${post.id}/`, Astro.site).toString(),
  })),
};
---

<Layout
  title={title}
  description={description}
  modifiedTime={modifiedTime}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <Breadcrumbs items={[
    { name: 'IA sin letra chiquita', url: '/ia-sin-letra-chiquita/' },
    { name: 'Descuentos para estudiantes' },
  ]} />
  <section class="container header">
    <p class="eyebrow">Descuentos para estudiantes · {posts.length} herramientas verificadas</p>
    <h1>{title}</h1>
    <p class="dek">
      Casi toda herramienta presume un plan "gratis para estudiantes" — pero la letra chiquita decide
      si te sirve: muchas ofertas son solo para Estados Unidos, para ciertas universidades, o piden
      tarjeta y se renuevan solas a precio completo cuando termina el beneficio. Aquí verificamos,
      directo en la fuente oficial de cada herramienta, si la oferta existe, cómo se reclama y, sobre
      todo, si aplica a un estudiante en México.
    </p>
    <p class="dek resumen">
      De las {posts.length} que revisamos, <strong>{verdes}</strong> {aplica(verdes)} en México sin trabas
      conocidas, <strong>{amarillos}</strong> {aplica(amarillos)} con condiciones y <strong>{rojos}</strong> no
      {aplica(rojos)}. Los precios de cada herramienta, aparte, están en <a href="/precios-ia/">Precios de IA</a>;
      si lo que buscas es un cupón, revisa <a href="/codigos-descuento-ia/">Códigos de descuento</a>.
    </p>
  </section>

  <section class="container leyenda">
    <span class="leyenda-item"><span aria-hidden="true">🟢</span> Aplica en México</span>
    <span class="leyenda-item"><span aria-hidden="true">🟡</span> Aplica con condiciones</span>
    <span class="leyenda-item"><span aria-hidden="true">🔴</span> No aplica en México</span>
  </section>

  <section class="container list">
    <p class="eyebrow list-label">Las herramientas</p>
    <BuscadorPreciosIA items={buscadorItems} />
    {posts.map((post, i) => (
      <EstudiantesRow
        index={i + 1}
        slug={post.id}
        herramienta={post.data.herramienta}
        veredicto={post.data.veredicto}
        fraseCorta={post.data.fraseCorta}
      />
    ))}
  </section>
</Layout>

<style>
  .header { padding: 56px 24px 24px; max-width: 760px; }
  .header h1 { font-family: var(--font-display); font-size: clamp(2.1rem, 4.6vw, 3rem); margin: 12px 0 16px; }
  .dek { color: var(--text-muted); font-size: 1.1rem; line-height: 1.55; }
  .dek + .dek { margin-top: 14px; }
  .dek a { color: var(--accent); font-weight: 500; }
  .dek strong { color: var(--text); }

  .leyenda {
    max-width: 760px;
    padding: 0 24px 28px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px 20px;
  }
  .leyenda-item {
    font-size: 0.84rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 700px) {
    .leyenda { grid-template-columns: 1fr; }
  }

  .list { padding: 24px 24px 96px; max-width: 780px; }
  .list-label { margin-bottom: 6px; }
</style>
