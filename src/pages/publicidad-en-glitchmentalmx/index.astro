---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const formats = [
  {
    icon: '📝',
    title: 'Post patrocinado',
    price: '$200 USD',
    note: 'Permanente',
    items: ['Redacción + SEO + Publicación', 'Hasta 2 enlaces DoFollow o NoFollow', 'Entrega en 3–5 días hábiles'],
  },
  {
    icon: '🔗',
    title: 'Enlace contextual',
    price: '$100 USD',
    note: '',
    items: ['Inserción en artículo existente relevante', 'Contexto editorial temático'],
  },
  {
    icon: '🖼️',
    title: 'Banner publicitario',
    price: '$150 USD/mes',
    note: 'Renovable mensualmente',
    items: ['Lateral / Header / Footer', '728×90, 300×250 u otras medidas'],
  },
];

const why = [
  'Audiencia nicho con interés real en tecnología, IA y cultura digital',
  'Contenidos editorialmente integrados — mejor impacto que publicidad intrusiva',
  'Formatos flexibles según tu objetivo: SEO, branding o campañas',
  'Bienvenidas: startups, SaaS, fintech, herramientas digitales y marcas tech',
];
---

<Layout
  title="Publicidad"
  description="Tu marca frente a una audiencia que sí le importa la tecnología."
>
  <PageHeader
    eyebrow="Publicidad en glitchmentalMX"
    title="Tu marca frente a una audiencia que sí le importa la tecnología."
    dek="Lectores interesados en Inteligencia Artificial, Cultura Digital, Tendencias Tecnológicas y Gadgets. Formatos editorialmente integrados para mejor impacto — sin publicidad genérica ni intrusiva."
  />

  <section class="container formats">
    <p class="eyebrow section-label">Formatos disponibles</p>
    <div class="grid">
      {formats.map((f) => (
        <div class="format-card">
          <span class="icon">{f.icon}</span>
          <h3>{f.title}</h3>
          <p class="price">{f.price}</p>
          {f.note && <p class="note">{f.note}</p>}
          <ul>{f.items.map((i) => <li>→ {i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container prose">
    <h2>Por qué anunciar aquí</h2>
    <ul class="checks">
      {why.map((w) => <li>✓ {w}</li>)}
    </ul>

    <h2>Cómo contratar</h2>
    <p>Escribe con tus objetivos y presupuesto estimado. Te responderemos con una propuesta detallada y términos específicos para tu campaña.</p>
  </section>

  <section class="container actions">
    <a class="btn btn-primary" href="mailto:contacto@glitchmental.com">contacto@glitchmental.com</a>
  </section>
</Layout>

<style>
  .section-label { padding: 0 24px; }
  .formats { padding: 8px 24px 24px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 14px; }
  .format-card { background: var(--bg-inset); border-radius: var(--radius); padding: 26px; }
  .icon { font-size: 1.6rem; }
  .format-card h3 { font-size: 1.1rem; margin: 12px 0 4px; }
  .price { font-family: var(--font-mono); color: var(--accent); font-weight: 600; margin: 0 0 2px; }
  .note { color: var(--text-faint); font-size: 0.8rem; margin: 0 0 14px; }
  .format-card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .format-card li { color: var(--text-muted); font-size: 0.88rem; }

  .prose { padding: 8px 24px; }
  .checks { list-style: none; padding: 0; }
  .checks li { margin-bottom: 6px; }

  .actions { padding: 16px 24px 96px; }

  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
