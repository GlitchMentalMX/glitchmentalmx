---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SeriesCallout from '../../components/SeriesCallout.astro';
import BookPromo from '../../components/BookPromo.astro';
import ToolPromo from '../../components/ToolPromo.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime } from '../../lib/format';
import { categorySlug } from '../../data/categories';
import { getBook } from '../../data/books';

// Enlazado inverso Panóptico Digital → Cero Orgánico: estos 5 artículos son
// justo los que integran esa serie (ver postSlugs en
// src/content/collections/panoptico-digital.md), y hoy la serie enlaza hacia
// la novela pero no al revés. No es un campo de esquema porque es una
// promoción puntual de 5 artículos, no un comportamiento general de posts.
const PANOPTICO_DIGITAL_SLUGS = new Set([
  'economia-de-creadores-a-donde-va-el-dinero-realmente',
  'estas-hablando-con-un-humano-o-un-bot-ya-no-importa',
  'el-algoritmo-no-existe-por-que-seguimos-creyendo-el-cuento',
  'las-redes-sociales-son-maquinas-de-vigilancia-entre-pares',
  'web3-la-descentralizacion-que-siempre-fue-un-pitch',
]);

// Promoción puntual de la Calculadora de Riesgo IA — deliberadamente
// hardcodeada (no un campo de esquema editable desde el CMS) para que esto
// no se vuelva un enlace que crece solo con cada artículo nuevo. Lote exacto:
// los 16 artículos de la sección "Trabajo y Automatización" en
// src/content/collections/biblioteca-de-ia-tecnologia-y-sociedad.md.
const RISK_CALCULATOR_SLUGS = new Set([
  'los-empleos-que-la-ia-no-puede-tocar-segun-microsoft',
  'que-trabajos-cambia-primero-la-ia-y-por-que-esos',
  'automatizacion-y-autonomia-no-son-lo-mismo-confundirlas-tiene-consecuencias',
  'amodei-advierte-el-tsunami-de-ia-ya-llego-a-la-orilla',
  'sam-altman-admite-la-ia-rompe-el-equilibrio-laboral',
  'ia-y-empleos-en-mexico-el-golpe-ya-empezo',
  'las-habilidades-que-mas-importan-en-la-era-de-la-ia',
  'como-preparar-tu-carrera-para-la-ia-en-2026-guia-real',
  'la-fotografia-de-stock-murio-y-nadie-fue-al-velorio',
  'el-negocio-de-la-musica-de-fondo-ya-no-necesita-musicos',
  'la-ia-no-liquido-escritores-liquido-a-quien-los-pagaba',
  'disenadores-freelance-e-ia-el-colapso-del-nivel-medio',
  'la-automatizacion-que-nadie-vio-venir-los-trabajos-de-cuello-blanco',
  'agentes-de-ia-la-empresa-sin-jefes-que-nadie-pidio',
  'pagas-por-la-ia-que-te-convierte-en-su-empleado-no-remunerado',
  'el-trabajo-humano-que-la-ia-ya-no-necesita-fingir-mas',
]);

// Promoción puntual del Índice glitchMentalMX — mismo criterio: lote fijo,
// curado a mano por relevancia real (adopción de tecnología B2B), no un
// campo de esquema. "agentes-de-ia-la-empresa-sin-jefes-que-nadie-pidio" se
// dejó fuera de aquí porque ya está en el lote de la calculadora — ningún
// artículo debe cargar dos tarjetas de herramienta.
const INDICE_SLUGS = new Set([
  'tres-empresas-controlan-la-nube-eso-deberia-preocuparte',
  'la-gran-migracion-como-las-empresas-reubican-fisicamente-sus-centros-de-datos-de-ia',
  'ia-empresarial-2026-del-piloto-al-presupuesto-real',
  'el-glosario-que-las-empresas-de-ia-no-quieren-que-leas',
  'agentes-de-ia-openai-y-google-ya-no-compiten-con-chatbots',
]);

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, category, pubDate, updatedDate, heroImage, heroImageAlt } = post.data;
const minutes = readingTime(post.body || '');

// Only the 6 narrative series and "Detrás del Prompt" originally carried a
// "part of this series" callout at the end of the article — the broad
// reference hubs (Biblioteca, Mapa de Poder Tech, etc.) never had one.
const editorialCollections = await getCollection(
  'editorialCollections',
  ({ id, data }) => data.kind === 'series' || id === 'detras-del-prompt'
);
const parentCollection = editorialCollections.find((c) => c.data.postSlugs.includes(post.id));

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const relatedPool = allPosts.filter((p) => p.id !== post.id);

// "Sigue leyendo" prioriza la MISMA categoría — antes solo miraba cercanía de
// fecha de publicación, así que podía recomendar una novela o un smartwatch
// debajo de un artículo de IA solo porque salieron la misma semana. Dentro de
// la categoría, se mantiene el mismo criterio de cercanía en el tiempo al
// artículo actual; si no hay 3 en la misma categoría (no debería pasar dado
// el tamaño del archivo, pero por seguridad), se completa con lo más cercano
// en fecha del resto del sitio.
const sameCategoryPool = relatedPool.filter((p) => p.data.category === category);
const sameCategoryIdx = sameCategoryPool.findIndex((p) => p.data.pubDate.valueOf() <= pubDate.valueOf());
const anchorIdx = sameCategoryIdx === -1 ? sameCategoryPool.length : sameCategoryIdx;
const relatedSameCategory = sameCategoryPool.slice(Math.max(0, anchorIdx - 2), Math.max(0, anchorIdx - 2) + 3);
const relatedFinal =
  relatedSameCategory.length === 3
    ? relatedSameCategory
    : [...relatedSameCategory, ...relatedPool.filter((p) => p.data.category !== category)].slice(0, 3);

const ceroOrganico = PANOPTICO_DIGITAL_SLUGS.has(post.id) ? getBook('cero-organico') : undefined;

const toolPromo = RISK_CALCULATOR_SLUGS.has(post.id)
  ? {
      title: '¿La IA puede quitarte tu trabajo?',
      description: 'Mide qué tan expuesto está tu trabajo a la automatización. Descúbrelo gratis, en segundos.',
      href: '/calculadora-de-riesgo-de-reemplazo-por-ia-2026/',
    }
  : INDICE_SLUGS.has(post.id)
    ? {
        title: 'El índice que separa el hype del impacto real.',
        description:
          '20 tecnologías B2B rankeadas por adopción real, integración operativa y señales públicas verificables. Sin patrocinadores, sin agenda.',
        href: '/indice-glitchmentalmx/',
      }
    : undefined;

const articleURL = new URL(`/articulos/${post.id}/`, Astro.site).toString();
const articleImage = new URL(heroImage, Astro.site).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: articleURL,
  image: articleImage,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Jorge A. Diaz Elizondo',
    url: new URL('/acerca-de/', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'glitchmentalMX',
    logo: { '@type': 'ImageObject', url: new URL('/og-default.png', Astro.site).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleURL },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'meta[name="description"]'],
  },
  about: [{ '@type': 'Thing', name: category }],
  isPartOf: { '@type': 'WebSite', name: 'glitchmentalMX', url: Astro.site?.toString() },
  articleSection: category,
};
---

<Layout title={title} description={description} image={heroImage} type="article" publishedTime={pubDate} modifiedTime={updatedDate ?? pubDate}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="post">
    <header class="post-header container">
      <a href={`/categoria/${categorySlug(category)}/`} class="tag category-tag">{category}</a>
      <p class="eyebrow">{formatDate(pubDate)} · {minutes} min de lectura{updatedDate ? ` · Actualizado el ${formatDate(updatedDate)}` : ''}</p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
    </header>

    {heroImage && (
      <div class="hero container">
        <img src={heroImage} alt={heroImageAlt} width="1600" height="1000" data-lightbox />
      </div>
    )}

    <div class="content container">
      <div class="prose">
        <Content />
      </div>
      {parentCollection && (
        <SeriesCallout
          kind={parentCollection.data.kind}
          title={parentCollection.data.title}
          description={parentCollection.data.description}
          href={parentCollection.data.kind === 'series' ? `/series/${parentCollection.id}/` : `/colecciones/${parentCollection.id}/`}
          count={parentCollection.data.postSlugs.length}
        />
      )}
    </div>

    <div class="share container">
      <span class="eyebrow">Compartir</span>
      <a
        class="btn btn-ghost"
        target="_blank"
        rel="noopener"
        href={`https://wa.me/?text=${encodeURIComponent(title)}%20${encodeURIComponent('https://glitchmental.com/articulos/' + post.id + '/')}`}
      >WhatsApp</a>
      <button id="share-copy" class="btn btn-ghost" type="button"><span>Copiar enlace</span></button>
    </div>
  </article>

  {ceroOrganico && (
    <section class="container book-section">
      <BookPromo book={ceroOrganico} />
    </section>
  )}

  {toolPromo && (
    <section class="container book-section">
      <ToolPromo title={toolPromo.title} description={toolPromo.description} href={toolPromo.href} />
    </section>
  )}

  {relatedFinal.length > 0 && (
    <section class="related container">
      <h2>Sigue leyendo</h2>
      <div class="grid">
        {relatedFinal.map((p) => (
          <ArticleCard
            slug={p.id}
            title={p.data.title}
            description={p.data.description}
            pubDate={p.data.pubDate}
            heroImage={p.data.heroImage}
            heroImageAlt={p.data.heroImageAlt}
            body={p.body}
          />
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .post-header {
    max-width: 760px;
    padding: 48px 24px 32px;
  }
  .category-tag { margin-bottom: 14px; }
  .category-tag:hover { background: var(--accent); color: #fff; }
  .post-header h1 {
    font-size: clamp(1.9rem, 4.6vw, 2.9rem);
    margin: 14px 0 18px;
  }
  .dek {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .hero {
    padding: 0 24px;
    margin-bottom: 40px;
  }
  .hero img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .content { padding: 0 24px 20px; display: flex; flex-direction: column; align-items: center; }

  .book-section { max-width: 720px; padding: 32px 24px 96px; }

  .share {
    padding: 32px 24px 0;
    max-width: var(--measure);
    margin: 40px auto 0;
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }
  .share .btn { padding: 0.55em 1.1em; font-size: 0.82rem; }

  .related {
    padding: 64px 24px 40px;
    border-top: 1px solid var(--border);
    margin-top: 64px;
  }
  .related h2 { font-size: 1.4rem; margin-bottom: 28px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 28px;
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const copyBtn = document.getElementById('share-copy') as HTMLButtonElement | null;
  const copyLabel = copyBtn?.querySelector('span');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href).then(() => {
      if (!copyLabel) return;
      const original = copyLabel.textContent;
      copyBtn.classList.add('copied');
      copyLabel.textContent = 'Copiado';
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        copyLabel.textContent = original;
      }, 2000);
    });
  });
</script>
