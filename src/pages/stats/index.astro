---
import Layout from '../../layouts/Layout.astro';

const WORKER_URL = 'https://glitchmental-analytics.contacto-fbf.workers.dev';
---

<Layout title="Estadísticas" description="Panel privado de analytics." noIndex={true}>
  <section class="container wrap">
    <div id="gate" class="gate">
      <p class="eyebrow">Panel privado</p>
      <h1>Estadísticas</h1>
      <p class="hint">Pega tu token de acceso.</p>
      <form id="gate-form">
        <input id="token-input" type="password" autocomplete="off" placeholder="Token" />
        <button type="submit" class="btn btn-primary">Entrar</button>
      </form>
      <p id="gate-error" class="error" hidden>Token incorrecto o el Worker no respondió.</p>
    </div>

    <div id="dashboard" class="dashboard" hidden>
      <div class="head">
        <div>
          <p class="eyebrow">Panel privado</p>
          <h1>Estadísticas</h1>
        </div>
        <div class="head-controls">
          <div class="range-picker" role="group" aria-label="Rango de fechas">
            <button type="button" class="range-btn" data-range="1h">1 hora</button>
            <button type="button" class="range-btn" data-range="24h">24 horas</button>
            <button type="button" class="range-btn" data-range="7d">7 días</button>
            <button type="button" class="range-btn active" data-range="30d">30 días</button>
            <button type="button" class="range-btn" data-range="90d">90 días</button>
          </div>
          <button type="button" id="refresh-btn" class="btn btn-ghost refresh-btn">↻ Actualizar</button>
        </div>
      </div>
      <p id="updated-at" class="hint updated-at"></p>

      <p id="loading" class="hint">Cargando…</p>
      <div id="content" hidden>
        <section class="cards">
          <div class="card">
            <p class="card-label">Vistas (rango)</p>
            <p class="card-value" id="stat-views">—</p>
          </div>
          <div class="card">
            <p class="card-label">Visitantes únicos (rango)</p>
            <p class="card-value" id="stat-uniques">—</p>
          </div>
          <div class="card">
            <p class="card-label">Acumulado histórico</p>
            <p class="card-value" id="stat-cumulative">—</p>
          </div>
          <div class="card card-bots">
            <p class="card-label">Bots detectados (rango)</p>
            <p class="card-value" id="stat-bots">—</p>
          </div>
        </section>

        <section class="block">
          <h2>Vistas por día</h2>
          <div id="table-day"></div>
        </section>

        <section class="block">
          <h2>Páginas más vistas</h2>
          <div id="table-pages"></div>
        </section>

        <section class="block">
          <h2>Origen del tráfico</h2>
          <div id="table-sources"></div>
        </section>

        <section class="block">
          <h2>Referrers específicos</h2>
          <div id="table-referrers"></div>
        </section>

        <section class="block">
          <h2>País</h2>
          <div id="table-countries"></div>
        </section>

        <section class="block">
          <h2>Dispositivo</h2>
          <div id="table-devices"></div>
        </section>

        <section class="block">
          <h2>Sistema operativo</h2>
          <div id="table-os"></div>
        </section>

        <section class="block">
          <h2>Navegador</h2>
          <div id="table-browsers"></div>
        </section>

        <section class="block">
          <h2>Fuente preferida — clics por ubicación</h2>
          <div id="table-preferred-source"></div>
        </section>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ WORKER_URL }}>
  const gate = document.getElementById('gate');
  const gateForm = document.getElementById('gate-form');
  const tokenInput = document.getElementById('token-input');
  const gateError = document.getElementById('gate-error');
  const dashboard = document.getElementById('dashboard');
  const loading = document.getElementById('loading');
  const content = document.getElementById('content');
  const updatedAt = document.getElementById('updated-at');
  const refreshBtn = document.getElementById('refresh-btn');

  const STORAGE_KEY = 'gm-stats-token';
  let currentRange = '30d';

  function fmt(n) {
    return new Intl.NumberFormat('es-MX').format(n || 0);
  }

  function clearChildren(el) {
    while (el.firstChild) el.removeChild(el.firstChild);
  }

  // Tabla simple de 2 columnas (etiqueta / vistas). Reemplaza el diseño de
  // barras anterior — las barras se armaban con JS y el <style> de Astro
  // solo alcanza al HTML escrito en la plantilla, así que nunca les llegó
  // el estilo (se veían pegadas). Una tabla no depende de eso.
  function renderTable(container, rows, keyField, valueField, labelFn) {
    clearChildren(container);
    if (!rows || rows.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'hint';
      empty.textContent = 'Sin datos todavía.';
      container.appendChild(empty);
      return;
    }
    const table = document.createElement('table');
    table.className = 'stats-table';
    const tbody = document.createElement('tbody');
    rows.forEach((r) => {
      const tr = document.createElement('tr');
      const tdLabel = document.createElement('td');
      tdLabel.className = 'col-label';
      tdLabel.textContent = labelFn ? labelFn(r[keyField]) : r[keyField] || '(desconocido)';
      const tdValue = document.createElement('td');
      tdValue.className = 'col-value';
      tdValue.textContent = fmt(r[valueField]);
      tr.appendChild(tdLabel);
      tr.appendChild(tdValue);
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    container.appendChild(table);
  }

  const SOURCE_LABELS = { busqueda: 'Búsqueda', social: 'Redes sociales', referral: 'Referral', directo: 'Directo' };
  const DEVICE_LABELS = { desktop: 'Escritorio', mobile: 'Móvil', tablet: 'Tablet' };
  const PLACEMENT_LABELS = { footer: 'Footer', 'article-end': 'Fin de artículo', 'dato-incomodo': 'Dato Incómodo' };

  const countryDisplayNames = window.Intl && Intl.DisplayNames ? new Intl.DisplayNames(['es'], { type: 'region' }) : null;
  function countryLabel(code) {
    if (!code || code === 'XX') return 'Desconocido';
    if (!countryDisplayNames) return code;
    try {
      return countryDisplayNames.of(code) || code;
    } catch (e) {
      return code;
    }
  }

  function renderDashboard(data) {
    document.getElementById('stat-views').textContent = fmt(data.totals.views);
    document.getElementById('stat-uniques').textContent = fmt(data.totals.uniques);
    document.getElementById('stat-cumulative').textContent = fmt(data.cumulative_views);
    document.getElementById('stat-bots').textContent = fmt(data.bot_views);

    renderTable(document.getElementById('table-day'), [...data.by_day].reverse(), 'day', 'views');
    renderTable(document.getElementById('table-pages'), data.top_pages, 'path', 'views');
    renderTable(document.getElementById('table-sources'), data.sources, 'traffic_source', 'views', (s) => SOURCE_LABELS[s] || s);
    renderTable(document.getElementById('table-referrers'), data.referrers, 'referrer_host', 'views');
    renderTable(document.getElementById('table-countries'), data.countries, 'country', 'views', countryLabel);
    renderTable(document.getElementById('table-devices'), data.devices, 'device', 'views', (d) => DEVICE_LABELS[d] || d);
    renderTable(document.getElementById('table-os'), data.os, 'os', 'views');
    renderTable(document.getElementById('table-browsers'), data.browsers, 'browser', 'views');
    renderTable(
      document.getElementById('table-preferred-source'),
      data.preferred_source_by_placement,
      'placement',
      'count',
      (p) => PLACEMENT_LABELS[p] || p
    );

    updatedAt.textContent = 'Actualizado a las ' + new Date().toLocaleTimeString('es-MX');
  }

  async function loadStats(token) {
    loading.hidden = false;
    loading.textContent = 'Cargando…';
    content.hidden = true;
    refreshBtn.disabled = true;
    try {
      const res = await fetch(`${WORKER_URL}/stats?range=${currentRange}`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.status === 401) {
        sessionStorage.removeItem(STORAGE_KEY);
        showGate('El token ya no es válido.');
        return;
      }
      if (!res.ok) throw new Error('bad response');
      const data = await res.json();
      renderDashboard(data);
      loading.hidden = true;
      content.hidden = false;
    } catch (e) {
      loading.textContent = 'No se pudo conectar con el Worker. Revisa que esté desplegado y que el token sea correcto.';
    } finally {
      refreshBtn.disabled = false;
    }
  }

  function showGate(message) {
    dashboard.hidden = true;
    gate.hidden = false;
    if (message) {
      gateError.textContent = message;
      gateError.hidden = false;
    }
  }

  function showDashboard(token) {
    gate.hidden = true;
    dashboard.hidden = false;
    loadStats(token);
  }

  gateForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const token = tokenInput.value.trim();
    if (!token) return;
    sessionStorage.setItem(STORAGE_KEY, token);
    showDashboard(token);
  });

  document.querySelectorAll('.range-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.range-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentRange = btn.dataset.range;
      const token = sessionStorage.getItem(STORAGE_KEY);
      if (token) loadStats(token);
    });
  });

  refreshBtn.addEventListener('click', () => {
    const token = sessionStorage.getItem(STORAGE_KEY);
    if (token) loadStats(token);
  });

  const savedToken = sessionStorage.getItem(STORAGE_KEY);
  if (savedToken) {
    showDashboard(savedToken);
  }
</script>

<style is:global>
  .wrap { padding: 40px 24px 96px; max-width: 720px; }
  .wrap .eyebrow { margin-bottom: 8px; }
  .wrap h1 { font-size: 1.8rem; margin: 0 0 8px; }
  .wrap .hint { color: var(--text-muted); font-size: 0.92rem; }
  .wrap .error { color: var(--down-line); font-size: 0.88rem; margin-top: 10px; }

  .wrap .gate { max-width: 360px; padding-top: 40px; }
  .wrap .gate form { display: flex; gap: 10px; margin-top: 18px; }
  .wrap .gate input {
    flex: 1;
    padding: 0.7em 1em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 0.95rem;
  }

  .wrap .head { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 8px; }
  .wrap .head-controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .wrap .range-picker { display: flex; gap: 6px; }
  .wrap .range-btn {
    padding: 0.5em 1em;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    font-size: 0.85rem;
    cursor: pointer;
  }
  .wrap .range-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .wrap .refresh-btn { font-size: 0.85rem; padding: 0.5em 1.1em; }
  .wrap .updated-at { margin: 0 0 28px; font-size: 0.8rem; }

  .wrap .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 40px; }
  .wrap .card { background: var(--bg-inset); border-radius: var(--radius); padding: 18px 20px; border-top: 2px solid var(--accent); }
  .wrap .card-bots { border-top-color: var(--down-line); }
  .wrap .card-label { font-size: 0.78rem; color: var(--text-faint); margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.04em; font-family: var(--font-mono); }
  .wrap .card-value { font-size: 1.7rem; font-weight: 700; font-family: var(--font-display); margin: 0; }

  .wrap .block { margin-bottom: 40px; }
  .wrap .block h2 { font-size: 1.05rem; margin: 0 0 14px; }

  .wrap .stats-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .wrap .stats-table tr { border-bottom: 1px solid var(--border); }
  .wrap .stats-table tr:last-child { border-bottom: none; }
  .wrap .stats-table td { padding: 9px 4px; }
  .wrap .stats-table .col-label { color: var(--text); }
  .wrap .stats-table .col-value { color: var(--text-muted); text-align: right; font-family: var(--font-mono); white-space: nowrap; width: 1%; padding-left: 20px; }

  @media (max-width: 500px) {
    .wrap .cards { grid-template-columns: 1fr 1fr; }
  }
</style>
