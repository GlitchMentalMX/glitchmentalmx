---
// "¿Qué IA me conviene?" — recomendador personalizado, no ranking. El
// usuario responde unas preguntas y el motor calcula una compatibilidad
// 0-100 por herramienta (Capas 2-4 del proyecto), transparente vía la
// tabla de "por qué". Precio queda fuera del scoring a propósito: no existe
// como campo estructurado (vive en prosa dentro de precios-ia) — se enlaza
// como referencia, no se puntúa.
//
// Cobertura: solo las herramientas que ya tienen entrada en herramientasIA
// (src/content/herramientas-ia/actual.json). Se amplía llenando ese
// archivo, sin tocar esta página — la ficha y el quiz leen la colección
// dinámicamente.
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { ALIAS_ENTRENA_IA } from '../../data/alias-entrena-ia';
import { SUBPREGUNTAS_BASE } from '../../data/subpreguntas-recomendador';

const [tabla, precios, entrena, pruebaGratisSerie, estudiantesSerie] = await Promise.all([
  getCollection('herramientasIA'),
  getCollection('preciosIA', ({ data }) => !data.draft),
  getCollection('entrenaIA', ({ data }) => !data.draft),
  getCollection('pruebaGratis', ({ data }) => !data.draft),
  getCollection('estudiantes', ({ data }) => !data.draft),
]);

const capacidades = tabla[0]?.data.herramientas ?? [];


const TOOLS = capacidades.map((cap) => {
  const precio = precios.find((p) => p.data.herramientaId === cap.herramientaId);
  const privId = ALIAS_ENTRENA_IA[cap.herramientaId] ?? cap.herramientaId;
  const priv = entrena.find((p) => p.data.herramientaId === privId);
  return {
    id: cap.herramientaId,
    nombre: precio?.data.herramienta ?? priv?.data.herramienta ?? cap.herramientaId,
    tipo: cap.tipo ?? 'generalista',
    especialidad: cap.especialidad ?? null,
    subusos: (cap.subusos ?? {}) as Record<string, 'no' | 'basico' | 'fuerte'>,
    cap: {
      escritura: cap.escritura,
      investigacion: cap.investigacion,
      codigo: cap.codigo,
      imagenes: cap.imagenes,
      video: cap.video,
      espanol: cap.espanol,
      api: cap.api,
      memoria: cap.memoria,
      voz: cap.voz,
      integraciones: cap.integraciones,
      disponibleMexico: cap.disponibleMexico,
    },
    // null (no 'amarillo' por default) cuando la herramienta todavía no
    // tiene artículo en la serie "Quién entrena con tus datos" — mostrar un
    // veredicto inventado se vería igual que uno verificado, y no lo es.
    privacidad: priv?.data.veredicto ?? null,
  };
});

const totalGeneralistas = TOOLS.filter((t) => t.tipo === 'generalista').length;
const totalEspecialistas = TOOLS.length - totalGeneralistas;

// Preguntas condicionales: afinan el uso que el usuario eligió para separar
// a los especialistas de los generalistas sin alargar el quiz para todos.
// La plantilla vive en src/data/subpreguntas-recomendador.ts (compartida con
// las fichas), pero SOLO se muestra una opción si al menos
// una herramienta tiene ese subuso verificado en el JSON (y una pregunta
// solo si le quedan 2+ opciones) — así la interfaz nunca ofrece algo que
// los datos no pueden distinguir.
const SUBPREGUNTAS = SUBPREGUNTAS_BASE.map((s) => ({
  uso: s.uso,
  pregunta: s.pregunta,
  opciones: s.opciones.filter((o) => TOOLS.some((t) => t.subusos[o.valor] !== undefined)),
})).filter((s) => s.opciones.length >= 2);

const modifiedTime = capacidades.reduce(
  (max, c) => {
    const fecha = new Date(c.fechaVerificacion);
    return !max || fecha > max ? fecha : max;
  },
  undefined as Date | undefined
);

const title = '¿Qué IA me conviene?';
// Título y descripción con el conteo real (se actualiza solo al crecer el
// JSON) y con lo que distingue a esta herramienta: no es un top 10, cubre
// chats generales y especialistas, y dice por qué recomienda cada cosa.
const tituloPagina = `¿Qué IA me conviene? Compara ${TOOLS.length} herramientas de IA`;
const description = `Compara ${TOOLS.length} herramientas de IA, de chats generales a especialistas en papers, imágenes y video, con 4 preguntas. Gratis, sin registro y con la razón de cada resultado.`;
const canonicalPath = '/que-ia-me-conviene/';

// Preguntas frecuentes: mismo criterio que el resto del sitio — solo lo que
// podemos verificar hoy, citando la fuente. Nada de "la mejor IA es X" sin
// matiz. Las respuestas que dependen de las series del sitio (gratis,
// estudiantes) se arman desde esas colecciones: así no se desfasan cuando
// una serie cambia un veredicto.
const nombreDe = (id: string) => TOOLS.find((t) => t.id === id)?.nombre ?? id;
const lista = (nombres: string[]) =>
  nombres.length > 1 ? `${nombres.slice(0, -1).join(', ')} y ${nombres[nombres.length - 1]}` : nombres.join('');
const porVeredicto = (coleccion: { data: { herramientaId: string; veredicto: string } }[], veredicto: string) =>
  TOOLS.filter((t) => coleccion.find((p) => p.data.herramientaId === t.id)?.data.veredicto === veredicto).map(
    (t) => t.nombre
  );

const sinTarjeta = porVeredicto(pruebaGratisSerie, 'verde');
const dependenPrueba = porVeredicto(pruebaGratisSerie, 'amarillo');
const estudiantesVerde = porVeredicto(estudiantesSerie, 'verde');
const estudiantesAmarillo = porVeredicto(estudiantesSerie, 'amarillo');
const estudiantesRojo = porVeredicto(estudiantesSerie, 'rojo');

const faqs: { q: string; a: string; fuente?: { texto: string; url: string } }[] = [
  {
    q: '¿Qué IA es mejor para escribir?',
    a: 'No hay una sola "mejor" — depende de la tarea. En una prueba ciega independiente con 134 participantes (no es un estudio académico ni nuestro — tómalo como una señal, no una verdad absoluta), Claude ganó 4 de 8 rondas, incluida la de simplificación (71% de los votos) y una de escritura creativa (62%); ChatGPT ganó la ronda de análisis estratégico de negocio (53%); Gemini ganó 3 de 8 rondas, descrito ahí como "el generalista que nunca es la peor opción" — el artículo no explica por qué ganó esas rondas específicas. Usa el recomendador de arriba para ver tu compatibilidad exacta según lo que vas a escribir.',
    fuente: {
      texto: 'Fuente: "ChatGPT vs Claude vs Gemini Compared", Product with Attitude, 22 de febrero de 2026',
      url: 'https://aiblewmymind.substack.com/p/chatgpt-vs-claude-vs-gemini-compared',
    },
  },
  {
    q: '¿Qué IA usar para programar?',
    a: 'En el leaderboard de SWE-bench Verified de BenchLM (actualizado el 27 de octubre de 2026, con 112 modelos), los tres primeros lugares son de Claude —Opus 5 con 96%, Mythos 5 con 95.5% y Fable 5 con 95%—, el mejor modelo de OpenAI de esa tabla, GPT-5.3 Codex, queda noveno con 85%, y ningún modelo de Gemini aparece entre los diez primeros. Ojo: la propia página advierte que ese benchmark está "contaminado y saturado" y que los puntajes reportados por cada empresa pueden usar agentes y presupuestos distintos, así que tómalo como una señal de quién está arriba, no como una tabla exacta. Si programas todos los días dentro de un editor, GitHub Copilot y Kimi Code son herramientas de programación dedicadas, no un chat de propósito general.',
    fuente: {
      texto: 'Fuente: leaderboard SWE-bench Verified, BenchLM, consultado el 27 de octubre de 2026',
      url: 'https://benchlm.ai/benchmarks/sweVerified',
    },
  },
  {
    q: 'ChatGPT o Claude, ¿cuál elegir?',
    a: 'Depende de para qué. Para código, Claude tiene ventaja medible en los leaderboards públicos de SWE-bench, aunque el margen exacto varía según quién corrió la prueba. Para escribir, en una prueba ciega independiente de 134 participantes, Claude ganó más rondas que ChatGPT —incluida una de escritura creativa—, pero ChatGPT ganó la ronda de análisis estratégico de negocio: no es que uno "escriba mejor" en general, ganan en tareas distintas. Para imágenes, ChatGPT tiende a ganar en realismo según pruebas comparativas, y Claude no genera imágenes. Para privacidad, ninguno gana: ambos entrenan con tus datos por default hoy, según nuestra serie de privacidad verificada. Corre el recomendador de arriba con tu caso específico para un número, no una opinión.',
    fuente: {
      texto: 'Fuente de la prueba de escritura: Product with Attitude, 22 de febrero de 2026',
      url: 'https://aiblewmymind.substack.com/p/chatgpt-vs-claude-vs-gemini-compared',
    },
  },
  {
    q: '¿Cuál es la mejor IA gratis?',
    a: `Depende de qué entiendas por gratis, y casi nunca es lo mismo que "sin tarjeta". Según nuestra serie "Prueba gratis sin tarjeta" (verificada herramienta por herramienta para México), ${lista(sinTarjeta) || 'Ninguna'} se pueden empezar a usar sin tarjeta${
      dependenPrueba.length ? `; ${lista(dependenPrueba)} dependen del plan, la región o la promoción` : ''
    }. En las demás, probar el plan de pago pide tarjeta desde el inicio o simplemente no se ofrece, aunque tengan un nivel gratuito limitado. DeepSeek y Meta AI, además, no tienen plan de pago para el público general en México, según nuestra serie de precios.`,
    fuente: { texto: 'Serie: Prueba gratis sin tarjeta', url: '/prueba-gratis-sin-tarjeta/' },
  },
  {
    q: '¿Cuál es la mejor IA para estudiantes?',
    a: `No la medimos como categoría propia porque la mejor IA para estudiar depende de la tarea —investigar, escribir, programar—, no de ser estudiante: corre el recomendador con lo que vas a hacer. Lo que sí verificamos, para México, es el descuento, en nuestra serie "Descuentos para estudiantes". De las herramientas de este recomendador: aplican en México ${lista(estudiantesVerde) || 'ninguna sin condiciones'}; aplican con condiciones ${lista(estudiantesAmarillo) || 'ninguna'}; y no aplican en México ${lista(estudiantesRojo) || 'ninguna'}. Los detalles y las fechas de vigencia están en cada ficha de la serie.`,
    fuente: { texto: 'Serie: Descuentos para estudiantes', url: '/descuentos-para-estudiantes-ia/' },
  },
  {
    q: '¿Cuál es la mejor IA para investigación?',
    a: 'Depende del tipo de investigación, y por eso el cuestionario te lo pregunta. Para papers académicos con citas verificables, Consensus es un especialista: busca solo en un corpus científico propio (su blog de presentación habla de más de 200 millones de documentos) y cada respuesta enlaza al paper de origen. Para trabajar solo con tus propios documentos, NotebookLM responde anclado en las fuentes que subes. Para información actual de la web, Perplexity nació como motor de búsqueda con citas; Gemini (vía Google) y Grok (vía DeepSearch, con datos de X) también buscan en vivo, y Claude, ChatGPT y Kimi tienen modos de investigación a fondo. Si no afinas el tipo de investigación, varias herramientas empatan: es un empate real, no un descuido.',
    fuente: {
      texto: 'Fuente: "Welcome to Consensus", consensus.app',
      url: 'https://consensus.app/home/blog/welcome-to-consensus/',
    },
  },
  {
    q: '¿Qué IA usar para crear imágenes que pueda usar en un proyecto comercial?',
    a: 'Depende de qué te preocupe. Si quieres un modelo entrenado con material licenciado, Adobe afirma que sus modelos Firefly se entrenaron con contenido licenciado (como Adobe Stock) y de dominio público, y que los diseñó para uso comercial; la indemnización por propiedad intelectual la ofrece solo a clientes empresariales, no a planes individuales. Esa descripción es la de los modelos propios de Adobe, no la de los modelos de socios que Firefly también ofrece. Si necesitas un vector editable (logos, íconos), Recraft exporta SVG y PDF, y Firefly descarga .svg desde texto; un generador de imágenes de píxeles entrega un archivo fijo, no un vector.',
    fuente: {
      texto: 'Fuente: "Nuestro enfoque de IA generativa", Adobe',
      url: 'https://www.adobe.com/ai/overview/firefly/gen-ai-approach.html',
    },
  },
  {
    q: '¿Qué IA usar para video: generar clips, avatares o recortar un video largo?',
    a: 'Son tres trabajos distintos, y por eso el cuestionario pregunta cuál necesitas. Para generar clips desde texto o imagen, Runway es la especialista, y Gemini (con Veo) y Grok (con Imagine) también lo hacen dentro del chat. Para un avatar que habla y para doblar un video completo conservando tu voz y sincronizando los labios, HeyGen es la especialista (más de 175 idiomas y dialectos, con el español entre sus ejemplos). Para sacar clips cortos de un video largo que ya grabaste, OpusClip: no genera video desde cero, parte del tuyo. Cada ficha enlaza a su fuente.',
  },
  {
    q: '¿Cómo decide esta herramienta qué IA me conviene?',
    a: 'No rankeamos "la mejor IA". Calculamos una compatibilidad de 0 a 100 entre tu perfil — para qué la vas a usar (y, si eliges investigar, imágenes o video, qué tipo exacto), qué tan importante es la privacidad, si necesitas español, qué extras quieres — y los datos verificados de cada herramienta. Si con tus respuestas varias herramientas puntúan igual, te lo decimos como empate en vez de escoger una al azar. El desglose exacto está en "¿Por qué me salió esta recomendación?", con el peso y el valor de cada criterio; lo que no pudimos verificar se marca "sin verificar".',
  },
];

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  description,
  url: new URL(canonicalPath, Astro.site).toString(),
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (web browser)',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'MXN',
  },
  publisher: {
    '@type': 'Organization',
    name: 'glitchMentalMX',
    logo: { '@type': 'ImageObject', url: new URL('/og-default.png', Astro.site).toString() },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title={tituloPagina}
  description={description}
  modifiedTime={modifiedTime}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <Breadcrumbs items={[{ name: '¿Qué IA me conviene?' }]} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="container header">
    <p class="eyebrow">Recomendador</p>
    <h1>¿Qué IA me conviene?</h1>
    <p class="sub">
      Hay demasiadas. Tú dime qué necesitas y comparamos {TOOLS.length} herramientas
      contra tu perfil — con la razón detrás de cada número, no un ranking genérico.
    </p>
    <p class="nota">
      {totalEspecialistas > 0
        ? `Cubre ${TOOLS.length} herramientas: ${totalGeneralistas} chats generales y ${totalEspecialistas} especialistas. Todo verificado en fuentes oficiales; iremos sumando más.`
        : `Cubre ${TOOLS.length} herramientas verificadas en fuentes oficiales. Iremos sumando más.`}
    </p>
  </section>

  <section class="container quiz" id="quiz">
    <p class="quiz-meta">4 preguntas · 1 minuto</p>

    <div class="step">
      <p class="step-num">1 / 4</p>
      <h2>¿Para qué la vas a usar? <span class="hint">elige una o varias</span></h2>
      <div class="opciones opciones-check" data-group="usos">
        <button type="button" data-value="escritura">Escribir</button>
        <button type="button" data-value="investigacion">Investigar</button>
        <button type="button" data-value="codigo">Programar</button>
        <button type="button" data-value="imagenes">Crear imágenes</button>
        <button type="button" data-value="video">Crear video</button>
      </div>

      {SUBPREGUNTAS.map((s) => (
        <div class="subpregunta" data-sub-uso={s.uso} hidden>
          <p class="sub-label">{s.pregunta} <span class="hint">opcional · afina el resultado</span></p>
          <div class="opciones opciones-radio" data-group={`sub-${s.uso}`} data-opcional="1">
            {s.opciones.map((o) => (
              <button type="button" data-value={o.valor}>{o.etiqueta}</button>
            ))}
          </div>
        </div>
      ))}
      <p class="sub-nota" id="sub-nota" hidden>Para no alargar el quiz, afinamos solo los dos primeros usos que marcaste.</p>
    </div>

    <div class="step">
      <p class="step-num">2 / 4</p>
      <h2>¿Qué tan importante es la privacidad?</h2>
      <div class="opciones opciones-radio" data-group="privacidad">
        <button type="button" data-value="mucho">Muchísimo</button>
        <button type="button" data-value="algo">Importante</button>
        <button type="button" data-value="no">Me da igual</button>
      </div>
    </div>

    <div class="step">
      <p class="step-num">3 / 4</p>
      <h2>¿Necesitas que sea buena en español?</h2>
      <div class="opciones opciones-radio" data-group="espanol">
        <button type="button" data-value="si">Sí, mucho</button>
        <button type="button" data-value="poco">Un poco</button>
        <button type="button" data-value="no">No es prioridad</button>
      </div>
    </div>

    <div class="step">
      <p class="step-num">4 / 4</p>
      <h2>¿Necesitas algo específico? <span class="hint">opcional</span></h2>
      <div class="opciones opciones-check" data-group="extras">
        <button type="button" data-value="api">API</button>
        <button type="button" data-value="memoria">Memoria entre conversaciones</button>
        <button type="button" data-value="voz">Modo de voz</button>
        <button type="button" data-value="integraciones">Integraciones</button>
        <button type="button" data-value="disponibleMexico">Disponible en México</button>
      </div>
    </div>

    <button type="button" id="ver-resultado" class="cta-primary">Ver mi recomendación →</button>
  </section>

  <section class="container resultado" id="resultado" hidden></section>

  <section class="container faq">
    <p class="eyebrow">Preguntas frecuentes</p>
    <h2>Antes de que preguntes</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.fuente && (
            <a
              class="faq-fuente"
              href={f.fuente.url}
              {...(f.fuente.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer nofollow' } : {})}
            >
              {f.fuente.texto} →
            </a>
          )}
        </details>
      ))}
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ TOOLS, SUBPREGUNTAS }}>
  (function () {
    var DIMENSIONES_USO = ['escritura', 'investigacion', 'codigo', 'imagenes', 'video'];
    var EXTRAS = ['api', 'memoria', 'voz', 'integraciones', 'disponibleMexico'];
    var MAX_SUBPREGUNTAS = 2;
    var PESO_SUBUSO = 8;
    var MAX_COMPARADOR = 8;
    var MIN_COMPARADOR = 6;
    var LABELS = {
      escritura: 'Escritura',
      investigacion: 'Investigación',
      codigo: 'Código',
      imagenes: 'Imágenes',
      video: 'Video',
      espanol: 'Español',
      privacidad: 'Privacidad',
      api: 'API',
      memoria: 'Memoria',
      voz: 'Modo de voz',
      integraciones: 'Integraciones',
      disponibleMexico: 'Disponible en México',
    };
    var NIVEL_VALOR = { fuerte: 100, basico: 55, no: 10 };
    var VEREDICTO_VALOR = { verde: 100, amarillo: 55, rojo: 10 };
    var NIVEL_ICONO = { fuerte: '✓', basico: '~', no: '✕' };
    var NIVEL_CLASE = { fuerte: 'up', basico: 'warn', no: 'down' };
    var VALOR_NEUTRAL = 55;

    var SUB_CORTA = {};
    SUBPREGUNTAS.forEach(function (s) {
      s.opciones.forEach(function (o) { SUB_CORTA[s.uso + ':' + o.valor] = o.corta; });
    });

    document.querySelectorAll('[data-group]').forEach(function (group) {
      var isRadio = group.classList.contains('opciones-radio');
      var opcional = group.getAttribute('data-opcional') === '1';
      group.querySelectorAll('button').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (isRadio) {
            var yaSeleccionado = btn.classList.contains('selected');
            group.querySelectorAll('button').forEach(function (b) { b.classList.remove('selected'); });
            if (!(opcional && yaSeleccionado)) btn.classList.add('selected');
          } else {
            btn.classList.toggle('selected');
          }
          if (group.getAttribute('data-group') === 'usos') actualizarSubpreguntas();
        });
      });
    });

    // Muestra la pregunta de afinación de cada uso marcado (máximo dos, en el
    // orden del quiz) y limpia las respuestas de las que se ocultan.
    function actualizarSubpreguntas() {
      var usos = Array.from(document.querySelectorAll('[data-group="usos"] .selected')).map(function (b) { return b.dataset.value; });
      var visibles = 0;
      var omitidas = false;
      document.querySelectorAll('.subpregunta').forEach(function (bloque) {
        var uso = bloque.getAttribute('data-sub-uso');
        var marcado = usos.indexOf(uso) !== -1;
        var mostrar = marcado && visibles < MAX_SUBPREGUNTAS;
        if (marcado && !mostrar) omitidas = true;
        if (mostrar) visibles++;
        bloque.hidden = !mostrar;
        if (!mostrar) {
          bloque.querySelectorAll('button.selected').forEach(function (b) { b.classList.remove('selected'); });
        }
      });
      var nota = document.getElementById('sub-nota');
      if (nota) nota.hidden = !omitidas;
    }

    // Nivel de una herramienta en un subuso. Verificado = hay dato en el JSON,
    // o la herramienta ni ofrece el uso padre (entonces es "no"). Todo lo
    // demás es neutral y se etiqueta "sin verificar": no se asume ni a favor
    // ni en contra.
    function nivelSubuso(tool, uso, sub) {
      var explicito = tool.subusos[sub];
      if (explicito) return { nivel: explicito, valor: NIVEL_VALOR[explicito], verificado: true };
      if (tool.cap[uso] === 'no') return { nivel: 'no', valor: NIVEL_VALOR.no, verificado: true };
      return { nivel: null, valor: VALOR_NEUTRAL, verificado: false };
    }

    function calcular(respuestas) {
      var pesos = {};
      var subs = respuestas.subs || [];
      var usosSeleccionados = respuestas.usos.size ? Array.from(respuestas.usos) : DIMENSIONES_USO;
      var pesoUsoBase = respuestas.usos.size ? 10 : 5;
      DIMENSIONES_USO.forEach(function (d) {
        pesos[d] = usosSeleccionados.indexOf(d) !== -1 ? pesoUsoBase : 0;
      });
      pesos.privacidad = { mucho: 10, algo: 5, no: 0 }[respuestas.privacidad] || 0;
      pesos.espanol = { si: 10, poco: 5, no: 0 }[respuestas.espanol] || 0;
      EXTRAS.forEach(function (e) {
        pesos[e] = respuestas.extras.has(e) ? 6 : 0;
      });

      var pesoTotal = Object.keys(pesos).reduce(function (acc, k) { return acc + pesos[k]; }, 0) + subs.length * PESO_SUBUSO || 1;

      var resultados = TOOLS.map(function (tool) {
        var detalle = [];
        var acumulado = 0;
        DIMENSIONES_USO.forEach(function (d) {
          if (pesos[d] > 0) {
            var valor = NIVEL_VALOR[tool.cap[d]];
            acumulado += pesos[d] * valor;
            detalle.push({ criterio: LABELS[d], peso: pesos[d], valor: valor, verificado: true });
          }
        });
        subs.forEach(function (s) {
          var n = nivelSubuso(tool, s.uso, s.valor);
          acumulado += PESO_SUBUSO * n.valor;
          detalle.push({
            criterio: LABELS[s.uso] + ' · ' + SUB_CORTA[s.uso + ':' + s.valor],
            peso: PESO_SUBUSO,
            valor: n.valor,
            verificado: n.verificado,
          });
        });
        if (pesos.privacidad > 0) {
          // Sin verificar (aún no hay artículo de "quién entrena con tus
          // datos" para esta herramienta): cuenta neutral en el número para
          // no penalizarla ni favorecerla, pero se marca para que no se vea
          // como un dato verificado que no es.
          var privVerificada = tool.privacidad !== null;
          var valorPriv = privVerificada ? VEREDICTO_VALOR[tool.privacidad] : VALOR_NEUTRAL;
          acumulado += pesos.privacidad * valorPriv;
          detalle.push({ criterio: 'Privacidad', peso: pesos.privacidad, valor: valorPriv, verificado: privVerificada });
        }
        if (pesos.espanol > 0) {
          var valorEsp = NIVEL_VALOR[tool.cap.espanol];
          acumulado += pesos.espanol * valorEsp;
          detalle.push({ criterio: 'Español', peso: pesos.espanol, valor: valorEsp, verificado: true });
        }
        EXTRAS.forEach(function (e) {
          if (pesos[e] > 0) {
            var valorExtra = tool.cap[e] ? 100 : 0;
            acumulado += pesos[e] * valorExtra;
            detalle.push({ criterio: LABELS[e], peso: pesos[e], valor: valorExtra, verificado: true });
          }
        });
        return { tool: tool, score: Math.round(acumulado / pesoTotal), detalle: detalle, pesoTotal: pesoTotal };
      });

      resultados.sort(function (a, b) { return b.score - a.score; });
      return resultados;
    }

    function compatLabel(score) {
      if (score >= 80) return 'Muy buena compatibilidad';
      if (score >= 60) return 'Buena compatibilidad';
      if (score >= 40) return 'Compatibilidad parcial';
      return 'Compatibilidad baja';
    }

    function enlaceFicha(tool) {
      return '<a href="/que-ia-me-conviene/' + tool.id + '/">' + tool.nombre + '</a>';
    }

    function celdaValor(d) {
      return d.valor + (d.verificado ? '' : ' <span class="sv">sin verificar</span>');
    }

    function tablaComparador(lista, respuestas) {
      var ejes = ['escritura', 'investigacion', 'codigo', 'imagenes', 'video', 'espanol'];
      var filas = ejes.map(function (eje) {
        var celdas = lista
          .map(function (r) {
            var nivel = r.tool.cap[eje];
            return '<td class="ico-' + NIVEL_CLASE[nivel] + '">' + NIVEL_ICONO[nivel] + '</td>';
          })
          .join('');
        return '<tr><td>' + LABELS[eje] + '</td>' + celdas + '</tr>';
      }).join('');
      var filasSub = (respuestas.subs || []).map(function (s) {
        var celdas = lista
          .map(function (r) {
            var n = nivelSubuso(r.tool, s.uso, s.valor);
            if (!n.verificado) return '<td class="ico-nd" title="Sin verificar">–</td>';
            return '<td class="ico-' + NIVEL_CLASE[n.nivel] + '">' + NIVEL_ICONO[n.nivel] + '</td>';
          })
          .join('');
        return '<tr class="sub-row"><td>' + LABELS[s.uso] + ' · ' + SUB_CORTA[s.uso + ':' + s.valor] + '</td>' + celdas + '</tr>';
      }).join('');
      var head = lista.map(function (r) { return '<th>' + enlaceFicha(r.tool) + '</th>'; }).join('');
      var scoreRow = lista.map(function (r) { return '<td>' + r.score + '/100</td>'; }).join('');
      return (
        '<table class="comp-table"><thead><tr><th></th>' + head + '</tr></thead><tbody>' +
        '<tr class="score-row"><td>Compatibilidad contigo</td>' + scoreRow + '</tr>' +
        filas + filasSub + '</tbody></table>'
      );
    }

    function especialidadHTML(tool) {
      if (tool.tipo !== 'especialista' || !tool.especialidad) return '';
      return '<p class="especialidad">Especialista · ' + tool.especialidad + '</p>';
    }

    function render(resultados, respuestas) {
      var cont = document.getElementById('resultado');
      var topScore = resultados[0].score;
      var empatados = resultados.filter(function (r) { return r.score === topScore; });
      var cuantos = Math.min(Math.max(MIN_COMPARADOR, empatados.length), MAX_COMPARADOR);
      var lista = resultados.slice(0, cuantos);
      var notaComparador = cuantos < resultados.length
        ? '<p class="comp-nota">Mostramos las ' + cuantos + ' con mejor compatibilidad de ' + resultados.length + '. Todas tienen su ficha.</p>'
        : '';
      var comparador =
        '<div class="comparador"><p class="comp-label">Comparación</p>' + tablaComparador(lista, respuestas) + notaComparador + '</div>';
      var reset = '<button type="button" id="qic-reset" class="qic-reset-link">Volver a hacer el recomendador</button>';
      var html;

      if (empatados.length === 1) {
        var top = resultados[0];
        // "También podrías considerar": el siguiente grupo de puntaje completo
        // (en orden alfabético, no por posición en el JSON), hasta 4. Si el
        // primer grupo trae solo una, se suma el que sigue.
        var otras = [];
        var i = 1;
        while (i < resultados.length && otras.length < 2) {
          var puntaje = resultados[i].score;
          var grupo = resultados
            .filter(function (r) { return r.score === puntaje; })
            .sort(function (a, b) { return a.tool.nombre.localeCompare(b.tool.nombre, 'es'); });
          otras = otras.concat(grupo.slice(0, 4 - otras.length));
          i += grupo.length;
        }

        var bullets = top.detalle
          .filter(function (d) { return d.peso > 0; })
          .map(function (d) {
            var clase = d.valor >= 80 ? 'up' : d.valor >= 45 ? 'warn' : 'down';
            var icono = d.valor >= 80 ? '✓' : d.valor >= 45 ? '~' : '✕';
            return '<li class="' + clase + '">' + icono + ' ' + d.criterio + (d.verificado ? '' : ' <span class="sv">sin verificar</span>') + '</li>';
          })
          .join('');

        var filasTabla = top.detalle
          .map(function (d) {
            return '<tr><td>' + d.criterio + '</td><td>' + Math.round((d.peso / top.pesoTotal) * 100) + '%</td><td>' + celdaValor(d) + '</td></tr>';
          })
          .join('');

        var otrasHTML = otras
          .map(function (r) {
            return '<div class="otra-opcion"><p class="otra-nombre">' + enlaceFicha(r.tool) + ' — ' + r.score + '/100</p></div>';
          })
          .join('');

        html =
          '<p class="eyebrow">Tu mejor opción</p>' +
          '<h2>' + enlaceFicha(top.tool) + '</h2>' +
          especialidadHTML(top.tool) +
          '<p class="score">' + top.score + '/100 — ' + compatLabel(top.score) + '</p>' +
          '<ul class="bullets">' + bullets + '</ul>' +
          '<details class="por-que"><summary>¿Por qué me salió esta recomendación?</summary>' +
          '<table><thead><tr><th>Criterio</th><th>Peso</th><th>' + top.tool.nombre + '</th></tr></thead><tbody>' + filasTabla + '</tbody></table></details>' +
          (otrasHTML ? '<div class="otras-opciones"><p class="otras-label">También podrías considerar</p>' + otrasHTML + '</div>' : '') +
          comparador + reset;
      } else {
        // Empate real: con los datos verificados no hay forma honesta de
        // preferir una. Se muestran todas (orden alfabético, sin jerarquía).
        var tied = empatados.slice().sort(function (a, b) { return a.tool.nombre.localeCompare(b.tool.nombre, 'es'); });
        var tablaTied = tied.slice(0, 5);
        var base = tablaTied[0];
        var encabezados = tablaTied.map(function (r) { return '<th>' + r.tool.nombre + '</th>'; }).join('');
        var filasEmpate = base.detalle
          .map(function (d, i) {
            var celdas = tablaTied.map(function (r) { return '<td>' + celdaValor(r.detalle[i]) + '</td>'; }).join('');
            return '<tr><td>' + d.criterio + '</td><td>' + Math.round((d.peso / base.pesoTotal) * 100) + '%</td>' + celdas + '</tr>';
          })
          .join('');
        var listaTied = tied
          .map(function (r) {
            var esp = r.tool.tipo === 'especialista' && r.tool.especialidad ? ' <span class="tipo">· Especialista: ' + r.tool.especialidad + '</span>' : '';
            return '<li>' + enlaceFicha(r.tool) + esp + '</li>';
          })
          .join('');
        var pista = respuestas.afinarPendiente
          ? '<p class="empate-dek">Afinar el tipo de uso en el cuestionario suele desempatar. <a href="#quiz">Volver al cuestionario</a></p>'
          : '';

        html =
          '<p class="eyebrow">Empate</p>' +
          '<h2>' + empatados.length + ' herramientas puntúan igual</h2>' +
          '<p class="score">' + topScore + '/100 — ' + compatLabel(topScore) + '</p>' +
          '<p class="empate-dek">Con lo que respondiste no hay una diferencia verificada entre ellas, y no vamos a escoger una al azar. Van en orden alfabético, no de preferencia.</p>' +
          pista +
          '<ul class="empatados">' + listaTied + '</ul>' +
          '<details class="por-que"><summary>¿Por qué empatan?</summary>' +
          '<table><thead><tr><th>Criterio</th><th>Peso</th>' + encabezados + '</tr></thead><tbody>' + filasEmpate + '</tbody></table>' +
          (tied.length > 5 ? '<p class="comp-nota">Mostramos 5 de las ' + tied.length + ' que empatan.</p>' : '') +
          '</details>' +
          comparador + reset;
      }

      cont.innerHTML = html;
      cont.hidden = false;
      cont.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // El botón se crea de nuevo en cada render (va dentro del innerHTML de
      // arriba), así que el listener se vuelve a enganchar cada vez — no hay
      // riesgo de duplicarlo porque el botón anterior ya no existe en el DOM.
      document.getElementById('qic-reset').addEventListener('click', function () {
        document.querySelectorAll('[data-group] button.selected').forEach(function (b) {
          b.classList.remove('selected');
        });
        actualizarSubpreguntas();
        cont.hidden = true;
        cont.innerHTML = '';
        document.getElementById('quiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    document.getElementById('ver-resultado').addEventListener('click', function () {
      var usos = new Set(
        Array.from(document.querySelectorAll('[data-group="usos"] .selected')).map(function (b) { return b.dataset.value; })
      );
      var extras = new Set(
        Array.from(document.querySelectorAll('[data-group="extras"] .selected')).map(function (b) { return b.dataset.value; })
      );
      var privBtn = document.querySelector('[data-group="privacidad"] .selected');
      var espBtn = document.querySelector('[data-group="espanol"] .selected');
      var subs = [];
      var afinarPendiente = false;
      document.querySelectorAll('.subpregunta').forEach(function (bloque) {
        if (bloque.hidden) return;
        var sel = bloque.querySelector('button.selected');
        if (sel) subs.push({ uso: bloque.getAttribute('data-sub-uso'), valor: sel.dataset.value });
        else afinarPendiente = true;
      });
      var respuestas = {
        usos: usos,
        extras: extras,
        subs: subs,
        afinarPendiente: afinarPendiente,
        privacidad: privBtn ? privBtn.dataset.value : 'no',
        espanol: espBtn ? espBtn.dataset.value : 'no',
      };
      render(calcular(respuestas), respuestas);
    });
  })();
</script>

<style>
  .header { padding: 56px 24px 8px; max-width: 700px; }
  .header h1 { font-size: clamp(2rem, 4vw, 2.6rem); margin: 10px 0 12px; }
  .eyebrow { font-family: var(--font-mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); }
  .sub { color: var(--text-muted); font-size: 1.05rem; line-height: 1.6; }
  .nota { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-faint); margin-top: 8px; }

  .quiz { max-width: 700px; padding: 32px 24px 56px; display: flex; flex-direction: column; gap: 36px; }
  .quiz-meta {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    color: var(--text-faint); font-family: var(--font-mono); font-size: 0.8rem;
    margin: 0 0 -12px;
  }
  .step-num {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 1.2px;
    color: var(--accent); text-transform: uppercase; margin: 0 0 8px;
  }
  /* Mismo cuerpo tipográfico que Detox de IA (--font-body, no serif ni
     mono) en pregunta y pills — la serie de tests del sitio usa una sola
     tipografía consistente, no la de titulares editoriales. */
  .step h2 { font-family: var(--font-body); font-weight: 600; font-size: 1.15rem; margin: 0 0 14px; }
  .hint { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-faint); text-transform: none; letter-spacing: 0; font-weight: 400; }

  .opciones { display: flex; flex-wrap: wrap; gap: 10px; }
  .opciones button {
    font-family: var(--font-body); font-size: 0.88rem;
    padding: 10px 16px; border-radius: 999px;
    border: 1px solid var(--border); background: var(--bg-elevated); color: var(--text);
    cursor: pointer;
  }
  .opciones button:hover { border-color: var(--accent); }
  .opciones button.selected { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }

  /* Preguntas de afinación (condicionales al uso marcado en el paso 1). */
  .subpregunta { margin-top: 22px; padding-left: 16px; border-left: 2px solid var(--border); }
  .sub-label { font-family: var(--font-body); font-weight: 600; font-size: 0.95rem; margin: 0 0 12px; }
  .sub-nota { font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-faint); margin: 16px 0 0; }

  .cta-primary {
    align-self: flex-start;
    font-family: var(--font-mono); font-size: 0.95rem; font-weight: 600;
    padding: 14px 26px; border-radius: 999px; border: none;
    background: var(--accent); color: var(--accent-ink); cursor: pointer;
  }
  .cta-primary:hover { opacity: 0.9; }

  /* Todo lo de aquí en adelante vive dentro de #resultado, que Astro llena
     con innerHTML desde el <script> del cliente. Ese HTML nunca recibe el
     atributo data-astro-cid- del scoping de Astro, así que estas reglas
     tienen que ser :global() o simplemente no aplican. */
  .resultado { max-width: 700px; padding: 0 24px 72px; border-top: 1px solid var(--border); }
  :global(#resultado .eyebrow) { margin-top: 32px; }
  :global(#resultado h2) { font-family: var(--font-display); font-size: 2rem; margin: 8px 0 4px; }
  :global(#resultado h2 a) { color: var(--text); }
  :global(#resultado .score) { font-family: var(--font-mono); color: var(--accent); font-size: 1.1rem; margin: 0 0 18px; }

  :global(#resultado .bullets) { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  :global(#resultado .bullets li) { font-size: 0.95rem; padding: 8px 12px; border-radius: var(--radius-sm); background: var(--bg-inset); }
  :global(#resultado .bullets li.up) { color: var(--up-line); }
  :global(#resultado .bullets li.warn) { color: var(--warn-line); }
  :global(#resultado .bullets li.down) { color: var(--down-line); }

  :global(#resultado .por-que) { margin: 0 0 28px; }
  :global(#resultado .por-que summary) { font-family: var(--font-mono); font-size: 0.88rem; color: var(--accent); cursor: pointer; }
  :global(#resultado .por-que table) { width: 100%; border-collapse: collapse; margin-top: 14px; font-size: 0.88rem; }
  :global(#resultado .por-que th), :global(#resultado .por-que td) { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); }
  :global(#resultado .por-que th) { color: var(--text-faint); font-family: var(--font-mono); font-weight: 500; font-size: 0.75rem; text-transform: uppercase; }

  :global(#resultado .otras-opciones) { margin: 0 0 32px; padding-top: 20px; border-top: 1px solid var(--border); }
  :global(#resultado .otras-label) { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; color: var(--text-faint); margin-bottom: 10px; }
  :global(#resultado .otra-opcion) { padding: 8px 0; }
  :global(#resultado .otra-nombre) { margin: 0; }
  :global(#resultado .otra-nombre a) { color: var(--text); font-family: var(--font-display); font-size: 1.05rem; }

  :global(#resultado .comparador) { padding-top: 20px; border-top: 1px solid var(--border); overflow-x: auto; }
  :global(#resultado .comp-label) { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; color: var(--text-faint); margin-bottom: 14px; }
  :global(#resultado .comp-table) { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  :global(#resultado .comp-table th), :global(#resultado .comp-table td) { padding: 10px; text-align: center; border-bottom: 1px solid var(--border); }
  :global(#resultado .comp-table th:first-child), :global(#resultado .comp-table td:first-child) { text-align: left; }
  :global(#resultado .comp-table th a) { color: var(--text); font-family: var(--font-display); }
  :global(#resultado .comp-table .score-row td) { font-family: var(--font-mono); font-weight: 600; color: var(--accent); }
  :global(#resultado .comp-table .ico-up) { color: var(--up-line); }
  :global(#resultado .comp-table .ico-warn) { color: var(--warn-line); }
  :global(#resultado .comp-table .ico-down) { color: var(--down-line); }
  :global(#resultado .comp-table .ico-nd) { color: var(--text-faint); }
  :global(#resultado .comp-table .sub-row td:first-child) { color: var(--text-muted); font-size: 0.84rem; }
  :global(#resultado .comp-nota) { font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-faint); margin: 12px 0 0; }

  :global(#resultado .especialidad) { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); margin: 0 0 10px; }
  :global(#resultado .empate-dek) { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 14px; }
  :global(#resultado .empate-dek a) { color: var(--accent); }
  :global(#resultado .empatados) { list-style: none; margin: 0 0 22px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  :global(#resultado .empatados li) { padding: 10px 14px; border-radius: var(--radius-sm); background: var(--bg-inset); }
  :global(#resultado .empatados a) { color: var(--text); font-family: var(--font-display); font-size: 1.05rem; }
  :global(#resultado .empatados .tipo) { color: var(--text-muted); font-size: 0.84rem; }
  :global(#resultado .sv) { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-faint); }

  :global(#resultado .qic-reset-link) {
    display: block;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-top: 24px;
    padding: 0;
  }
  :global(#resultado .qic-reset-link:hover) { color: var(--text-muted); }

  .faq { padding: 16px 24px 96px; max-width: 760px; }
  .faq h2 { font-family: var(--font-display); font-size: 1.7rem; margin: 8px 0 24px; }
  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq-item {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 16px 20px;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 1.2em;
    flex-shrink: 0;
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p {
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.65;
    margin: 14px 0 0;
  }
  .faq-fuente {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-top: 10px;
  }
  .faq-fuente:hover { color: var(--accent); }
</style>
