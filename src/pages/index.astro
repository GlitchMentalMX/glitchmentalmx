---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured] = allPosts;

const series = (await getCollection('editorialCollections', ({ data }) => data.kind === 'series')).sort(
  (a, b) => a.data.order - b.data.order
);
const hubs = (await getCollection('editorialCollections', ({ data }) => data.kind === 'hub'))
  .sort((a, b) => a.data.order - b.data.order);
const standaloneHubs = hubs.filter((h) => !h.data.group);
const groupedHubs = hubs.filter((h) => h.data.group);
const groupName = groupedHubs[0]?.data.group ?? 'Recursos educativos';

const insights = (await getCollection('visualInsights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestInsight = insights[0];

const novelasPublicadas = [
  { title: 'Entrenado en Corpus', cover: '/images/novelas/entrenado-en-corpus.jpg' },
  { title: 'Cero Orgánico', cover: '/images/novelas/cero-organico.png' },
];

// Background images for the Explora cards — drop files at these paths to light them up.
const explora = {
  series: '/images/explora/series.jpg',
  colecciones: '/images/explora/explora.jpg',
  recursos: '/images/explora/recursos-educativos.jpg',
};
---

<Layout
  title="glitchmentalMX"
  description="Análisis crítico de inteligencia artificial, tecnología y cultura digital. Sin hype, sin ruido."
>
  <section class="hero container">
    <p class="eyebrow">Publicación independiente · IA, tecnología y cultura digital</p>
    <h1>Entender la tecnología que nos está reescribiendo.</h1>
    <p class="hero-dek">
      Análisis crítico, sin hype ni relaciones públicas disfrazadas de periodismo.
      Escrito para gente que quiere entender qué está pasando de verdad.
    </p>
  </section>

  {featured && (
    <section class="featured container">
      <ArticleCard
        slug={featured.id}
        title={featured.data.title}
        description={featured.data.description}
        pubDate={featured.data.pubDate}
        heroImage={featured.data.heroImage}
        heroImageAlt={featured.data.heroImageAlt}
        body={featured.body}
        variant="featured"
      />
    </section>
  )}

  <section class="explora container">
    <div class="section-head">
      <h2>Explora</h2>
    </div>
    <div class="explora-grid">
      <div class="explora-card" style={`background-image: linear-gradient(180deg, rgba(10,12,16,.15), rgba(10,12,16,.75)), url(${explora.series})`}>
        <a href="/series/" class="card-heading-link">
          <p class="eyebrow">Series Editoriales</p>
        </a>
        <ul class="mini-list">
          {series.map((s) => (
            <li><a href={`/series/${s.id}/`} class:list={{ muted: s.data.status === 'coming-soon' }}>{s.data.title}{s.data.status === 'coming-soon' && <span class="soon-tag"> · Pronto</span>}</a></li>
          ))}
        </ul>
      </div>

      <div class="explora-card" style={`background-image: linear-gradient(180deg, rgba(10,12,16,.15), rgba(10,12,16,.75)), url(${explora.colecciones})`}>
        <a href="/colecciones/" class="card-heading-link">
          <p class="eyebrow">Colecciones</p>
          <h3>Guías por tema</h3>
        </a>
        <ul class="mini-list">
          {standaloneHubs.map((h) => (
            <li><a href={`/colecciones/${h.id}/`}>{h.data.title}</a></li>
          ))}
        </ul>
      </div>

      <div class="explora-card" style={`background-image: linear-gradient(180deg, rgba(10,12,16,.15), rgba(10,12,16,.75)), url(${explora.recursos})`}>
        <a href="/colecciones/" class="card-heading-link">
          <p class="eyebrow">{groupName}</p>
          <h3>Para profundizar</h3>
        </a>
        <ul class="mini-list">
          {groupedHubs.map((h) => (
            <li><a href={`/colecciones/${h.id}/`}>{h.data.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {latestInsight && (
    <section class="insights container">
      <div class="section-head insights-head">
        <h2>Insights Visuales</h2>
        <p class="tagline">Ideas complejas sobre IA, Cultura Digital, algoritmos y redes.<br />Imagen + análisis. Sin relleno.</p>
      </div>
      <a href="/insights-visuales/" class="insight-hero">
        <img src={latestInsight.data.imagen} alt="" loading="lazy" width="1000" height="563" />
      </a>
      <p class="insight-cta"><a href="/insights-visuales/" class="link-accent">Ver todas →</a></p>
    </section>
  )}

  <section class="novelas container">
    <div class="section-head">
      <h2>Novelas</h2>
      <a href="/novelas/" class="link-accent">Conoce todas →</a>
    </div>
    <div class="novelas-row">
      {novelasPublicadas.map((n) => (
        <a href="/novelas/" class="novela-cover-link">
          <img src={n.cover} alt={`Portada de ${n.title}`} loading="lazy" width="140" height="217" />
          <span>{n.title}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="tools container">
    <a href="/indice-glitchmentalmx/" class="tool-card">
      <span class="tag">Índice mensual</span>
      <h3>Índice GlitchMentalMX</h3>
      <p>20 tecnologías B2B rankeadas por adopción real. Sin patrocinadores.</p>
    </a>
    <a href="/glitchsearch/" class="tool-card">
      <span class="tag">Herramienta</span>
      <h3>GlitchSearch</h3>
      <p>Curamos la web antes que tú la leas. Búsqueda con veredicto de IA incluido.</p>
    </a>
    <a href="/calculadora-de-riesgo-de-reemplazo-por-ia-2026/" class="tool-card">
      <span class="tag">Herramienta</span>
      <h3>Calculadora de Riesgo IA</h3>
      <p>Mide qué tan expuesto está tu trabajo a la automatización en 2026.</p>
    </a>
  </section>

  <section class="archivo-cta container">
    <a href="/archivo/" class="archivo-card">
      <h3 class="archivo-title">Archivo Total</h3>
      <p class="archivo-sub">El home es una selección; esto es el catálogo. →</p>
    </a>
  </section>
</Layout>

<style>
  .hero {
    padding: 64px 24px 40px;
    max-width: 760px;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin: 14px 0 18px;
  }
  .hero-dek {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 56ch;
  }

  .featured { padding: 16px 24px 56px; }

  section.explora, section.insights, section.novelas, section.tools, section.archivo-cta {
    padding: 44px 24px;
    border-top: 1px solid var(--border);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 26px;
  }
  .section-head h2 { font-size: 1.4rem; }
  .section-head a { font-size: 0.9rem; font-weight: 600; white-space: nowrap; }

  /* Explora cards */
  .explora-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .explora-card {
    border-radius: var(--radius);
    padding: 24px;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 220px;
    background-color: var(--bg-inset);
    background-size: cover;
    background-position: center;
  }
  .explora-card:hover { outline: 1.5px solid var(--accent); }
  .explora-card .eyebrow { color: rgba(255, 255, 255, 0.75); }
  .explora-card h3 { font-size: 1.15rem; margin: 8px 0 8px; color: #fff; }
  .explora-card .dek { color: rgba(255, 255, 255, 0.85); font-size: 0.86rem; line-height: 1.5; margin: 0; }
  .mini-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mini-list li a {
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
  }
  .mini-list li a:hover { color: #fff; text-decoration: underline; }
  .mini-list li a.muted { color: rgba(255, 255, 255, 0.55); }
  .soon-tag { font-family: var(--font-mono); font-size: 0.72em; text-transform: uppercase; }
  .card-heading-link { display: block; }
  .card-heading-link:hover h3 { text-decoration: underline; }

  /* Insights Visuales — single hero image */
  .insights-head { flex-direction: column; align-items: flex-start; gap: 6px; }
  .tagline { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin: 0; }
  .insight-hero {
    display: block;
    max-width: 900px;
    margin: 0 auto;
  }
  .insight-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .insight-cta { max-width: 900px; margin: 14px auto 0; text-align: right; }

  /* Novelas */
  .novelas-row { display: flex; align-items: flex-start; justify-content: center; gap: 18px; flex-wrap: wrap; }
  .novela-cover-link { color: var(--text); text-align: center; }
  .novela-cover-link img {
    width: 108px;
    height: 168px;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 6px 18px rgba(20, 22, 28, 0.18);
    margin-bottom: 8px;
  }
  .novela-cover-link span { display: block; font-size: 0.82rem; font-weight: 600; max-width: 108px; }
  .novela-cover-link:hover span { color: var(--accent); }

  @media (min-width: 901px) {
    .novela-cover-link img { width: 128px; height: 199px; }
    .novela-cover-link span { max-width: 128px; }
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .tool-card {
    background: var(--bg-inset);
    border-radius: var(--radius);
    padding: 28px;
    color: var(--text);
  }
  .tool-card:hover { outline: 1.5px solid var(--accent); }
  .tool-card h3 { font-size: 1.2rem; margin: 12px 0 8px; }
  .tool-card p { color: var(--text-muted); font-size: 0.9rem; margin: 0; }

  /* Archivo CTA */
  .archivo-cta { padding-bottom: 8px; display: flex; justify-content: center; }
  .archivo-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    width: 100%;
    max-width: 480px;
    background: var(--bg-inset);
    border-radius: var(--radius);
    padding: 22px 24px;
    color: var(--text);
  }
  .archivo-card:hover { outline: 1.5px solid var(--accent); }
  .archivo-title { font-family: var(--font-display); font-size: 1.7rem; font-weight: 600; margin: 0; }
  .archivo-sub { color: var(--text-muted); font-size: 0.92rem; margin: 8px 0 0; }

  @media (max-width: 900px) {
    .explora-grid { grid-template-columns: 1fr; }
    .tools { grid-template-columns: 1fr; }
  }
</style>
