---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PreciosTicker from '../components/PreciosTicker.astro';
import { getCollection, getEntry } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Conteo de la card "IA sin letra chiquita" — se muestran los dos totales
// por separado (no sumados) porque varias herramientas viven en ambas
// colecciones (ChatGPT, Claude, Grammarly, etc.) y no hay una forma barata
// de deduplicar sin una tabla de equivalencias manual entre herramientaId
// de precios-ia y entrenaIA que habría que mantener a mano.
const preciosIAPosts = await getCollection('preciosIA', ({ data }) => !data.draft);
const entrenaIAPosts = await getCollection('entrenaIA', ({ data }) => !data.draft);
const pruebaGratisPosts = await getCollection('pruebaGratis', ({ data }) => !data.draft);
const codigosDescuentoPosts = await getCollection('codigosDescuento', ({ data }) => !data.draft);
const preciosDigitalesPosts = await getCollection('preciosDigitales', ({ data }) => !data.draft);
const preciosCount = preciosIAPosts.length;
const entrenaCount = entrenaIAPosts.length;
const pruebaGratisCount = pruebaGratisPosts.length;
const codigosDescuentoCount = codigosDescuentoPosts.length;
const preciosDigitalesCount = preciosDigitalesPosts.length;

const queIATabla = await getCollection('herramientasIA');
const queIACount = queIATabla[0]?.data.herramientas.length ?? 0;

const [featured] = allPosts;
const recentThree = allPosts.slice(1, 4);

const series = (await getCollection('editorialCollections', ({ data }) => data.kind === 'series')).sort(
  (a, b) => a.data.order - b.data.order
);
const hubs = (await getCollection('editorialCollections', ({ data }) => data.kind === 'hub'))
  .sort((a, b) => a.data.order - b.data.order);
const standaloneHubs = hubs.filter((h) => !h.data.group);
const groupedHubs = hubs.filter((h) => h.data.group);
const groupName = groupedHubs[0]?.data.group ?? 'Recursos educativos';

const insights = (await getCollection('visualInsights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestInsight = insights[0];

const novelasPublicadas = [
  {
    title: 'Entrenado en Corpus',
    genre: 'Tecnothriller',
    cover: '/images/novelas/entrenado-en-corpus.webp',
    desc: 'Una periodista investiga el vínculo entre las grandes tecnológicas y el Vaticano. El modelo de IA que responde sus preguntas opera, al mismo tiempo, en la identificación de blancos militares.',
    buy: 'https://mybook.to/EntrenadoEnCorpus',
  },
  {
    title: 'Cero Orgánico',
    genre: 'Tecnothriller',
    cover: '/images/novelas/cero-organico.webp',
    desc: 'Naia Soler tiene millones de seguidores y contratos de ocho cifras. Detrás de cada publicación, un sistema que la conoce mejor que ella misma. El algoritmo no es caprichoso. Decide.',
    buy: 'https://mybook.to/CeroOrganico',
  },
];

// Explora — cada columna es una lista real de contenido, con una barra
// proporcional al número de artículos de cada serie/colección (dato real,
// no decoración) escalada contra el máximo de su propia columna.
const exploraColumns = [
  {
    eyebrow: 'Series editoriales',
    href: '/series/',
    items: series.map((s) => ({
      href: `/series/${s.id}/`,
      label: s.data.title,
      count: s.data.postSlugs.length,
      soon: s.data.status === 'coming-soon',
    })),
  },
  {
    eyebrow: 'Colecciones',
    subtitle: 'Guías por tema',
    href: '/colecciones/',
    items: standaloneHubs.map((h) => ({
      href: `/colecciones/${h.id}/`,
      label: h.data.title,
      count: h.data.postSlugs.length,
    })),
  },
  {
    eyebrow: groupName,
    subtitle: 'Para profundizar',
    href: '/colecciones/',
    items: groupedHubs.map((h) => ({
      href: `/colecciones/${h.id}/`,
      label: h.data.title,
      count: h.data.postSlugs.length,
    })),
  },
].map((col) => ({
  ...col,
  maxCount: Math.max(...col.items.map((i) => i.count), 1),
}));

// Panel de Señales — reemplaza el grid de cards de "Recursos" por una lista
// de filas más compacta. El orden y el copy siguen el mockup de Jorge; los
// números (queIACount, preciosDigitalesCount, etc.) se calculan arriba a
// partir de las colecciones reales, nunca se escriben a mano.
type PanelRow = {
  href: string;
  title: string;
  desc: string;
  stat: string;
  icon: 'compass' | 'chart' | 'search' | 'gauge' | 'checklist' | 'tag' | 'shield';
  featured?: {
    sublinks: { label: string; href: string }[];
  };
};

const panelRows: PanelRow[] = [
  { href: '/que-ia-me-conviene/', title: '¿Qué IA me conviene?', desc: 'Responde unas preguntas y te decimos qué IA se adapta a lo que necesitas.', stat: `${queIACount} comparadas`, icon: 'compass' },
  {
    href: '/ia-sin-letra-chiquita/',
    title: 'IA sin letra chiquita',
    desc: 'Precios reales actualizados, privacidad, quién entrena su IA con tus datos y si su código de descuento es real.',
    stat: 'Ver comparación',
    icon: 'shield',
    featured: {
      sublinks: [
        { label: 'Precios', href: '/precios-ia/' },
        { label: 'Privacidad', href: '/quien-entrena-con-tus-datos/' },
        { label: 'Pruebas gratis', href: '/prueba-gratis-sin-tarjeta/' },
        { label: 'Descuentos', href: '/codigos-descuento-ia/' },
      ],
    },
  },
  { href: '/calculadora-de-riesgo-de-reemplazo-por-ia-2026/', title: 'Calculadora de Riesgo IA', desc: 'Qué tan expuesto está tu trabajo a la automatización.', stat: '60 segundos', icon: 'gauge' },
  { href: '/detox-de-ia/', title: 'Detox de IA', desc: 'Identifica tus patrones de uso con un test breve. Sin diagnósticos, con fuentes citadas.', stat: '7 preguntas', icon: 'checklist' },
  { href: '/indice-glitchmentalmx/', title: 'Índice glitchMentalMX', desc: '20 tecnologías B2B rankeadas por adopción real. Sin patrocinadores.', stat: 'mensual', icon: 'chart' },
  { href: '/glitchsearch/', title: 'GlitchSearch', desc: 'Curamos la web antes que tú la leas. Búsqueda con veredicto de IA incluido.', stat: 'IA + web curada', icon: 'search' },
  { href: '/precios-digitales/', title: 'Precios Digitales', desc: 'VPNs, antivirus, streaming y otras suscripciones digitales. Cuánto cuestan de verdad en México, sin ángulo de IA.', stat: `${preciosDigitalesCount} servicios`, icon: 'tag' },
];

// Señal en vivo — widget bajo el hero. Nada de imágenes ni carrusel: un solo
// dato a la vez, con datos reales (nunca relleno). Qué ITEM le toca a cada
// categoría se decide en el cliente por ventana de 12h (sin rebuild); el
// ciclo visible entre categorías corre aparte, más rápido, solo mientras el
// visitante está en la página.
const indiceEntry = await getEntry('indiceGlitchmentalmx', 'actual');
const discoverPool = allPosts.slice(4, 20); // evita duplicar Destacado y Coordenadas
// Solo series/colecciones ya terminadas se anuncian en la Señal en vivo —
// una "coming-soon" (como Ingeniería de la Confianza mientras se publica)
// no debe promocionarse todavía. Separadas (no combinadas) para que el
// ciclo muestre una serie Y una colección, no una u otra.
const seriesPool = series.filter((s) => s.data.status !== 'coming-soon');
const hubPool = [...standaloneHubs, ...groupedHubs].filter((h) => h.data.status !== 'coming-soon');

// El texto de "sube/baja" del Índice lo escribe Jorge como párrafo completo,
// no como frase corta — se trunca en un punto de palabra para que el widget
// (que reserva espacio para 2 líneas) nunca lo corte a media palabra.
function truncate(text: string, max = 90): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return `${cut.slice(0, lastSpace > 40 ? lastSpace : max)}…`;
}

// Las 220+ fichas de "IA sin letra chiquita" (las 4 series) y las 30 de
// Precios Digitales no tenían NINGÚN lugar en el home más allá de una card
// fija de "Recursos" — a diferencia de los posts, nunca rotaban en Señal en
// vivo. Se capan a 40/20 (recientes primero) para no inflar el HTML del
// home con cientos de items que además se actualizan solo cuando se publica
// contenido nuevo.
const iaSinLetraChiquitaPool = [...preciosIAPosts, ...entrenaIAPosts, ...pruebaGratisPosts, ...codigosDescuentoPosts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 40);
const preciosDigitalesPool = [...preciosDigitalesPosts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 20);

const signalPools = {
  destacado: discoverPool.map((p) => ({
    tag: 'Artículo',
    text: p.data.title,
    href: `/articulos/${p.id}/`,
  })),
  iaSinLetraChiquita: iaSinLetraChiquitaPool.map((p) => ({
    tag: 'IA sin letra chiquita',
    text: p.data.title,
    href: `/articulos/${p.id}/`,
  })),
  preciosDigitales: preciosDigitalesPool.map((p) => ({
    tag: 'Precios Digitales',
    text: p.data.title,
    href: `/articulos/${p.id}/`,
  })),
  indiceSube: indiceEntry
    ? [{ tag: 'Índice · Sube', text: truncate(indiceEntry.data.sube), href: '/indice-glitchmentalmx/' }]
    : [],
  indiceBaja: indiceEntry
    ? [{ tag: 'Índice · Baja', text: truncate(indiceEntry.data.baja), href: '/indice-glitchmentalmx/' }]
    : [],
  serie: seriesPool.map((s) => ({
    tag: 'Serie',
    text: s.data.title,
    href: `/series/${s.id}/`,
  })),
  coleccion: hubPool.map((h) => ({
    tag: 'Colección',
    text: h.data.title,
    href: `/colecciones/${h.id}/`,
  })),
  herramienta: panelRows.map((t) => ({
    tag: 'Recurso',
    text: t.title,
    href: t.href,
  })),
  // Sin página propia en el home (a diferencia de Insights Visuales), así que
  // se queda en el ticker. Slogan fijo en vez de un dato puntual porque no
  // hay dónde enlazar a un dato específico — pendiente reemplazar por un
  // card propio con GlitchMan más adelante.
  datoIncomodo: [
    {
      tag: 'Dato Incómodo',
      text: 'Lo que no te conviene saber... publicado de todas formas.',
      href: '/dato-incomodo/',
    },
  ],
  novela: novelasPublicadas.map((n) => ({
    tag: 'Novela',
    text: `${n.title} — adquiérela en Amazon`,
    href: n.buy,
  })),
};
---

<Layout
  title="glitchMentalMX — Inteligencia artificial, tecnología y cultura digital sin hype"
  description="Análisis crítico de inteligencia artificial, tecnología y cultura digital. Sin hype, sin ruido."
  titleSuffix={false}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
>
  <section class="hero container">
    <p class="eyebrow">Publicación independiente · IA, tecnología y cultura digital</p>
    <h1>Entender la tecnología<br /><span class="accent">que nos está reescribiendo.</span></h1>
    <p class="hero-dek">
      Análisis crítico, sin hype ni relaciones públicas disfrazadas de periodismo.
      Escrito para gente que quiere entender qué está pasando de verdad.
    </p>
  </section>

  <section class="container">
    <a
      href={signalPools.destacado[0]?.href ?? '/archivo/'}
      id="signal-card"
      class="signal-card"
      data-pools={JSON.stringify(signalPools)}
    >
      <span class="signal-meta">
        <span class="signal-live"><span class="dot"></span>Señal<span class="signal-live-full"> en vivo</span></span>
        <span class="signal-tag" id="signal-tag">{signalPools.destacado[0]?.tag ?? 'Archivo'}</span>
      </span>
      <span class="signal-body">
        <span class="signal-text" id="signal-text">{signalPools.destacado[0]?.text ?? 'Explora el archivo completo'}</span>
      </span>
      <span class="signal-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <PreciosTicker />

  {featured && (
    <section class="featured container">
      <h2 class="featured-label">Destacado</h2>
      <ArticleCard
        slug={featured.id}
        title={featured.data.title}
        description={featured.data.description}
        pubDate={featured.data.pubDate}
        heroImage={featured.data.heroImage}
        heroImageAlt={featured.data.heroImageAlt}
        body={featured.body}
        variant="featured"
      />
    </section>
  )}

  <section class="novelas container">
    <div class="section-head novelas-head">
      <div>
        <h2>Además de análisis, ficción</h2>
        <p class="section-sub">Tecnothriller de credibilidad periodística — investigación real, convertida en novela.</p>
      </div>
      <a href="/novelas/" class="link-accent">Ver catálogo completo →</a>
    </div>
    <div class="novelas-grid">
      {novelasPublicadas.map((n) => (
        <div class="novela-card">
          <a href="/novelas/" class="novela-cover-link">
            <img src={n.cover} alt={`Portada de ${n.title}`} loading="lazy" width="200" height="310" />
          </a>
          <div class="novela-body">
            <span class="tag">{n.genre}</span>
            <h3><a href="/novelas/">{n.title}</a></h3>
            <p>{n.desc}</p>
            <a class="link-accent" href={n.buy} target="_blank" rel="noopener">Adquirir →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  {recentThree.length > 0 && (
    <section class="recent container">
      <div class="section-head">
        <h2>Coordenadas</h2>
      </div>
      <div class="recent-rail">
        {recentThree.map((post) => {
          // Encode + comillas: nombres de archivo subidos con espacios o
          // acentos (p. ej. "Cero Orgánico - la novela.webp") rompen un
          // url(...) sin comillas — el navegador corta la URL en el primer
          // espacio y no carga la imagen.
          const bg = `background-image: url('${encodeURI(post.data.heroImage)}')`;
          return (
            <a class="recent-card" href={`/articulos/${post.id}/`} style={bg}>
              <span class="glitch-r" style={bg}></span>
              <span class="glitch-b" style={bg}></span>
              <span class="title">{post.data.title}</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="explora container">
    <div class="section-head explora-head">
      <h2>Explora</h2>
      <p class="section-sub">No son cards bonitas, son datos: cuántos artículos tiene cada serie y colección.</p>
    </div>
    <div class="explora-grid">
      {exploraColumns.map((col) => (
        <div class="explora-panel">
          <a href={col.href} class="panel-head">
            <p class="eyebrow">{col.eyebrow}</p>
            {col.subtitle && <h3>{col.subtitle}</h3>}
          </a>
          <ul class="signal-list">
            {col.items.map((item) => (
              <li>
                <a href={item.href} class:list={{ muted: item.soon }}>
                  <span class="label">{item.label}</span>
                  {item.soon ? (
                    <span class="soon-tag">Pronto</span>
                  ) : (
                    <>
                      <span class="bar-track"><span class="bar-fill" style={`width:${(item.count / col.maxCount) * 100}%`}></span></span>
                      <span class="count">{item.count}</span>
                    </>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {latestInsight && (
    <section class="insights container">
      <div class="section-head insights-head">
        <h2>Insights Visuales</h2>
        <p class="tagline">Una imagen. Una idea. Un momento para pensar.</p>
      </div>
      <a href="/insights-visuales/" class="insight-hero">
        <img src={latestInsight.data.imagen} alt={latestInsight.data.imagenAlt || ''} loading="lazy" width="1000" height="563" />
        {latestInsight.data.punchline && (
          <span class="insight-punchline">{latestInsight.data.punchline}</span>
        )}
      </a>
      <p class="insight-cta"><a href="/insights-visuales/" class="link-accent">Sigue la pista →</a></p>
    </section>
  )}

  <section class="panel-senales container">
    <div class="signals-head">
      <div class="signals-head-text">
        <p class="eyebrow panel-eyebrow">Herramientas</p>
        <h2 class="scramble" data-text="Panel de Señales">Panel de Señales</h2>
        <p class="section-sub">Herramientas de glitchMentalMX para decidir, comparar y entender la tecnología con datos reales.</p>
      </div>
      <div class="panel-sysinfo" aria-hidden="true">
        <p class="sys-line sys-proto">glitchmental://sistema</p>
        <p class="sys-line sys-count"><span class="sys-dot"></span>{panelRows.length} módulos</p>
        <p class="sys-line">Datos · Análisis · Contexto</p>
      </div>
    </div>

    <div class="panel-list">
      {panelRows.map((row) => {
        const icon = (
          <span class="row-icon">
            {row.icon === 'search' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            )}
            {row.icon === 'gauge' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M4 15a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 15L16 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="15" r="1.3" fill="currentColor"/></svg>
            )}
            {row.icon === 'chart' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M5 19V13M12 19V9M19 19V5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {row.icon === 'shield' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {row.icon === 'checklist' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><rect x="5" y="3" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M9 8h6M9 12h6M9 16h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            )}
            {row.icon === 'tag' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M3 11.5V5a2 2 0 0 1 2-2h6.5a2 2 0 0 1 1.41.59l7.5 7.5a2 2 0 0 1 0 2.82l-6.5 6.5a2 2 0 0 1-2.82 0l-7.5-7.5A2 2 0 0 1 3 11.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="8.5" cy="8.5" r="1.3" fill="currentColor"/></svg>
            )}
            {row.icon === 'compass' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M15 9l-2 5-5 2 2-5 5-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            )}
            <span class="row-dot" aria-hidden="true"></span>
          </span>
        );
        const chevron = (
          <span class="row-chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        );

        return row.featured ? (
          <div class="panel-row featured">
            {icon}
            <div class="row-content">
              <div class="row-main">
                <h3 class="row-title-line">
                  <span class="row-title glitch-text" data-text={row.title}>{row.title}</span>
                </h3>
                <p class="row-desc">{row.desc}</p>
              </div>
              <p class="row-sublinks">
                {row.featured.sublinks.map((s, i) => (
                  <>
                    <a href={s.href}>{s.label}</a>
                    {i < row.featured!.sublinks.length - 1 && <span aria-hidden="true"> · </span>}
                  </>
                ))}
              </p>
            </div>
            <span class="row-stat row-cta">{row.stat}</span>
            {chevron}
            <a href={row.href} class="row-stretch" aria-label={`Ver ${row.title}`}></a>
          </div>
        ) : (
          <a href={row.href} class="panel-row">
            {icon}
            <div class="row-main">
              <h3 class="row-title glitch-text" data-text={row.title}>{row.title}</h3>
              <p class="row-desc">{row.desc}</p>
            </div>
            <span class="row-stat">{row.stat}</span>
            {chevron}
          </a>
        );
      })}
    </div>
  </section>

  <section class="dato-incomodo container">
    <a href="/dato-incomodo/" class="dato-card">
      <img src="/images/dato-incomodo/home.webp" alt="Dato Incómodo — lo que no te conviene saber, publicado de todas formas." loading="lazy" width="380" height="214" />
      <span class="link-accent dato-cta">Ábrelo bajo tu propio riesgo →</span>
    </a>
  </section>

  <section class="archivo-cta container">
    <a href="/archivo/" class="archivo-band">
      <span class="archivo-num-group">
        <span class="archivo-num">{allPosts.length}</span>
        <span class="archivo-num-label">artículos publicados</span>
      </span>
      <span class="archivo-text">
        <span class="archivo-title">Archivo Total →</span>
        <span class="archivo-sub">El home es una selección; esto es el catálogo completo.</span>
      </span>
    </a>
  </section>
</Layout>

<style>
  .hero {
    padding: 64px 24px 40px;
    max-width: 760px;
  }
  .hero h1 {
    /* Máximo bajado de 3.4rem a 3.1rem: a 3.4rem, la segunda línea ("que
       nos está reescribiendo.") mide más que el contenedor de 760px en
       cuanto la fuente cae a su respaldo (Georgia/serif) — con
       font-display:optional eso pasa en visitas al azar (caché frío, carga
       lenta), y por eso se veía inconsistente entre navegadores y entre
       una visita y otra. Medido en vivo: con Georgia forzado, 51.7px es el
       límite exacto para que quepa en una sola línea a 760px de ancho;
       3.1rem (49.6px) deja margen real incluso en ese peor caso. */
    font-size: clamp(2.2rem, 5vw, 3.1rem);
    margin: 14px 0 18px;
  }
  /* Cinturón y tirantes: aun con el margen de arriba, que la segunda línea
     nunca pueda partirse en dos — en escritorio siempre son exactamente 2
     líneas, sin importar qué fuente esté activa en ese momento. En móvil
     no aplica: "que nos está reescribiendo." nunca cabe en una sola línea
     ahí, y no se toca ese comportamiento (pedido explícito). */
  @media (min-width: 641px) {
    .hero h1 .accent { white-space: nowrap; }
  }
  .hero-dek {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 56ch;
  }

  /* Señal en vivo — un solo dato a la vez, nunca un carrusel: sin flechas,
     sin puntos de navegación. Altura fija + line-clamp para que el efecto
     de decodificación (o el cambio entre categorías) nunca mueva el layout,
     sin importar qué tan largo sea el texto real de cada categoría. */
  .signal-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 44px 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--text);
    transition: border-color 0.15s ease;
  }
  .signal-card:hover { border-color: var(--accent-line); }
  /* flecha persistente — deja claro que TODO el bloque es un link, no solo
     los ítems con frase larga; independiente del texto para no chocar con
     el truncado ni el line-clamp */
  .signal-arrow {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-faint);
    font-size: 1rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .signal-card:hover .signal-arrow { color: var(--accent); transform: translateY(-50%) translateX(3px); }
  .signal-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }
  .signal-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .signal-live .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--up-line);
    animation: signalPulse 1.8s ease-in-out infinite;
  }
  @keyframes signalPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .signal-live .dot { animation: none; }
  }
  .signal-tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--accent);
    padding-right: 16px;
    border-right: 1px solid var(--border);
    transition: opacity 0.5s ease;
  }
  .signal-body {
    flex: 1;
    min-width: 0;
    height: 2.6em;
    display: flex;
    align-items: center;
  }
  .signal-text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.9rem;
    line-height: 1.3;
    transition: opacity 0.5s ease;
  }
  .signal-tag.is-fading, .signal-text.is-fading { opacity: 0; }
  @media (max-width: 640px) {
    .signal-card { flex-direction: column; align-items: flex-start; gap: 10px; padding: 14px 40px 14px 16px; }
    .signal-live-full { display: none; }
    .signal-tag { padding-right: 0; border-right: none; }
    .signal-body { flex: none; width: 100%; height: 2.6em; }
    .signal-arrow { top: 16px; transform: none; }
    .signal-card:hover .signal-arrow { transform: translateX(3px); }
  }

  .featured { padding: 40px 24px 56px; }
  .featured-label { font-size: 1.4rem; margin: 0 0 18px; }

  section.recent, section.explora, section.insights, section.novelas, section.panel-senales, section.archivo-cta {
    padding: 44px 24px;
    border-top: 1px solid var(--border);
  }

  /* Dato Incómodo — deliberadamente pequeño y "pegado" (leve rotación, como
     un volante), a diferencia de todo lo demás en el home: es la sección
     con menos formalidad del sitio y así se lee de inmediato, sin competir
     con el hero de Insights Visuales ni con el CTA de Archivo Total. */
  /* container query en vez de un ancho fijo: así "100cqi" siempre refleja
     el ancho real disponible en CUALQUIER viewport (no el máximo teórico
     del contenedor), igual que .recent-card lo hace vía flex. */
  .dato-incomodo { container-type: inline-size; padding: 32px 24px; border-top: 1px dashed var(--border); }
  .dato-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    /* misma anchura que una card de Coordenadas en cada punto de quiebre:
       por debajo de 700px esa card es un rail de una sola tarjeta al 78%
       del ancho disponible; de 700px en adelante son 3 columnas iguales
       (espacio disponible menos los dos gaps de 14px, entre 3). */
    max-width: calc(78cqi + 32px);
    margin: 0 auto;
    padding: 16px;
    border-radius: var(--radius);
    background: var(--bg-inset);
    text-align: center;
    transform: rotate(-1.2deg);
    transition: transform 0.15s ease, outline-color 0.15s ease;
    outline: 1px solid transparent;
  }
  .dato-card:hover { transform: rotate(0deg); outline-color: var(--accent); }
  @container (min-width: 700px) {
    /* un poco más grande que una card de Coordenadas (factor 1.25) — en
       desktop el detalle de la imagen lo pide; en móvil se deja igual. */
    .dato-card { max-width: calc(((100cqi - 28px) / 3) * 1.25 + 32px); }
  }
  .dato-card img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .dato-cta { font-size: 0.88rem; }

  /* Recién publicado — horizontal rail, hero image as background, glitch on hover */
  .recent-rail {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding-bottom: 4px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .recent-rail::-webkit-scrollbar { display: none; }
  .recent-card {
    position: relative;
    flex: 0 0 78%;
    height: 150px;
    border-radius: var(--radius);
    overflow: hidden;
    scroll-snap-align: start;
    background-size: cover;
    background-position: center;
    isolation: isolate;
    color: #fff;
  }
  .recent-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 11, 15, 0) 35%, rgba(10, 11, 15, 0.92) 100%);
    z-index: 1;
  }
  .recent-card .title {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
    color: #fff;
  }
  .recent-card .glitch-r,
  .recent-card .glitch-b {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    z-index: 0;
    mix-blend-mode: screen;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .recent-card:hover .glitch-r {
    opacity: 0.55;
    transform: translate(3px, 0);
    filter: saturate(3) hue-rotate(180deg);
  }
  .recent-card:hover .glitch-b {
    opacity: 0.4;
    transform: translate(-3px, 1px);
    filter: saturate(3) hue-rotate(-60deg);
  }
  .recent-card:hover .title { text-decoration: underline; }

  @media (min-width: 700px) {
    .recent-rail { overflow-x: visible; }
    .recent-card { flex: 1 1 0; }
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 26px;
  }
  .section-head h2 { font-size: 1.4rem; }
  .section-head a { font-size: 0.9rem; font-weight: 600; white-space: nowrap; }
  .section-sub { color: var(--text-muted); font-size: 0.92rem; margin: 6px 0 0; }
  .explora-head, .novelas-head { flex-direction: column; align-items: flex-start; gap: 6px; }
  .novelas-head { flex-direction: row; align-items: flex-end; justify-content: space-between; }
  .novelas-head .section-sub { max-width: 46ch; }

  /* Explora — data panels, not photo cards */
  .explora-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .explora-panel {
    border-radius: var(--radius);
    border-top: 2px solid var(--accent);
    padding: 22px 24px 24px;
    background: var(--bg-inset);
  }
  .panel-head { display: block; }
  .panel-head:hover h3 { text-decoration: underline; }
  .panel-head .eyebrow { color: var(--text-muted); margin: 0; }
  .panel-head h3 { font-size: 1.05rem; margin: 6px 0 0; }
  .signal-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .signal-list li a {
    display: grid;
    grid-template-columns: 1fr 56px 22px;
    align-items: center;
    gap: 10px;
    font-size: 0.86rem;
    color: var(--text);
  }
  .signal-list li a:hover .label { color: var(--accent); }
  .signal-list li a.muted { color: var(--text-muted); }
  .signal-list .label { line-height: 1.3; }
  .signal-list .bar-track {
    height: 3px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .signal-list .bar-fill { display: block; height: 100%; background: var(--accent); border-radius: 2px; }
  .signal-list .count { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); text-align: right; }
  .signal-list .soon-tag {
    grid-column: 2 / 4;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    color: var(--text-faint);
    text-align: right;
  }

  /* Insights Visuales — single hero image */
  .insights-head { flex-direction: column; align-items: flex-start; gap: 6px; }
  .tagline { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin: 0; }
  .insight-hero {
    position: relative;
    display: block;
    max-width: 900px;
    margin: 0 auto;
    isolation: isolate;
  }
  .insight-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: var(--radius);
  }
  /* Punchline superpuesto — mismo patrón de gradiente + texto absoluto que
     .recent-card, reutilizado aquí porque la imagen del home ya tiene el
     tamaño para sostenerlo. Se degrada solo: si el insight no trae punchline,
     el ::before no se pinta (scoped al :has) y queda la imagen sola de siempre. */
  .insight-hero:has(.insight-punchline)::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(10, 11, 15, 0) 40%, rgba(10, 11, 15, 0.85) 100%);
    z-index: 1;
  }
  .insight-punchline {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 20px;
    z-index: 2;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 2.6vw, 1.7rem);
    line-height: 1.3;
    color: #fff;
  }
  @media (max-width: 640px) {
    .insight-punchline { left: 16px; right: 16px; bottom: 14px; font-size: 1.05rem; -webkit-line-clamp: 2; }
  }
  .insight-cta { max-width: 900px; margin: 14px auto 0; text-align: right; }

  /* Novelas — protagonista: portada real + sinopsis + CTA de compra */
  .novelas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .novela-card {
    display: flex;
    gap: 22px;
    background: var(--bg-inset);
    border-radius: var(--radius);
    padding: 24px;
  }
  .novela-cover-link { flex-shrink: 0; display: block; }
  .novela-cover-link img {
    width: 108px;
    height: 168px;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
  }
  .novela-body { min-width: 0; }
  .novela-body h3 { font-family: var(--font-display); font-size: 1.25rem; margin: 10px 0 10px; }
  .novela-body h3 a { color: var(--text); }
  .novela-body h3 a:hover { color: var(--accent); }
  .novela-body p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; margin: 0 0 14px; }
  .novela-body .link-accent {
    display: inline-flex;
    align-items: center;
    padding: 0.5em 1.1em;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: transparent;
    transition: color .15s ease;
  }
  .novela-body .link-accent:hover { color: #0052cc; }

  @media (min-width: 901px) {
    .novela-cover-link img { width: 128px; height: 199px; }
  }
  @media (max-width: 700px) {
    .novelas-grid { grid-template-columns: 1fr; }
    .novela-card { flex-direction: column; }
    .novelas-head { flex-direction: column; align-items: flex-start; gap: 12px; }
  }

  /* Panel de Señales — reemplaza el grid de cards de Recursos por una lista
     de filas: más denso verticalmente, y cada fila lee como un dato real
     (métrica a la derecha), no como una tarjeta decorativa. */
  .signals-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }
  .panel-eyebrow { color: var(--accent); margin: 0 0 10px; }
  .signals-head-text h2 { font-size: 2rem; margin-bottom: 10px; }
  .signals-head-text .section-sub { max-width: 52ch; margin: 0; }
  .panel-sysinfo {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    padding-top: 4px;
    text-align: right;
  }
  .sys-line {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .sys-proto { text-transform: none; }
  .sys-count { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 700; }
  .sys-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--accent);
    animation: signalPulse 1.8s ease-in-out infinite;
  }

  .panel-list {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-inset);
    overflow: hidden;
  }
  .panel-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 28px;
    color: var(--text);
  }
  .panel-row:not(:first-child):not(.featured) { border-top: 1px solid var(--border); }
  .panel-row.featured + .panel-row { border-top: none; }
  a.panel-row:hover .row-title { color: var(--accent); }
  a.panel-row:hover .row-chevron { color: var(--accent); transform: translateX(2px); }

  .row-icon {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  /* punto de estado — un solo pulso simple, sin retraso por fila, para que
     todas las filas parpadeen juntas en vez de en cascada (efecto "árbol de
     navidad" que se pidió evitar) */
  .row-dot {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--up-line);
    border: 2px solid var(--bg-inset);
    animation: signalPulse 1.8s ease-in-out infinite;
  }

  .row-main {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 28px;
  }
  .row-title, .row-title-line {
    flex: 0 0 auto;
    width: 220px;
    font-size: 1.05rem;
    margin: 0;
    font-variant-ligatures: none;
  }
  .row-title-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
  .row-desc {
    flex: 1;
    min-width: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.45;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row-stat {
    flex-shrink: 0;
    width: 150px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    letter-spacing: 0.01em;
  }
  .row-chevron {
    flex-shrink: 0;
    display: inline-flex;
    color: var(--text-faint);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  /* fila destacada — borde azul, sin card individual (el resto de la fila
     no es un <a>: tiene sub-enlaces propios, así que el link principal es
     un overlay que cubre la fila y queda debajo de ellos) */
  .panel-row.featured {
    margin: 12px 14px;
    padding: 20px 24px;
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }
  .panel-row.featured .row-title { color: var(--text); width: auto; }
  /* envuelve título+descripción (fila interna) y los sub-enlaces (debajo);
     sustituye a .row-main como hijo flex de .panel-row para que los
     sub-enlaces no compitan por ancho dentro de la misma fila flex */
  .row-content { flex: 1; min-width: 0; }
  /* la descripción de la destacada es más larga que las demás — no se
     recorta a 2 líneas en ningún viewport, la fila simplemente crece.
     display:block (no -webkit-box) porque line-clamp:unset con el truco de
     -webkit-box-orient:vertical todavía activo parte el texto en una
     columna vertical, palabra por palabra. */
  .panel-row.featured .row-desc {
    display: block;
    -webkit-line-clamp: unset;
    -webkit-box-orient: unset;
    overflow: visible;
  }
  .row-sublinks {
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .row-sublinks a {
    position: relative;
    z-index: 2;
    color: var(--accent);
  }
  .row-sublinks a:hover { text-decoration: underline; }
  .row-cta { font-weight: 700; }
  .row-stretch { position: absolute; inset: 0; z-index: 1; }
  .panel-row.featured:hover { border-color: #0052cc; }
  .panel-row.featured:hover .row-cta { text-decoration: underline; }

  /* aberración cromática roja/cian en el nombre al pasar el cursor — mismo
     timing y estilo (steps, text-shadow de dos colores + jitter) que el
     glitch del wordmark del footer; se declara aquí porque los estilos
     <style> de Astro están encapsulados por componente y no se comparten
     entre archivos. */
  .glitch-text { position: relative; }
  @keyframes rowGlitch {
    0%   { text-shadow: none; transform: translateX(0); }
    8%   { text-shadow: -1px 0 var(--down-line), 1px 0 #00d4ff; transform: translateX(-1px); }
    18%  { text-shadow: 1px 0 var(--down-line), -1px 0 #00d4ff; transform: translateX(1px); }
    28%  { text-shadow: -1px 0 var(--down-line), 1px 0 #00d4ff; transform: translateX(0); }
    38%  { text-shadow: none; transform: translateX(0); }
    48%  { text-shadow: 1px 0 var(--down-line), -1px 0 #00d4ff; transform: translateX(0); }
    58%  { text-shadow: -1px 0 var(--down-line), 1px 0 #00d4ff; transform: translateX(-1px); }
    72%  { text-shadow: none; transform: translateX(0); }
    100% { text-shadow: none; }
  }
  .panel-row:hover .glitch-text,
  .panel-row:focus-visible .glitch-text {
    animation: rowGlitch 0.7s steps(1) 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .row-dot, .sys-dot { animation: none; }
    .panel-row:hover .glitch-text, .panel-row:focus-visible .glitch-text { animation: none; }
  }

  @media (max-width: 640px) {
    .signals-head { flex-direction: column; gap: 16px; }
    .panel-sysinfo { display: none; }
    .row-main { flex-direction: column; align-items: flex-start; gap: 4px; }
    .row-title, .row-title-line { width: auto; }
    /* sin recorte en móvil: apilada, la descripción ya no necesita caber en
       la altura de una fila de escritorio, así que se deja crecer entera */
    .row-desc { display: block; -webkit-line-clamp: unset; -webkit-box-orient: unset; overflow: visible; }
    .panel-row { flex-wrap: wrap; align-items: flex-start; padding: 18px 20px; }
    .row-icon { margin-top: 2px; }
    .row-stat {
      width: auto;
      text-align: left;
      order: 3;
      flex-basis: 100%;
      margin-left: 62px;
    }
    .panel-row.featured { margin: 10px; padding: 18px; }
  }

  /* Archivo Total — momento tipográfico, no un banner con caja/botón, para
     que no compita visualmente con el CTA de suscripción del footer justo
     debajo: el dato real (conteo de artículos, calculado en build) hace de
     protagonista en vez de una tarjeta decorativa. */
  .archivo-cta { padding-bottom: 8px; }
  .archivo-band {
    display: flex;
    align-items: center;
    gap: 28px;
    color: var(--text);
  }
  /* el número y su etiqueta van agrupados siempre — así "379 artículos
     publicados" se lee junto sin importar si el layout es fila (desktop)
     o columna (móvil), en vez de que el título se meta entre los dos */
  .archivo-num-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-shrink: 0;
  }
  .archivo-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.2rem, 9vw, 5.4rem);
    line-height: 1;
    color: var(--text);
    transition: color 0.15s ease;
  }
  .archivo-band:hover .archivo-num { color: var(--accent); }
  .archivo-num-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-top: 6px;
  }
  .archivo-text { display: flex; flex-direction: column; gap: 6px; max-width: 46ch; }
  .archivo-title { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; }
  .archivo-sub { color: var(--text-muted); font-size: 0.92rem; line-height: 1.5; }

  @media (max-width: 560px) {
    .archivo-band { flex-direction: column; align-items: flex-start; gap: 14px; }
  }

  @media (max-width: 900px) {
    .explora-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Efecto "decode" en los títulos de Herramientas — se dispara al entrar en
  // el viewport (no en hover), así funciona igual en móvil que en desktop.
  const CHARS = '!<>-_\\/[]{}—=+*^?#01';

  class TextScramble {
    el: HTMLElement;
    frame = 0;
    frameRequest = 0;
    queue: { from: string; to: string; start: number; end: number; char?: string }[] = [];
    resolve: () => void = () => {};

    constructor(el: HTMLElement) {
      this.el = el;
      this.update = this.update.bind(this);
    }

    setText(newText: string) {
      const oldText = this.el.textContent || '';
      const length = Math.max(oldText.length, newText.length);
      const promise = new Promise<void>((resolve) => (this.resolve = resolve));
      this.queue = [];
      for (let i = 0; i < length; i++) {
        const from = oldText[i] || '';
        const to = newText[i] || '';
        const start = Math.floor(Math.random() * 20);
        const end = start + Math.floor(Math.random() * 20) + 10;
        this.queue.push({ from, to, start, end });
      }
      cancelAnimationFrame(this.frameRequest);
      this.frame = 0;
      this.update();
      return promise;
    }

    update() {
      let output = '';
      let complete = 0;
      for (let i = 0; i < this.queue.length; i++) {
        const q = this.queue[i];
        if (this.frame >= q.end) {
          complete++;
          output += q.to;
        } else if (this.frame >= q.start) {
          // Nunca revolver espacios: si se sustituyen por un símbolo, el
          // navegador pierde el punto de salto de línea entre palabras a
          // mitad de la animación y el texto de abajo brinca.
          if (q.to === ' ') {
            output += ' ';
          } else {
            if (!q.char || Math.random() < 0.28) {
              q.char = CHARS[Math.floor(Math.random() * CHARS.length)];
            }
            output += q.char;
          }
        } else {
          output += q.from;
        }
      }
      this.el.textContent = output;
      if (complete === this.queue.length) {
        this.resolve();
      } else {
        this.frameRequest = requestAnimationFrame(this.update);
        this.frame++;
      }
    }
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.scramble');

  if (!reduceMotion && targets.length) {
    const scramblers = new WeakMap<HTMLElement, TextScramble>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const text = el.dataset.text || el.textContent || '';
          let scrambler = scramblers.get(el);
          if (!scrambler) {
            scrambler = new TextScramble(el);
            scramblers.set(el, scrambler);
          }
          scrambler.setText(text);
        });
      },
      { threshold: 0.6 }
    );
    targets.forEach((el) => observer.observe(el));
  }

  // Hero — mismo efecto de decodificación, pero disparado una sola vez al
  // cargar la página, no por IntersectionObserver: al estar pegado arriba,
  // re-disparar cada vez que el usuario sube el scroll se sentiría repetitivo.
  // El scramble del H1 del hero se quitó a propósito (ver PageSpeed: era la
  // causa más probable del Cambios de Diseño Acumulados en escritorio — el
  // set de caracteres de reemplazo incluye símbolos más anchos que letras
  // normales, y en el título más grande y más arriba de la página eso podía
  // empujar una palabra a otra línea a mitad de animación). El intento
  // anterior de congelar la altura del H1 mientras corría no bastó. Se
  // queda el efecto en las cards de Recursos (.scramble) — texto más chico,
  // más abajo, mucho menor riesgo.

  // Señal en vivo — un solo dato a la vez, nunca un carrusel. Qué item le
  // toca a cada categoría se fija por ventana de 12h (mismo cálculo para
  // todos los visitantes, sin necesitar republicar el sitio); el ciclo
  // visible entre categorías es aparte, más rápido, y solo corre mientras
  // el visitante está en la página — se detiene en hover y respeta
  // "reducir movimiento". La altura fija + line-clamp del CSS ya evita
  // saltos de layout aquí, así que no hace falta el truco de medir del hero.
  const signalCard = document.getElementById('signal-card') as HTMLAnchorElement | null;
  if (signalCard) {
    type SignalItem = { tag: string; text: string; href: string };
    let pools: Record<string, SignalItem[]> = {};
    try {
      pools = JSON.parse(signalCard.dataset.pools || '{}');
    } catch {
      pools = {};
    }

    const epoch12h = Math.floor(Date.now() / (12 * 60 * 60 * 1000));
    const pick = (pool?: SignalItem[]) => (pool && pool.length ? pool[epoch12h % pool.length] : null);

    const order = [
      'destacado',
      'indiceSube',
      'serie',
      'herramienta',
      'iaSinLetraChiquita',
      'indiceBaja',
      'coleccion',
      'preciosDigitales',
      'datoIncomodo',
      'novela',
    ];
    const lineup = order
      .map((key) => pick(pools[key]))
      .filter((item): item is SignalItem => !!item);

    const tagEl = document.getElementById('signal-tag');
    const textEl = document.getElementById('signal-text');

    if (lineup.length && tagEl && textEl) {
      let i = 0;

      // Antes usaba TextScramble aquí también — se cambió a un fundido lento
      // (ver CSS de .signal-tag/.signal-text) porque, a diferencia del hero
      // y las cards de Recursos (que revuelven una sola vez), esta pieza se
      // repite cada 5.5s todo el tiempo que el visitante esté en el home —
      // un efecto llamativo constante deja de ser acento y se vuelve ruido.
      // El fundido es puro cambio de opacidad, así que además no puede
      // causar el tipo de salto de layout que sí arriesgaba el scramble.
      function render(item: SignalItem, animate: boolean) {
        const swap = () => {
          tagEl!.textContent = item.tag;
          textEl!.textContent = item.text;
          signalCard!.href = item.href;
        };
        if (animate && !reduceMotion) {
          tagEl!.classList.add('is-fading');
          textEl!.classList.add('is-fading');
          setTimeout(() => {
            swap();
            tagEl!.classList.remove('is-fading');
            textEl!.classList.remove('is-fading');
          }, 500);
        } else {
          swap();
        }
      }

      render(lineup[0], false);

      if (!reduceMotion && lineup.length > 1) {
        let timer: ReturnType<typeof setInterval> | null = null;
        const startCycle = () => {
          timer = setInterval(() => {
            i = (i + 1) % lineup.length;
            render(lineup[i], true);
          }, 5500);
        };
        const stopCycle = () => {
          if (timer) clearInterval(timer);
        };
        startCycle();
        signalCard.addEventListener('mouseenter', stopCycle);
        signalCard.addEventListener('mouseleave', startCycle);
      }
    }
  }
</script>
