---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = allPosts;
const gridPosts = rest.slice(0, 9);

const series = (await getCollection('editorialCollections', ({ data }) => data.kind === 'series')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title="glitchmentalMX"
  description="Análisis crítico de inteligencia artificial, tecnología y cultura digital. Sin hype, sin ruido."
>
  <section class="hero container">
    <p class="eyebrow">Publicación independiente · IA, tecnología y cultura digital</p>
    <h1>Entender la tecnología que nos está reescribiendo.</h1>
    <p class="hero-dek">
      Análisis crítico, sin hype ni relaciones públicas disfrazadas de periodismo.
      Escrito para gente que quiere entender qué está pasando de verdad.
    </p>
  </section>

  {featured && (
    <section class="featured container">
      <ArticleCard
        slug={featured.id}
        title={featured.data.title}
        description={featured.data.description}
        pubDate={featured.data.pubDate}
        heroImage={featured.data.heroImage}
        heroImageAlt={featured.data.heroImageAlt}
        body={featured.body}
        variant="featured"
      />
    </section>
  )}

  <section class="latest container">
    <div class="section-head">
      <h2>Últimos artículos</h2>
      <a href="/archivo/" class="link-accent">Ver todo el archivo →</a>
    </div>
    <div class="grid">
      {gridPosts.map((post) => (
        <ArticleCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          heroImage={post.data.heroImage}
          heroImageAlt={post.data.heroImageAlt}
          body={post.body}
        />
      ))}
    </div>
  </section>

  <section class="series-promo container">
    <div class="section-head">
      <h2>Series editoriales</h2>
      <a href="/series/" class="link-accent">Ver todas →</a>
    </div>
    <div class="series-row">
      {series.map((s) => (
        <a href={`/series/${s.id}/`} class="series-chip" data-status={s.data.status}>
          {s.data.title}
        </a>
      ))}
    </div>
  </section>

  <section class="tools container">
    <a href="/glitchsearch/" class="tool-card">
      <span class="tag">Herramienta</span>
      <h3>GlitchSearch</h3>
      <p>Curamos la web antes que tú la leas. Búsqueda con veredicto de IA incluido.</p>
    </a>
    <a href="/calculadora-de-riesgo-de-reemplazo-por-ia-2026/" class="tool-card">
      <span class="tag">Herramienta</span>
      <h3>Calculadora de Riesgo IA</h3>
      <p>Mide qué tan expuesto está tu trabajo a la automatización en 2026.</p>
    </a>
  </section>
</Layout>

<style>
  .hero {
    padding: 64px 24px 40px;
    max-width: 760px;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin: 14px 0 18px;
  }
  .hero-dek {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 56ch;
  }

  .featured { padding: 16px 24px 56px; }

  .latest, .series-promo, .tools { padding: 40px 24px; }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  .section-head h2 { font-size: 1.5rem; }
  .section-head a { font-size: 0.9rem; font-weight: 600; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 28px;
  }

  .series-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .series-chip {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text);
    transition: border-color .15s ease, color .15s ease;
  }
  .series-chip:hover { border-color: var(--accent); color: var(--accent); }
  .series-chip[data-status='coming-soon'] { opacity: 0.55; }

  .tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .tool-card {
    background: var(--bg-inset);
    border-radius: var(--radius);
    padding: 28px;
    color: var(--text);
  }
  .tool-card:hover { outline: 1.5px solid var(--accent); }
  .tool-card h3 { font-size: 1.3rem; margin: 12px 0 8px; }
  .tool-card p { color: var(--text-muted); font-size: 0.94rem; margin: 0; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .tools { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
