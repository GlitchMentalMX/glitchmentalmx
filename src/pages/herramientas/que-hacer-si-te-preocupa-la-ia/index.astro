---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../../lib/format';
import data from '../../../data/y-ahora-que-hago.json';

const title = '¿Te preocupa la IA? Esto es lo que puedes hacer';
const description =
  'Si te preocupa la inteligencia artificial por tu trabajo o tu futuro: separa riesgo real, ruido y próximos pasos. Gratis, sin cuenta. Fuentes OIT y OMS.';
const toolImage = '/images/herramientas/que-hacer-si-te-preocupa-la-ia.png';
const canonicalPath = '/herramientas/que-hacer-si-te-preocupa-la-ia/';
const alertPath = '/herramientas/que-hacer-si-te-preocupa-la-ia/necesitas-ayuda-ahora/';

// Misma mecánica que Riesgo y Detox: fecha de última revisión en un JSON que
// astro.config.mjs también lee para el lastmod del sitemap.
const lastReviewed = new Date(`${data.lastReviewed}T12:00:00-06:00`);

const { ejes, preocupaciones, fuentes } = data;

// Orden de las preguntas puntuables (la 0 es encuadre y va aparte).
const ejeOrden = [
  { key: 'laboral', num: 1, titulo: 'Situación laboral' },
  { key: 'exposicion', num: 2, titulo: 'Exposición laboral' },
  { key: 'ruido', num: 3, titulo: 'Ruido informativo' },
  { key: 'capacidad', num: 4, titulo: 'Capacidad de acción' },
  { key: 'edad', num: 5, titulo: 'Edad' },
] as const;

// Lote de artículos que muestran la tarjeta de esta herramienta (ver
// QUE_HACER_SI_TE_PREOCUPA_SLUGS en src/pages/articulos/[slug].astro) —
// enlazados aquí en ambas direcciones. Ninguno pertenece a otro lote de
// herramienta: un artículo no carga dos tarjetas.
const RELATED_SLUGS = [
  'ia-y-salud-mental-lo-que-nadie-te-dice-en-2026',
  'las-palabras-que-construyen-el-miedo-y-la-fe-en-la-ia',
  'el-hype-de-la-ia-no-es-accidental-asi-lo-disenaron',
  'como-distinguir-una-tendencia-real-de-puro-hype',
  'la-ia-borra-el-empleo-junior-el-talento-en-riesgo',
  'despidos-por-ia-en-2026-el-ranking-que-incluye-a-mercadolibre',
  'oracle-despide-a-30000-por-ia-el-patron-ya-es-claro',
  'jefe-ia-como-los-algoritmos-ya-contratan-evaluan-y-despiden-en-mexico',
];
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const relatedPosts = RELATED_SLUGS.map((slug) => allPosts.find((p) => p.id === slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p)
);

// Pasos del HowTo: el mismo array renderiza la lista visible y el JSON-LD.
const pasos = [
  { name: 'Dinos qué te preocupa más', text: 'Elige entre trabajo, dinero, futuro, familia o demasiada información. Esta respuesta no puntúa: decide con qué frase abre tu resultado y qué parte aparece primero.' },
  { name: 'Cuéntanos tu situación laboral', text: 'Empleado, buscando trabajo, independiente o retirado. Si eliges retirado o jubilado, se omite la pregunta de exposición laboral.' },
  { name: 'Responde sobre tu exposición y tu consumo de información', text: 'Dos preguntas: qué tan cerca está la IA del trabajo que haces o buscas, y qué te pasa cuando consumes información sobre IA.' },
  { name: 'Describe tu situación actual y tu edad', text: 'Una pregunta sobre tu margen para actuar. Si tu respuesta es que esto ya afecta tu sueño, tu concentración o tu vida diaria, la herramienta te lleva a una página con líneas de ayuda gratuitas. Con tu edad se ajusta el tipo de paso.' },
  { name: 'Lee por dónde empezar y tu paso para esta semana', text: 'El resultado abre con una prioridad, sigue con una lectura por cada eje y cierra con una acción concreta para esta semana.' },
];

const faqs: { q: string; a: string; link?: { href: string; label: string } }[] = [
  {
    q: '¿Es normal que me preocupe la inteligencia artificial?',
    a: 'Preocuparte por un cambio que puede afectar tu trabajo, tu dinero o tu familia es una reacción comprensible, y no es lo mismo que un problema de salud. Lo que importa es cuánto interfiere con tu día a día: si ya afecta tu sueño o tu concentración, hay líneas de ayuda gratuitas de atención las 24 horas.',
    link: { href: alertPath, label: 'Ver las líneas de ayuda' },
  },
  {
    q: '¿La inteligencia artificial me va a quitar el trabajo?',
    a: 'Nadie puede asegurarlo para tu caso. El estudio más reciente de la OIT (2025) estima que una de cada cuatro personas trabaja en una ocupación con alguna exposición a IA generativa, y concluye que lo más probable es la transformación de los puestos, no su desaparición. Esta herramienta no predice tu caso: te dice qué tan cerca está la IA de tu trabajo según lo que respondes y te lleva a la Calculadora de Riesgo para medirlo con más detalle.',
    link: { href: '/calculadora-de-riesgo-de-reemplazo-por-ia/', label: 'Ir a la Calculadora de Riesgo IA' },
  },
  {
    q: '¿Y si estoy retirado, jubilado o sin empleo?',
    a: 'La herramienta se adapta. Si eliges retirado o jubilado, se omite la pregunta sobre exposición laboral y el resultado se centra en cómo filtrar la información sobre IA. Si buscas trabajo, la pregunta de exposición se refiere al tipo de trabajo que buscas.',
  },
  {
    q: '¿Esto es un diagnóstico?',
    a: 'No. No diagnostica ansiedad ni ninguna condición, no te da un puntaje y no predice qué pasará con tu trabajo. Combina seis respuestas tuyas en una lectura orientativa, te dice por dónde tiene más sentido empezar y te propone un paso concreto para esta semana.',
  },
  {
    q: '¿De dónde salen las recomendaciones?',
    a: 'La lectura de exposición laboral se apoya en el índice de exposición a IA generativa de la OIT (2025), que concluye que la transformación de los puestos es el impacto más probable, no su desaparición. El resto —ruido informativo, capacidad de acción, edad y situación laboral— son criterios editoriales de glitchMentalMX, y se identifican como tal en la metodología de esta página.',
  },
  {
    q: '¿Qué pasa si marco la opción de alerta?',
    a: 'La herramienta sale del flujo normal y te lleva a una página con dos líneas de ayuda gratuitas, de atención las 24 horas. No te muestra un resultado, no te pide más respuestas y no te recomienda ninguna herramienta de IA.',
  },
  {
    q: '¿Guardan o comparten mis respuestas?',
    a: 'No. Todo corre en tu navegador: no hay servidor que reciba tus respuestas, no se pide correo y no se crea cuenta.',
  },
  {
    q: '¿Por qué no me da un número o un porcentaje?',
    a: 'Porque un número daría una precisión que no existe. Con seis respuestas se puede decir qué parte de tu situación pesa más y qué hacer primero, no cuánto vale tu futuro laboral.',
  },
  {
    q: '¿Qué relación tiene con la Calculadora de Riesgo y con Detox de IA?',
    a: 'Son dos módulos más profundos de la misma pregunta. La Calculadora mide con más detalle la exposición de tu trabajo; Detox de IA mide tus hábitos de uso. Esta herramienta es el paso previo: te dice cuál de las dos te conviene hacer primero y qué hacer con lo que encuentres.',
  },
  {
    q: '¿Cada cuánto se actualiza?',
    a: `Se revisa cuando cambian las fuentes en las que se apoya, y los números de las líneas de ayuda se verifican cada vez que se revisa. Última revisión: ${formatDate(lastReviewed)}.`,
  },
];

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '¿Te preocupa la IA? — Orientador',
  description,
  url: new URL(canonicalPath, Astro.site).toString(),
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any (web browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'MXN' },
  publisher: {
    '@type': 'Organization',
    name: 'glitchMentalMX',
    logo: { '@type': 'ImageObject', url: new URL('/og-default.png', Astro.site).toString() },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Cómo usar el orientador "¿Te preocupa la IA?"',
  description: 'Seis preguntas, 3 a 4 minutos, para saber por dónde empezar frente a la IA.',
  totalTime: 'PT4M',
  step: pasos.map((p, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: p.name,
    text: p.text,
  })),
};

// Los datos que necesita el cliente; los textos viven una sola vez en el JSON.
const clientData = {
  alertPath,
  preocupaciones,
  fuentes,
  prioridad: data.prioridad,
  exposicion: ejes.exposicion.fragmentos,
  ruido: ejes.ruido.fragmentos,
  capacidad: ejes.capacidad.fragmentos,
  edad: ejes.edad.fragmentos,
  laboral: ejes.laboral.fragmentos,
  niveles: {
    exposicion: Object.fromEntries(ejes.exposicion.opciones.map((o) => [o.id, o.nivel])),
    ruido: Object.fromEntries(ejes.ruido.opciones.map((o) => [o.id, o.nivel])),
    capacidad: Object.fromEntries(ejes.capacidad.opciones.map((o) => [o.id, o.nivel])),
  },
};
---

<Layout
  title={title}
  description={description}
  image={toolImage}
  modifiedTime={lastReviewed}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  locale="es_MX"
>
  <Breadcrumbs items={[{ name: 'Tools', url: '/herramientas/' }, { name: '¿Te preocupa la IA?' }]} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <PageHeader
    eyebrow="Orientador · glitchMentalMX"
    title="¿Te preocupa la inteligencia artificial? **Esto es lo que puedes hacer**"
    dek="Seis preguntas, tres o cuatro minutos, sin cuenta ni correo."
  />

  <section class="container intro">
    <p>
      Si te preocupa la inteligencia artificial —que te quite el trabajo, que el dinero no alcance, que el futuro se
      vuelva impredecible, que tu familia no esté preparada o que haya tanta información sobre IA que ya no sepas qué
      creer— esta herramienta te ayuda a separar tres cosas: cuánto riesgo real hay en tu situación, cuánto es ruido
      informativo y qué paso concreto puedes dar hoy. No te diagnostica, no te asigna un puntaje y no te promete que
      vas a estar a salvo.
    </p>
  </section>

  <section class="container disclaimer-box">
    <p class="disclaimer-label">Si necesitas ayuda ahora</p>
    <p>
      Si lo que sientes ya afecta tu sueño, tu concentración o tu día a día, no necesitas contestar nada:{' '}
      <a href={alertPath}>hay líneas de ayuda gratuitas aquí</a>.
    </p>
  </section>

  <section class="container test-wrap">
    <div id="yq-container">
      <h2 class="yq-title">¿Te preocupa la IA?</h2>
      <div class="yq-meta"><span>6 preguntas</span><span>•</span><span>3-4 minutos</span></div>

      <noscript>
        <p class="yq-noscript">
          El cuestionario necesita JavaScript. Mientras tanto, abajo está escrito qué mide cada pregunta y qué dice
          cada nivel. Si necesitas ayuda ahora,{' '}<a href={alertPath}>entra aquí</a>.
        </p>
      </noscript>

      <form id="yq-form">
        <fieldset class="yq-q" data-q="0" data-title="Para empezar" id="yq-q-preocupacion">
          <legend><span class="yq-q-num">1 / 6 · Para empezar</span><span class="yq-q-text">¿Qué te preocupa más?</span></legend>
          <div class="yq-options">
            {preocupaciones.map((o) => (
              <label class="yq-opt"><input type="radio" name="q0" value={o.id} /><span>{o.label}</span></label>
            ))}
          </div>
        </fieldset>

        {ejeOrden.map((e) => (
          <fieldset class="yq-q" data-q={e.num} data-title={e.titulo} id={`yq-q-${e.key}`}>
            <legend>
              <span class="yq-q-num">{e.num + 1} / 6 · {e.titulo}</span>
              <span class="yq-q-text">{ejes[e.key].pregunta}</span>
            </legend>
            <div class="yq-options">
              {ejes[e.key].opciones.map((o) => (
                <label class="yq-opt"><input type="radio" name={`q${e.num}`} value={o.id} /><span>{o.label}</span></label>
              ))}
            </div>
            {e.key === 'capacidad' && (
              <p id="yq-help-inline" class="yq-help-inline" hidden>
                Gracias por decirlo. <a href={alertPath}>Aquí hay dos líneas de ayuda gratuitas, de atención las 24 horas</a>.
              </p>
            )}
          </fieldset>
        ))}

        <p class="yq-age-note">Pensado para mayores de 18 años.</p>
        <p id="yq-warning" role="alert"></p>
        <button type="submit" id="yq-submit" class="yq-btn">Ver qué hacer ahora</button>
      </form>

      <p class="yq-last">Última revisión: {formatDate(lastReviewed)}.</p>

      <div id="yq-result" aria-live="polite">
        <p class="yq-from">Partiendo de lo que más te preocupa: <strong id="yq-from-label"></strong></p>
        <p id="yq-concern"></p>
        <div id="yq-priority">
          <p class="yq-axis">Por dónde empezar</p>
          <p id="yq-priority-text"></p>
        </div>
        <div id="yq-blocks"></div>
        <div id="yq-next">
          <h3>Tu siguiente paso</h3>
          <ul id="yq-next-list"></ul>
        </div>
        <p class="yq-disclaimer">
          Esto es una lectura orientativa, no un diagnóstico. Si en algún momento esto te pesa más de lo que esperabas,{' '}
          <a href={alertPath}>hay líneas de ayuda gratuitas</a>.
        </p>
        <button id="yq-reset" type="button" class="yq-reset-link">Volver a empezar</button>
      </div>
    </div>
  </section>

  <section class="container static">
    <p class="eyebrow">Cómo funciona</p>
    <h2>Seis preguntas, cinco pasos</h2>
    <ol class="howto">
      {pasos.map((p) => (
        <li><strong>{p.name}.</strong> {p.text}</li>
      ))}
    </ol>
    <p class="static-note">
      El resultado no se escribe de cero para cada persona: se arma combinando un fragmento por cada eje. Aquí abajo
      están todos, completos, para que sepas exactamente qué puede decirte esta herramienta antes de usarla.
    </p>
  </section>

  <section class="container static" id="que-mide-cada-eje">
    <h2>Qué mide cada eje y qué dice cada nivel</h2>
    <details class="eje">
      <summary>Para empezar: ¿qué te preocupa más?</summary>
      <p class="eje-mide">No puntúa. Decide con qué frase abre tu resultado y si la lectura de ruido informativo aparece antes que la de exposición laboral.</p>
      <ul class="niveles">
        {preocupaciones.map((o) => (
          <li>
            <span class="nivel-tag">{o.label}</span>
            <span class="nivel-texto">{o.texto}</span>
          </li>
        ))}
      </ul>
    </details>
    <details class="eje">
      <summary>Por dónde empezar: la prioridad de tu resultado</summary>
      <p class="eje-mide">Se elige una sola, con este orden: primero ruido, después exposición, después margen para actuar. Es criterio editorial, no un cálculo.</p>
      <ul class="niveles">
        <li><span class="nivel-tag">Si tu ruido informativo es alto</span><span class="nivel-texto">{data.prioridad.ruido}</span></li>
        <li><span class="nivel-tag">Si tu exposición laboral es alta</span><span class="nivel-texto">{data.prioridad.exposicion}</span></li>
        <li><span class="nivel-tag">Si no sabes por dónde empezar o estás evitando decisiones</span><span class="nivel-texto">{data.prioridad.paso}</span></li>
        <li><span class="nivel-tag">Si tienes margen y nada de lo anterior</span><span class="nivel-texto">{data.prioridad.margen}</span></li>
        <li><span class="nivel-tag">Si eres retirado o jubilado y tu ruido no es alto</span><span class="nivel-texto">{data.prioridad.filtro}</span></li>
      </ul>
    </details>
    {ejeOrden.map((e) => (
      <details class="eje">
        <summary>{e.titulo}: {ejes[e.key].pregunta}</summary>
        <p class="eje-mide">{ejes[e.key].midePorQue}</p>
        <ul class="niveles">
          {ejes[e.key].opciones.map((o) => {
            const frag = (ejes[e.key].fragmentos as Record<string, { texto: string; fuente?: string; accion?: string }>)[o.id];
            return frag ? (
              <li>
                <span class="nivel-tag">{'nivel' in o ? `${o.nivel} · ` : ''}{o.label}</span>
                <span class="nivel-texto">
                  {frag.texto}
                  {frag.accion && (
                    <>
                      {' '}<strong>Para esta semana:</strong> {frag.accion}
                    </>
                  )}
                  {frag.fuente && (
                    <>
                      {' '}<a href={fuentes[frag.fuente as 'oit'].url} rel="noopener" target="_blank" class="src-inline">[{fuentes[frag.fuente as 'oit'].etiqueta}]</a>
                    </>
                  )}
                </span>
              </li>
            ) : (
              <li>
                <span class="nivel-tag">{'nivel' in o ? `${o.nivel} · ` : ''}{o.label}</span>
                <span class="nivel-texto">Sale del flujo normal y lleva a una <a href={alertPath}>página de ayuda con líneas telefónicas gratuitas</a>. No muestra un resultado.</span>
              </li>
            );
          })}
        </ul>
      </details>
    ))}
    <p class="static-note">
      Para profundizar en la exposición laboral y en el ruido informativo tienes herramientas completas:{' '}
      <a href="/calculadora-de-riesgo-de-reemplazo-por-ia/">Calculadora de Riesgo IA</a> (exposición laboral) y{' '}
      <a href="/detox-de-ia/">Detox de IA</a> (consumo de información y hábitos de uso).
    </p>
  </section>

  <section class="container related">
    <p class="eyebrow">Para profundizar</p>
    <h2>Miedo, ruido y trabajo: lecturas de fondo</h2>
    <div class="related-grid">
      {relatedPosts.map((post) => (
        <ArticleCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          heroImage={post.data.heroImage}
          heroImageAlt={post.data.heroImageAlt}
          body={post.body}
          variant="grid"
        />
      ))}
    </div>
  </section>

  <section class="container faq">
    <p class="eyebrow">Preguntas frecuentes</p>
    <h2>Antes de que preguntes</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}{f.link && <>{' '}<a href={f.link.href} class="faq-link">{f.link.label} →</a></>}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container methodology">
    <p class="eyebrow">Metodología y fuentes</p>
    <p class="method-updated">Metodología actualizada: {formatDate(lastReviewed)}.</p>
    <p>
      Qué viene de una fuente y qué es criterio editorial, sin mezclar:
    </p>
    <ul class="sources">
      <li>
        <strong>Exposición laboral.</strong> Se apoya en {fuentes.oit.titulo}. Hallazgo usado: la exposición a IA
        generativa es amplia pero parcial, y la transformación de los puestos es el impacto más probable.
        <a href={fuentes.oit.url} rel="noopener" target="_blank">Ver fuente</a>.
      </li>
      <li>
        <strong>Bienestar y rama de alerta.</strong> El marco general —los factores del trabajo como riesgo para la
        salud mental y la existencia de intervenciones individuales para manejar el estrés— sigue la ficha técnica
        {' '}{fuentes.oms.titulo}. <a href={fuentes.oms.url} rel="noopener" target="_blank">Ver fuente</a>. Los números
        telefónicos vienen de las fuentes oficiales de cada línea y se verificaron el {formatDate(new Date(`${data.lineas.verificadoEl}T12:00:00-06:00`))}.
      </li>
      <li>
        <strong>Frase de encuadre, prioridad, ruido informativo, capacidad de acción, edad, situación laboral y acción
        de la semana.</strong> Son criterios editoriales de glitchMentalMX, no resultados de un estudio. Por eso están redactados como orientación y no como
        predicción.
      </li>
    </ul>
    <p>
      Lo que esta herramienta no hace: no diagnostica, no puntúa tu ansiedad, no promete que estarás a salvo y no
      sustituye hablar con un profesional.
    </p>
  </section>

  <script type="application/json" id="yq-data" set:html={JSON.stringify(clientData)} />
</Layout>

<script>
  var DATA = JSON.parse(document.getElementById('yq-data').textContent);
  var form = document.getElementById('yq-form');

  // Orden de las preguntas: q0 preocupación, q1 situación laboral,
  // q2 exposición, q3 ruido, q4 capacidad, q5 edad.
  var AXIS_TITLES = { exposicion: 'Exposición laboral', ruido: 'Ruido informativo', capacidad: 'Capacidad de acción' };
  var MODULE_LINKS = {
    exposicion: { href: '/calculadora-de-riesgo-de-reemplazo-por-ia/', label: 'Mide tu exposición en la Calculadora de Riesgo IA →' },
    ruido: { href: '/detox-de-ia/', label: 'Evalúa tu consumo con Detox de IA →' },
  };

  function checkedValue(name) {
    var el = form.querySelector('input[name="' + name + '"]:checked');
    return el ? el.value : null;
  }

  var expoQ = document.getElementById('yq-q-exposicion');
  var helpInline = document.getElementById('yq-help-inline');

  // Los retirados o jubilados no tienen "trabajo que hacer o buscar": la
  // pregunta de exposición se omite y la numeración se recalcula.
  function sync() {
    var retirado = checkedValue('q1') === 'retirado';
    expoQ.hidden = retirado;
    if (retirado) {
      expoQ.querySelectorAll('input').forEach(function (i) { i.checked = false; });
      expoQ.classList.remove('missing');
    }
    var visibles = [].filter.call(form.querySelectorAll('.yq-q'), function (f) { return !f.hidden; });
    visibles.forEach(function (f, i) {
      f.querySelector('.yq-q-num').textContent = (i + 1) + ' / ' + visibles.length + ' · ' + f.getAttribute('data-title');
    });
    helpInline.hidden = checkedValue('q4') !== 'alerta';
  }
  form.addEventListener('change', sync);

  function buildBlock(axis, id) {
    var frag = DATA[axis][id];
    var nivel = DATA.niveles[axis][id];
    var block = document.createElement('div');
    block.className = 'yq-block';

    var tag = document.createElement('p');
    tag.className = 'yq-axis';
    tag.textContent = AXIS_TITLES[axis] + ' · ' + nivel;
    block.appendChild(tag);

    var text = document.createElement('p');
    text.className = 'yq-frag';
    text.textContent = frag.texto;
    block.appendChild(text);

    if (frag.fuente) {
      var src = DATA.fuentes[frag.fuente];
      var s = document.createElement('p');
      s.className = 'yq-src';
      s.appendChild(document.createTextNode('Fuente: '));
      var a = document.createElement('a');
      a.href = src.url;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = src.etiqueta;
      s.appendChild(a);
      block.appendChild(s);
    }

    if (MODULE_LINKS[axis]) {
      var l = document.createElement('a');
      l.className = 'yq-module';
      l.href = MODULE_LINKS[axis].href;
      l.textContent = MODULE_LINKS[axis].label;
      block.appendChild(l);
    }
    return block;
  }

  // Una sola prioridad, en este orden: ruido alto, exposición alta, falta de
  // arranque o evitación, margen. Retirados: filtro, salvo ruido alto.
  function pickPriority(laboral, exposicion, ruido, capacidad) {
    if (ruido === 'alto') return DATA.prioridad.ruido;
    if (laboral === 'retirado') return DATA.prioridad.filtro;
    if (exposicion === 'alta') return DATA.prioridad.exposicion;
    if (capacidad === 'media' || capacidad === 'baja') return DATA.prioridad.paso;
    return DATA.prioridad.margen;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    // Rama de alerta: sale del flujo sin exigir el resto de respuestas.
    if (checkedValue('q4') === 'alerta') {
      window.location.assign(DATA.alertPath);
      return;
    }

    var warning = document.getElementById('yq-warning');
    var vals = [];
    var firstMissing = null;
    var retirado = checkedValue('q1') === 'retirado';
    for (var i = 0; i <= 5; i++) {
      var v = checkedValue('q' + i);
      var fs = form.querySelector('.yq-q[data-q="' + i + '"]');
      var requerida = !(i === 2 && retirado);
      if (v === null && requerida) {
        fs.classList.add('missing');
        if (!firstMissing) firstMissing = fs;
      } else {
        fs.classList.remove('missing');
      }
      vals.push(v);
    }
    if (firstMissing) {
      var total = retirado ? 5 : 6;
      warning.textContent = 'Responde las ' + total + ' preguntas para ver tu resultado.';
      warning.style.display = 'block';
      firstMissing.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    warning.style.display = 'none';

    var pre = DATA.preocupaciones.filter(function (p) { return p.id === vals[0]; })[0];
    var laboral = vals[1], exposicion = vals[2], ruido = vals[3], capacidad = vals[4], edad = vals[5];

    document.getElementById('yq-from-label').textContent = pre.label;
    document.getElementById('yq-concern').textContent = pre.texto;
    document.getElementById('yq-priority-text').textContent = pickPriority(laboral, exposicion, ruido, capacidad);

    var order = pre.modulo === 'detox' ? ['ruido', 'exposicion'] : ['exposicion', 'ruido'];
    var picks = { exposicion: exposicion, ruido: ruido };
    var blocks = document.getElementById('yq-blocks');
    blocks.textContent = '';
    order.forEach(function (axis) {
      if (axis === 'exposicion' && retirado) return;
      blocks.appendChild(buildBlock(axis, picks[axis]));
    });
    blocks.appendChild(buildBlock('capacidad', capacidad));

    var list = document.getElementById('yq-next-list');
    list.textContent = '';
    function addItem(text, lead) {
      var li = document.createElement('li');
      if (lead) {
        var b = document.createElement('strong');
        b.textContent = lead + ' ';
        li.appendChild(b);
        li.className = 'yq-week';
      }
      li.appendChild(document.createTextNode(text));
      list.appendChild(li);
    }
    addItem(DATA.edad[edad].texto);
    addItem(DATA.laboral[laboral].texto);
    addItem(DATA.laboral[laboral].accion, 'Para esta semana:');

    var result = document.getElementById('yq-result');
    result.style.display = 'block';
    setTimeout(function () {
      var top = result.getBoundingClientRect().top + window.pageYOffset - 120;
      window.scrollTo({ top: top, behavior: 'smooth' });
      result.setAttribute('tabindex', '-1');
      result.focus({ preventScroll: true });
    }, 150);
  });

  document.getElementById('yq-reset').addEventListener('click', function () {
    form.reset();
    sync();
    form.querySelectorAll('.yq-q.missing').forEach(function (f) { f.classList.remove('missing'); });
    document.getElementById('yq-result').style.display = 'none';
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

