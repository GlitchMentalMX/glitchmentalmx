---
// Stub de redirección: esta URL con "2026" quedó fija en el slug desde el
// lanzamiento de la herramienta, pero la calculadora es un recurso evergreen
// (se revisa cuando cambian las tendencias, no una vez al año) — mantener el
// año en la URL habría forzado crear /2027/, /2028/... en vez de acumular
// autoridad en una sola dirección. Mismo patrón que ya usa
// scripts/generate-redirects.mjs para las URLs migradas de Blogger:
// meta-refresh + canonical + noindex, sin server-side redirect porque el
// sitio es estático (GitHub Pages).
const target = 'https://glitchmental.com/calculadora-de-riesgo-de-reemplazo-por-ia/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Redirigiendo…</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Esta calculadora se movió. Si no eres redirigido automáticamente, <a href={target}>haz clic aquí</a>.</p>
  </body>
</html>
