---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  titleSuffix?: boolean;
  robots?: string;
  locale?: string;
}

const { title, description, image, noIndex = false, type = 'website', publishedTime, modifiedTime, titleSuffix = true, robots, locale } = Astro.props;

const siteName = 'glitchMentalMX';
const suffix = ` · ${siteName}`;
const wantsSuffix = title !== siteName && titleSuffix;
// El <title> real (lo que trunca Google, ~60 caracteres) solo lleva el
// sufijo si cabe sin pasarse — un título ya largo sin sufijo se trunca
// igual, pero uno corto SÍ gana refuerzo de marca gratis. Afecta sobre
// todo a `posts` (98% de los 388 títulos se pasaban de 60 con el sufijo
// fijo). OG/Twitter no tienen ese límite de SERP, así que ahí el sufijo
// siempre se agrega — mejor contexto de marca al compartir.
const fitsWithSuffix = title.length + suffix.length <= 60;
const pageTitle = wantsSuffix && fitsWithSuffix ? `${title}${suffix}` : title;
const fullTitle = wantsSuffix ? `${title}${suffix}` : title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image
  ? new URL(image, Astro.site).toString()
  : new URL('/og-default.png', Astro.site).toString();

const authorURL = new URL('/acerca-de/', Astro.site).toString();
const logoURL = new URL('/og-default.png', Astro.site).toString();

// Perfiles de marca (no personales) — el Organization de abajo usa estos.
// personSchema, más abajo, tiene su propio sameAs aparte que sí incluye el
// LinkedIn personal de Jorge, porque ese perfil es de él, no de la marca.
const BRAND_SOCIAL_URLS = [
  'https://x.com/GlitchMentalMX',
  'https://www.facebook.com/GlitchMentalMX/',
  'https://mastodon.social/@GlitchMentalMX',
  'https://bsky.app/profile/glitchmentalmx.bsky.social',
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: Astro.site?.toString(),
  description:
    'Tecnología, IA y cultura digital sin hype. Donde el algoritmo viene a confesar el glitch. Cortito, ácido, sin hype.',
  editorialStyle: 'Análisis crítico, directo y sin hype sobre tecnología e inteligencia artificial',
  publisher: {
    '@type': 'Organization',
    name: siteName,
    logo: { '@type': 'ImageObject', url: logoURL },
    sameAs: BRAND_SOCIAL_URLS,
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL('/buscar/?q={search_term_string}', Astro.site).toString(),
    'query-input': 'required name=search_term_string',
  },
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jorge A. Diaz Elizondo',
  url: authorURL,
  sameAs: [
    'https://x.com/GlitchMentalMX',
    'https://www.linkedin.com/in/jorgediazelizondo',
    'https://www.facebook.com/GlitchMentalMX/',
    'https://mastodon.social/@GlitchMentalMX',
    'https://bsky.app/profile/glitchmentalmx.bsky.social',
  ],
  jobTitle: 'Fundador y Editor',
  worksFor: { '@type': 'Organization', name: siteName, url: Astro.site?.toString() },
  knowsAbout: [
    'Inteligencia Artificial',
    'Agentic AI',
    'IA Agéntica',
    'Edge AI',
    'Model Context Protocol',
    'Sistemas autónomos',
    'Modelos de lenguaje',
    'Narrativa de la IA',
    'Algoritmos',
    'Cultura Digital',
    'Psicología Digital',
    'Tecnología de Consumo',
    'Tendencias Digitales',
  ],
};
---

<!doctype html>
<html lang="es" data-theme="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content={robots ?? 'max-image-preview:large'} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    {locale && <meta property="og:locale" content={locale} />}
    {type === 'article' && <meta property="article:author" content="Jorge A. Diaz Elizondo" />}
    {type === 'article' && <meta property="article:publisher" content={Astro.site?.toString()} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GlitchMentalMX" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <meta name="msvalidate.01" content="5994D37EDB0CEB295F053D11D4477FED" />
    <meta name="yandex-verification" content="a8ee8d519d7112b1" />
    <meta name="publisuites-verify-code" content="aHR0cHM6Ly93d3cuZ2xpdGNobWVudGFsLmNvbQ==" />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <script is:inline>
      (function () {
        var stored = localStorage.getItem('gm-theme');
        var theme = stored === 'light' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>

  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Lightbox />
    <Analytics />
    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--accent);
        color: #fff;
        padding: 12px 20px;
        z-index: 100;
        border-radius: 0 0 8px 0;
        font-family: var(--font-mono);
        font-size: 0.85rem;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
